#!/bin/sh
# Tell me when the branch I just pulled is broken, and what it left unfinished.
#
# `git pull` after merging a pull request is the moment somebody is already at
# the terminal, and it was the moment this repository's `main` sat red without
# anyone noticing -- CI had run and failed, and nothing surfaced it.
#
# Install with `make hooks`. Read-only, never blocks the merge: it exits 0
# whatever it finds, because a hook that can stop you pulling is a hook people
# delete.
[ -x "$(command -v gh)" ] || exit 0
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
[ "$branch" = "main" ] || exit 0
python3 "$(git rev-parse --show-toplevel)/scripts/ci_status.py" --branch main --quiet || true
# And the other half of the same moment: a pull request closes an issue, GitHub
# sets no Status -- or does not close it at all -- and the wrap-up is a person's.
# `Item closed -> Done` is deliberately off, because it would write Status and
# nothing else, leaving the issue reading Done with no Evidence.
#
# **This block is the whole hook that `gh agile init` installs elsewhere.** It
# reaches no path inside this checkout, which is what makes it work in a
# repository that is not this one (#193). The `ci_status.py` line above does,
# and is this repository's own business.
#
# The `else` is #192: `unfinished` returns non-zero only when it could not run,
# so this says *the check did not happen* in the hook's own words instead of
# letting a stray `gh` error stand in for it.
if said=$(gh agile unfinished --quiet 2>&1); then
    [ -n "$said" ] && printf '%s\n' "$said" >&2
else
    printf '%s\n' \
      "" \
      "  gh-agile: the post-merge check did not run, so nothing was checked." \
      "$said" \
      "  If that says the command is unknown, this clone's gh-agile is older than" \
      "  its hook:  gh extension upgrade agile" \
      "  To stop checking here, delete $0" \
      "" >&2
fi
exit 0

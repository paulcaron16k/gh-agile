#!/bin/sh
# Tell me when the branch I just pulled is broken, and what it left unfinished.
#
# `git pull` after merging a pull request is the moment somebody is already at
# the terminal, and it was the moment this repository's `main` sat red without
# anyone noticing -- CI had run and failed, and nothing surfaced it.
#
# Install with `make hooks`. Read-only, never blocks the merge: it exits 0
# whatever it finds, because a hook that can stop you pulling is a hook people
# delete.
[ -x "$(command -v gh)" ] || exit 0
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
[ "$branch" = "main" ] || exit 0
root=$(git rev-parse --show-toplevel)
python3 "$root/scripts/ci_status.py" --branch main --quiet || true
# And the other half of the same moment: a pull request closes an issue, GitHub
# sets no Status, and the wrap-up is a person's. `Item closed -> Done` is
# deliberately off -- it would write Status and nothing else, leaving the issue
# reading Done with no Evidence. See scripts/finish_merged.py.
python3 "$root/scripts/finish_merged.py" --quiet || true
exit 0

#: The oldest interpreter this tool runs on, and the number `ruff.toml`'s
#: `target-version` and the CI matrix are both pinned to.
#:
#: A `gh` extension runs under whatever `python3` the shebang finds --
#: `gh extension install` clones a file, it does not provision an interpreter --
#: so this is not ours to choose, and refusing with a sentence beats an exception
#: from the middle of a command.
#:
#: 3.10 rather than something newer, deliberately, even though it reaches upstream
#: end of life in October 2026. Upstream EOL stops python.org patches; it does not
#: remove 3.10 from anybody's machine, Ubuntu 22.04 LTS ships it with distro
#: support into 2027, and this file uses no 3.11+ feature -- so the floor costs
#: nothing to hold and dropping it would buy one fewer CI job. Revisit when the
#: distributions move, not when the version number expires.
RUNTIME_FLOOR = (3, 10)

#: When to **look at the floor again** -- deliberately not when it expires
#: upstream. The paragraph above settles that: EOL stops python.org patches and
#: removes 3.10 from nobody's machine, so the trigger is the distributions moving.
#: Ubuntu 22.04 LTS carries 3.10 with standard support to April 2027, which is the
#: date worth a prompt.
#:
#: Hand-maintained, and honestly so: there is no offline source for it and this
#: file may not grow a dependency to fetch one. `tests/test_version_floor.py`
#: warns -- not fails -- once the date is past, because a floor being worth
#: revisiting is not a reason to break the build. Raising the floor means moving
#: this with it.
RUNTIME_FLOOR_REVIEW = "2027-04-30"


def require_interpreter() -> None:
    if sys.version_info < RUNTIME_FLOOR:
        floor = ".".join(str(n) for n in RUNTIME_FLOOR)
        running = ".".join(str(n) for n in sys.version_info[:3])
        sys.exit(
            f"gh-agile needs Python {floor} or newer; this is {running} "
            f"({sys.executable}).\n"
            f"  It runs under whatever `python3` is first on PATH. Point that at a newer "
            f"one,\n  or install one: 3.12 is what this tool is tested against."
        )


#: Where the running copy of this tool lives. `gh extension install` clones the
#: repository, so for an installed extension this is that clone and for a
#: developer it is the working tree -- either way, a git checkout whose commit is
#: the honest answer to *what is running*.
TOOL_DIR = pathlib.Path(__file__).resolve().parent


def checkout_version(directory: pathlib.Path = TOOL_DIR) -> tuple[str, str]:
    """`(version, branch)` for a checkout, or `("unknown", "")` if it is not one.

    **Derived, never declared.** A `VERSION = "0.3.1"` constant is a fact kept in
    two places, and this repository has already watched that disagree with itself
    -- `docs/tasks.md` is the single copy of live state for the same reason. The
    checkout *is* the record, and `git describe` gives the same answer
    `gh extension list` does, with the tag in front of it when there is one.

    Degrades rather than fails: a file lifted out of its clone, or a machine with
    no `git`, still gets the rest of the report. Nothing here is worth an error.
    """
    def ask(*command: str) -> str:
        try:
            result = subprocess.run(["git", "-C", str(directory), *command],
                                    capture_output=True, text=True)
        except OSError:
            return ""
        return result.stdout.strip() if result.returncode == 0 else ""

    # `--always` falls back to the bare commit when no tag is reachable, which is
    # the state every clone was in before #197 cut the first one. `--dirty` marks
    # a working tree with edits, because "what is running" is then not any commit.
    return ask("describe", "--tags", "--always", "--dirty") or "unknown", \
        ask("rev-parse", "--abbrev-ref", "HEAD")


def version_lines() -> list[str]:
    """What `--version` prints: the build, the interpreter, and the profile.

    Three facts, and each one has cost somebody an afternoon.

    The **build**, because a script extension tracks `main` and every consumer is
    on whatever it was at their last upgrade -- so a bug report, a pasted
    measurement and a `validate` run were all anonymous as to which build
    produced them.

    The **interpreter**, because this runs under the user's `python3` and not a
    venv: a `target-version` drift once passed lint and every test under 3.12 and
    crashed on first use under the system 3.10. A floor nothing names is a floor
    nobody checks.

    The **profile**, because `config_from` means the file in front of you may not
    be the file in use. The pointer is reported and deliberately **not followed**:
    following it is an API call, and nothing in `--version` may need a network, a
    token or a board.
    """
    version, branch = checkout_version()
    out = [f"  gh-agile {version}" + (f"  ({branch})" if branch else "")]
    out.append(f"  python {platform.python_version()}  (floor "
               f"{'.'.join(str(n) for n in RUNTIME_FLOOR)}+), {sys.executable}")
    path = find_config()
    if path is None:
        out.append(f"  profile: none found ({', '.join(CONFIG_PATHS)})")
        return out
    line = f"  profile: {path}"
    try:
        pointer = (json.loads(path.read_text()) or {}).get("config_from")
    except (OSError, ValueError):
        pointer = None
        line += "  (unreadable)"
    if pointer:
        line += f"  -> config_from {pointer}, not followed here"
    out.append(line)
    return out


class VersionAction(argparse.Action):
    """`--version`, computed when it is asked for and not before.

    argparse's own `action="version"` takes a finished string, so the build would
    have to be worked out while the parser is being built -- a `git describe`
    subprocess on every single invocation of every command, to serve one flag.
    This fires only when the flag appears.

    It also exits during parsing, which is what lets `--version` work although
    the subcommand is `required=True`: there is no command to give, and asking
    for one would make the flag useless exactly where it is most wanted.
    """

    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, **kwargs)

    def __call__(self, parser, namespace, values, option_string=None):
        for line in version_lines():
            print(line)
        parser.exit(0)


def build_parser() -> argparse.ArgumentParser:
    """Every command and flag, built but not parsed.

    Separated from `main` so the parser can be walked in a test. It is the
    record of which commands exist and what each one takes, and two things
    beside it have to agree with it -- `apply_defaults`, and the guide -- so it has
    to be readable without running the tool. `scripts/check_guide.py` reads it
    through `--help` because it checks the published surface; a test inside the
    process reads it here.
    """
    parser = argparse.ArgumentParser(prog="gh agile", description=__doc__.splitlines()[0])
    add_global_flags(parser, default=None)
    parser.add_argument("--version", action=VersionAction,
                        help="the build, the interpreter and the profile in use")
    sub = parser.add_subparsers(dest="command", required=True)

    init = sub.add_parser(
        "init", help="from a fresh clone to a working board, in one command",
        epilog=field_help([
            ("--key", "KEY", "required*", "labels every issue; Jira's rules apply"),
            ("--title", "text", "required*", "the project's title"),
            ("--sprint-template", "|".join(SPRINT_TEMPLATES), "required*",
             "the cadence; blocks epic/story/ensure until chosen"),
            ("--title-prefix", "|".join(TITLE_PREFIX_MODES), "optional",
             "what every issue is called; default off"),
            ("--project", "number", "optional", "adopt an existing project "
             "instead of creating one"),
            ("--repo", "owner/name", "optional", "where labels are created"),
        ]) + """

*required only the first time: a run against a profile that already names a
project, a key and a cadence needs none of them.

what it does, in order:
  1. creates the project and writes the profile -- number, owner, name, key
  2. records the cadence, the title prefix and the starter boards: Sprint
     board, Backlog and Roadmap, and Engineering: all work across several keys
  3. runs `setup`: the fields, the type: and key: labels, and those boards
  4. prints the web-UI steps the API cannot take, with their current state

Idempotent: every step converges, so an interrupted run is simply run again

PLACEHOLDER = "_TBD_"


def read_template(args, *, required: tuple[str, ...], interactive_ok: bool = True) -> dict:
    """Section text from a file, a flag, stdin, or a prompt -- in that order.

    A tool that only prompts cannot be driven by an agent or run in CI; a tool
    that only takes files makes a person author one to fix a typo. So: explicit
    input always wins, and prompting happens only when a human is demonstrably
    present at a terminal.
    """
    supplied = getattr(args, "evidence", None)
    path = getattr(args, "evidence_file", None)
    text = None
    if path:
        text = sys.stdin.read() if path == "-" else pathlib.Path(path).read_text()
    elif supplied:
        text = sys.stdin.read() if supplied == "-" else supplied

    if text is not None:
        sections = parse_sections(text)
        # A bare blob with no headings is the common case for one section --
        # treat it as that section rather than rejecting it on a technicality.
        if not sections and len(required) == 1:
            sections = {required[0]: text.strip()}
        return sections

    if interactive_ok and sys.stdin.isatty():
        sections = {}
        for name, hint in SECTIONS:
            if name not in required:
                continue
            print(f"  ## {name} -- {hint}")
            print("  (end with a blank line)")
            lines = []
            while True:
                try:
                    line = input("  > ")
                except EOFError:
                    break
                if not line.strip():
                    break
                lines.append(line)
            sections[name] = "\n".join(lines).strip()
        return sections

    sys.exit(
        "no text supplied and no terminal to prompt at. Pass --evidence-file FILE, "
        "--evidence TEXT, or - to read stdin"
    )


def parse_sections(text: str) -> dict[str, str]:
    """Split `## Heading` blocks into {heading: body}."""
    sections, current = {}, None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            current = stripped[3:].strip()
            sections[current] = ""
        elif current:
            sections[current] += line + "\n"
    return {k: v.strip() for k, v in sections.items()}


def require_sections(sections: dict[str, str], required: tuple[str, ...]) -> None:
    """Reject a body that is missing a section or has left one as a placeholder.

    The point of POLICY.md §4 is that a closed issue saying only "done" has
    thrown away the reasoning. A template nobody validates is a suggestion, so
    this is where the rule stops being advisory.
    """
    problems = section_problems(sections, required)
    if problems:
        sys.exit("the body is not complete:\n  - " + "\n  - ".join(problems))


def section_problems(sections: dict[str, str], required: tuple[str, ...]) -> list[str]:
    """What is missing, empty or still a placeholder. One definition, two callers.

    `move` asks this of the text it was handed *and* of the body the issue
    already carries, and the two must agree on what "complete" means -- a body
    good enough to close on must be a body that would have passed had it been
    typed at the prompt.
    """
    problems = []
    for name in required:
        value = (sections.get(name) or "").strip()
        if not value:
            problems.append(f"## {name} is missing or empty")
        elif value == PLACEHOLDER:
            problems.append(f"## {name} is still {PLACEHOLDER}")
    return problems


def issue_body(repo: str, issue: int) -> str:
    """The issue's body as it stands now."""
    return json.loads(gh(["issue", "view", str(issue), "--repo", repo,
                          "--json", "body"]))["body"]


BODY_TEMPLATE = """## Intent
{intent}

## Acceptance
{acceptance}

## Evidence
"""


@contextlib.contextmanager
def board_write_reported(number: int, url: str, project: int):
    """Fail with the issue named, when putting a freshly created issue on the board fails.

    Creating the issue and boarding it are two grants: anyone who can open an
    issue on a public repository may still be refused the project write. When
    that happens the issue exists and the tool must say so, because nothing else
    will -- and the recovery is a different command.
    """
    try:
        yield
    except SystemExit as exc:
        sys.exit(
            f"issue #{number} was created at {url}\n"
            f"  but could not be put on project #{project}: {exc}\n"
            f"  The issue is real and is not on the board. Either ask someone with\n"
            f"  project write to run `gh agile sync --adopt`, or close #{number}."
        )


def add_to_project(login: str, project: int, url: str) -> str:
    """Add an issue to the project, tolerating it already being there.

    The built-in *Auto-add sub-issues to project* workflow is enabled by default
    and races this: a story created under an epic that is already on the board
    is added by GitHub within the second, and the explicit add then fails with
    `Content already exists in this project`. Creating a story would abort after
    the issue existed but before its fields were set -- the exact half-made
    state `story` exists to prevent.
    """
    number = int(url.rsplit("/", 1)[-1])
    result = subprocess.run(
        ["gh", "project", "item-add", str(project), "--owner", login,
         "--url", url, "--format", "json"],
        capture_output=True, text=True,
    )
    if result.returncode == 0:
        return json.loads(result.stdout)["id"]
    if "already exists" not in result.stderr:
        sys.exit(f"gh project item-add failed: {result.stderr.strip()}")
    existing = next(
        # refresh: the board was read before GitHub's workflow added this, so
        # the cached list is precisely the one that does not contain it.
        (i["id"] for i in board_items(login, project, refresh=True)
         if (i.get("content") or {}).get("number") == number),
        None,
    )
    if not existing:
        sys.exit(f"{url} is reported as already on project {project}, but no item "
                 f"for it can be found")
    return existing


def require_key_for_prefix(config: dict, key) -> None:
    """Refuse before creating anything if the prefix has no key to use.

    Checked up front: the alternative is an issue that exists with a title the
    profile says it should not have, and a second run to fix it.
    """
    if title_prefix_mode(config) != "off" and not key:
        sys.exit(
            "project.issue_title_prefix is set, but no key applies to this repository, "
            "so there is\n  nothing to prefix the title with. Pass --key, or list one:\n\n"
            "    gh agile key --key ZMBNI --repo owner/name"
        )


#: Why `initiative reconcile` exists, for its `--help`.
RECONCILE_WHY = """

why this exists:
  A board filter cannot traverse the hierarchy, so seeing an initiative's whole
  tree needs `initiative:<slug>` on every issue in it. That label is derived and
  never authored: this walks initiative -> epics -> stories and applies it.

  Both directions. An epic detached from an initiative keeps the label unless
  something takes it away, and a stale label is worse than a missing one -- the
  board shows work that is no longer part of the initiative, and it looks
  correct. The hierarchy is the authority; the label follows it.

  Idempotent: a second run changes nothing."""


def initiative_slug(title: str) -> str:
    """`Large new feature` -> `large-new-feature`. The label's readable half.

    Deliberately the same shape as `slug()`, which names export files, but kept
    separate: a filename may be regenerated at will and this one goes onto every
    issue in a tree. Changing how it is derived would orphan every label already
    written, so it is a decision rather than a convenience.
    """
    kept = [c.lower() if c.isalnum() else "-" for c in title]
    return "-".join(part for part in "".join(kept).split("-") if part) or "initiative"


def looks_like_issue_ref(text: str, config: dict) -> bool:
    """Whether `text` names an issue rather than an initiative slug.

    `35` does. `TEST-35` does, **but only if `TEST` is a key in the profile** --
    without that check the slug `pyiceberg-0-12` parses as key `pyiceberg-0`
    and number `12`, and a perfectly good slug would be read as a reference to
    an issue in no repository.
    """
    if text.isdigit() or issue_url(text):
        return True
    key, _, number = text.rpartition("-")
    return bool(key and number.isdigit() and repo_for_key(config, key))


def resolve_initiative(config: dict, ref: str, fallback_repo: str | None) -> tuple[str, int]:
    """`--initiative` in any of its three forms: `35`, `TEST-35`, `large-new-feature`.

    References are tried first, and not only for tidiness: the slug lookup is a
    search per repository in the profile, and a number or a keyed reference can
    be resolved without asking GitHub anything. It also settles the order
    deliberately -- a slug that happened to be all digits would otherwise shadow
    the issue of that number.

    A bare number means *in this repository*, the same as everywhere else in this
    tool. On a board spanning repositories, name the other one with `KEY-NUMBER`
    or with the slug, which is repository-independent by design.
    """
    text = str(ref).strip()
    if looks_like_issue_ref(text, config):
        return parse_issue_ref(text, config, fallback_repo)
    found = find_initiative(config, text)
    if found:
        return found
    sys.exit(
        f"no initiative matches {ref!r}.\n"
        f"  --initiative takes an issue number (35), a keyed reference (TEST-35), a URL,\n"
        f"  or an initiative's slug (large-new-feature). No issue carries "
        f"`{INITIATIVE_LABEL}{text}`."
    )


def find_initiative(config: dict, slug: str) -> tuple[str, int] | None:
    """The issue that owns `slug`, or `None`. Searched across the profile's repos.

    An initiative may span repositories -- that is the case it exists for -- so
    this cannot be scoped to the one clone the caller happens to be standing in.
    """
    for repo in sorted({e["repo"] for e in profile_keys(config) if e.get("repo")}):
        found = json.loads(gh([
            "issue", "list", "--repo", repo, "--state", "all", "--limit", "200",
            "--label", f"{INITIATIVE_LABEL}{slug}", "--label", "type:initiative",
            "--json", "number",
        ]))
        if found:
            return repo, found[0]["number"]
    return None


#: An initiative's tree: its epics, and their stories, in whatever repository each
#: lives in. Two levels below the root, because that is the hierarchy this tool
#: defines -- initiative, epic, story -- and a query that recursed further would
#: be describing a shape nothing here creates.
#:
#: Measured before this was designed: sub-issues nest at least three deep and a
#: child may live in another repository, with roll-up counting the children in
#: both. Roll-up is **not** transitive, which is why the label exists at all.
INITIATIVE_TREE_QUERY = """
query($owner: String!, $repo: String!, $number: Int!) {
  repository(owner: $owner, name: $repo) {
    issue(number: $number) {
      number repository { nameWithOwner } labels(first: 30) { nodes { name } }
      subIssues(first: 100) {
        nodes {
          number repository { nameWithOwner } labels(first: 30) { nodes { name } }
          subIssues(first: 100) {
            nodes { number repository { nameWithOwner } labels(first: 30) { nodes { name } } }
          }
        }
      }
    }
  }
}
"""


def initiative_tree(target: dict) -> list[dict]:
    """Every issue under the initiative, the initiative itself included.

    It carries its own label, so that it appears in a board filtered to the
    initiative rather than being the one thing missing from its own view.
    """
    owner, name = target["repo"].split("/", 1)
    data = (graphql(INITIATIVE_TREE_QUERY, owner=owner, repo=name,
                    number=target["number"]).get("data") or {})
    root = (data.get("repository") or {}).get("issue")
    out: list[dict] = []

    def visit(node):
        if not node:
            return
        out.append({
            "repo": (node.get("repository") or {}).get("nameWithOwner") or "",
            "number": node["number"],
            "labels": [n["name"] for n in (node.get("labels") or {}).get("nodes") or []],
        })
        for child in (node.get("subIssues") or {}).get("nodes") or []:
            visit(child)

    visit(root)
    return out


def reconcile_initiative(args, target: dict) -> int:
    """Bring `initiative:<slug>` into line with the hierarchy, both ways.

    **The label is derived, never authored.** A board filter cannot traverse the
    hierarchy, so seeing an initiative's whole tree needs the label on every item
    in it -- and a copy of something already recorded is a copy that drifts. The
    mitigations are that nothing but this writes it, re-running is idempotent,
    and the disagreement is visible rather than silent.

    **Both directions, and the removal is the half that is easy to forget.** An
    epic detached from an initiative keeps the label unless something takes it
    away, and a stale label is worse than a missing one: the board shows work
    that is no longer part of the initiative, and it looks right. So the tree is
    the authority and the search across every repository in the profile is what
    finds what has fallen out of it.
    """
    label = f"{INITIATIVE_LABEL}{target['slug']}"
    tree = initiative_tree(target)
    wanted = {(node["repo"], node["number"]) for node in tree if node["repo"]}

    carrying = set()
    for repo in sorted({e["repo"] for e in profile_keys(args._config) if e.get("repo")}):
        for issue in json.loads(gh(["issue", "list", "--repo", repo, "--state", "all",
                                    "--limit", "200", "--label", label,
                                    "--json", "number"])):
            carrying.add((repo, issue["number"]))

    add = sorted(wanted - carrying)
    drop = sorted(carrying - wanted)
    for repo, number in add:
        if args.dry_run:
            print(f"    would label {repo}#{number}  +{label}")
        else:
            ensure_labels(repo, [label])
            gh(["issue", "edit", str(number), "--repo", repo, "--add-label", label])
            print(f"    labelled {repo}#{number}  +{label}")
    for repo, number in drop:
        if args.dry_run:
            print(f"    would unlabel {repo}#{number}  -{label}  (no longer in the tree)")
        else:
            gh(["issue", "edit", str(number), "--repo", repo, "--remove-label", label])
            print(f"    unlabelled {repo}#{number}  -{label}  (no longer in the tree)")

    verb = "would change" if args.dry_run else "changed"
    print(f"  {label}: {verb} {len(add) + len(drop)}, already correct "
          f"{len(wanted & carrying)}, across {len(tree)} issue(s) in the tree")
    return 0


def cmd_initiative(args) -> int:
    if args.initiative_command == "reconcile":
        target = initiative_target(args._config, args.ref, getattr(args, "repo", None))
        return reconcile_initiative(args, target)
    return create_initiative(args)


def create_initiative(args) -> int:
    """Create an initiative: the plan and WBS for a large new feature.

    **A level above epic, which Jira charges for.** Its standard hierarchy tops
    out at Epic; levels above come from Advanced Roadmaps. GitHub's sub-issues
    nest -- measured three deep, and across repositories, with roll-up counting
    the children in both -- so the level costs nothing here but a label and a
    command.

    The issue is the authority. It carries the plan in `## Intent` and what
    finished looks like in `## Acceptance`, it can be closed, and it rolls up --
    which is the part a label alone cannot do, and the reason free-tier Jira
    teams emulating this with a label have nowhere to write the plan down.
    """
    require_sprint_config(args._config, "creating an initiative")
    require_key_for_prefix(args._config, getattr(args, "key", None))
    # Parsed before anything is created, the same ordering `epic` uses: an
    # issue number is never reused, so a refusal afterwards costs one. The same
    # `iso_date` too -- a second parser is one that can disagree about what a
    # date is.
    starts_on = iso_date(getattr(args, "start", None), "--start")
    targets_on = spanned_target(starts_on,
                                iso_date(getattr(args, "target", None), "--target"),
                                getattr(args, "span", None), args._config)
    slug = args.slug or initiative_slug(args.title)
    # Refused rather than shared. Two initiatives answering to one slug would put
    # both trees behind one board filter and look entirely correct -- the same
    # failure an unreadable filter term is refused to avoid.
    existing = find_initiative(args._config, slug)
    if existing:
        sys.exit(
            f"initiative slug {slug!r} is already taken by {existing[0]}#{existing[1]}.\n"
            f"  Two initiatives answering to one slug put both trees behind one board "
            f"filter.\n"
            f"  Pass --slug to choose another."
        )
    labels = ["type:initiative", f"{INITIATIVE_LABEL}{slug}"] + (
        [f"{KEY_LABEL}{args.key}"] if getattr(args, "key", None) else [])
    ensure_labels(args.repo, labels)
    number, _node = create_issue(
        args.repo, args.title,
        BODY_TEMPLATE.format(intent=args.intent or "_TBD_", acceptance=args.acceptance or "_TBD_"),
        labels,
    )
    title = apply_title_prefix(
        args._config, args.repo, number, getattr(args, "key", None), "initiative", args.title
    )
    url = f"https://github.com/{args.repo}/issues/{number}"
    # Named before the board is touched, for the same reason as `epic`: the
    # project write is a separate grant and the issue already exists.
    print(f"  initiative #{number}: {title}")
    print(f"  {INITIATIVE_LABEL}{slug}")
    print(f"  {url}")
    with board_write_reported(number, url, args.project):
        item = add_to_project(args.owner, args.project, url)
        set_field(args.owner, args.project, item, "Status", "Todo")
        # **The same two fields an epic gets, and for the same reason.** #175
        # gave an epic dates because GitHub's roadmap places an item from a date
        # or an iteration field and a container has no Sprint by rule. #176 put
        # initiatives on that roadmap, which reproduced the defect one level up:
        # `board show` renders them, the web UI drops them into the undated
        # bucket.
        #
        # **Typed, never derived.** The tool could compute these from the epics
        # beneath -- and would then be authoring a plan nobody made. The derived
        # answer to *when did this start* already exists as the roadmap's own
        # axis, from the `sprint:` labels below. A plan is not a measurement.
        # Said the same way `plan` says it: a date reached by arithmetic looks
        # exactly like one somebody typed, and the field cannot hold the
        # difference.
        note = (f" ({args.span} from {starts_on})" if getattr(args, "span", None) else "")
        for field_name, value in zip(DATE_FIELDS, (starts_on, targets_on),
                                     strict=True):
            if value:
                set_field(args.owner, args.project, item, field_name, value)
                print(f"  #{number} {field_name} = {value}"
                      f"{note if field_name == DATE_FIELDS[1] else ''}")
    return 0


def initiative_target(config: dict, ref: str, repo: str | None) -> dict:
    """Everything needed to attach to an initiative, resolved **before any write**.

    Separate from the attaching on purpose. A mistyped `--initiative` is a
    caller's error that costs nothing to detect, and every check here -- does the
    reference resolve, does that issue exist, is it actually an initiative -- can
    be made without creating anything. Doing it afterwards left a real orphan:
    `epic "..." --initiative nope` created the issue, printed it, and then exited,
    and issue numbers are never reused.
    """
    parent_repo, parent_number = resolve_initiative(config, ref, repo)
    parent = json.loads(gh(["issue", "view", str(parent_number), "--repo", parent_repo,
                            "--json", "id,labels"]))
    slug = next((lb["name"][len(INITIATIVE_LABEL):] for lb in parent["labels"]
                 if lb["name"].startswith(INITIATIVE_LABEL)), None)
    if not slug:
        sys.exit(f"{parent_repo}#{parent_number} carries no {INITIATIVE_LABEL} label, so it "
                 f"is not an initiative.\n  Create one with `gh agile initiative`.")
    return {"repo": parent_repo, "number": parent_number, "id": parent["id"], "slug": slug}


def attach_to_initiative(target: dict, repo: str, number: int, node: str) -> None:
    """Make this issue a sub-issue of the initiative, and give it the same label.

    Both, because they answer different questions. The **edge** is the truth and
    rolls up; the **label** is what a board filter can see, since a filter cannot
    traverse the hierarchy -- `FILTER_TERMS` evaluates one item at a time and
    GitHub's own view filters reach at most one level.
    """
    graphql(
        "mutation($parent: ID!, $child: ID!) { addSubIssue(input: "
        "{issueId: $parent, subIssueId: $child}) { subIssue { number } } }",
        parent=target["id"], child=node,
    )
    label = f"{INITIATIVE_LABEL}{target['slug']}"
    ensure_labels(repo, [label])
    gh(["issue", "edit", str(number), "--repo", repo, "--add-label", label])
    print(f"  #{number} under initiative {target['repo']}#{target['number']}  ({label})")


#: The two dates the web roadmap needs to place a bar, and the only fields here
#: that record a *plan* rather than a measurement.
#:
#: GitHub's roadmap layout places an item from a date field or an iteration
#: field, and an epic has neither: #115 made it a rule that a container carries
#: no Sprint. So every epic landed in the web roadmap's undated bucket while
#: `board show` looked right -- it reconstructs an axis from the `sprint:`
#: labels of an epic's *descendants*, which the web UI has no way to do.
#:
#: **They are a plan, and the derived axis is a measurement.** `board show`
#: keeps deriving *when did this start* from the labels beneath an epic; these
#: say when somebody intended it to. The two are not interchangeable and neither
#: replaces the other.
DATE_FIELDS = ("Start date", "Target date")


def iso_date(value: str | None, flag: str) -> str | None:
    """`YYYY-MM-DD`, or a refusal naming the flag. UTC, like every date here.

    **Refused before anything is created**, which is the whole value of checking
    here. `gh` does parse a `--date` itself and rejects `soon` too -- measured,
    against a real DATE field -- but only once `epic` has made the issue, and an
    issue number is never reused, so that refusal leaves a permanent orphan. The
    same reasoning as resolving `--initiative` before the issue exists.

    (Said differently until #182: that GitHub would take the string and render
    nothing. That was true of the value this tool was actually sending, which was
    `--text`.)
    """
    if value is None:
        return None
    import datetime as dt
    try:
        return dt.date.fromisoformat(value.strip()).isoformat()
    except ValueError:
        sys.exit(f"{flag} {value!r} is not a date. Use YYYY-MM-DD, in UTC -- "
                 f"{today_utc().isoformat()} is today.")


#: What a planner types instead of an end date, in days. **Calendar days, not
#: working days**, and the refusal to pretend otherwise is the point: the two
#: fields GitHub holds are calendar dates and its roadmap draws calendar time,
#: while working-day arithmetic needs a holiday calendar for a team whose
#: location this tool never sees.
DURATION_UNITS = {"d": 1, "day": 1, "days": 1, "w": 7, "week": 7, "weeks": 7}

#: The one unit a planner says out loud that a calendar cannot convert. Taken
#: from the profile's own `cadence_days`, so `3sprints` is exact rather than
#: approximate -- which is the whole reason it is offered.
SPRINT_UNITS = ("sprint", "sprints")

#: Refused by name rather than falling into the general message. A month is not
#: a duration -- it is 28, 29, 30 or 31 days -- and quietly choosing one of them
#: is the kind of guess that ends up in a plan somebody quotes.
AMBIGUOUS_UNITS = ("m", "mo", "month", "months", "y", "year", "years")


def duration_days(text: str, config: dict) -> int:
    """`6w` -> 42, `3sprints` -> 3 x the profile's cadence. Whole days, always.

    The profile is read only when the unit is a sprint, so a duration in days or
    weeks works on a profile that declares no sprint block at all.
    """
    raw = "".join(str(text).split()).casefold()
    cut = 0
    while cut < len(raw) and raw[cut].isdigit():
        cut += 1
    count, unit = raw[:cut], raw[cut:]
    if not count or int(count) < 1:
        sys.exit(f"--for {text!r} is not a duration. Use a count and a unit, "
                 f"as in 6w, 10d or 3sprints.")
    if unit in SPRINT_UNITS:
        return int(count) * sprint_settings(config)["cadence_days"]
    if unit in AMBIGUOUS_UNITS:
        sys.exit(
            f"--for {text!r}: a month or a year is not a fixed number of days, so "
            f"nothing here can\n  turn one into a date without choosing on your "
            f"behalf. Say it in weeks, days or\n  sprints -- 13w, 90d, 6sprints."
        )
    if unit not in DURATION_UNITS:
        sys.exit(f"--for {text!r}: {unit!r} is not a unit. Use d, w, or sprints.")
    return int(count) * DURATION_UNITS[unit]


def target_from(start: str, span: str, config: dict) -> str:
    """The last day of a span beginning on `start`. **Inclusive.**

    `--start 2026-09-28 --for 1sprint` gives `2026-10-11`, which is exactly what
    `sprint list` prints for that iteration: a fortnight is fourteen days counted
    inclusively, and the last of them is the fourteenth. A convention that
    disagreed with the tool's own sprint windows by a day would be found by
    somebody comparing the two and never quite believed again.
    """
    import datetime as dt
    days = duration_days(span, config)
    return (dt.date.fromisoformat(start) + dt.timedelta(days=days - 1)).isoformat()


#: Refused wherever both arrive. They answer the same question and can disagree,
#: and picking one silently is how a plan ends up meaning something nobody typed.
#: One string because there are two doors -- `epic` and `initiative` reach it
#: through `spanned_target`, `plan` refuses before it reads anything at all.
SPAN_AND_TARGET = (
    "--for and --target both say when this finishes, and they can disagree.\n"
    "  Pass one: --target for a date somebody fixed, --for a span you are sizing."
)


def spanned_target(starts_on: str | None, targets_on: str | None,
                   span: str | None, config: dict) -> str | None:
    """`--target`, or the end of `--for` measured from the start. Never both.

    **A planner types a duration, not an end date.** A WBS sizes a phase in
    weeks, a Gantt places it after a start and draws the bar; nobody types the
    far end. This is that arithmetic and nothing more -- the duration is typed by
    a person, so the result is still a plan, which is the line #179 drew and the
    reason this reads no estimate, no velocity and nothing beneath the item.
    """
    if not span:
        return targets_on
    if targets_on:
        sys.exit(SPAN_AND_TARGET)
    if not starts_on:
        sys.exit("--for measures a span, and there is no start date to measure it "
                 "from.\n  Pass --start YYYY-MM-DD as well.")
    return target_from(starts_on, span, config)


def cmd_epic(args) -> int:
    require_sprint_config(args._config, "creating an epic")
    require_key_for_prefix(args._config, getattr(args, "key", None))
    # Resolved first, so a mistyped `--initiative` costs nothing. It used to be
    # resolved after the issue existed, which turned a typo into a permanent
    # orphan -- the issue was created, printed, and then the command exited.
    target = (initiative_target(args._config, args.initiative, args.repo)
              if getattr(args, "initiative", None) else None)
    # Parsed before anything is created, for the same reason `--initiative` is
    # resolved first: an issue number is never reused, so a refusal afterwards
    # costs one. Named `starts_on`/`targets_on` because `target` in this
    # function is already the initiative being attached to.
    starts_on = iso_date(getattr(args, "start", None), "--start")
    targets_on = spanned_target(starts_on,
                                iso_date(getattr(args, "target", None), "--target"),
                                getattr(args, "span", None), args._config)
    labels = ["type:epic"] + ([f"{KEY_LABEL}{args.key}"] if getattr(args, "key", None) else [])
    ensure_labels(args.repo, labels)
    number, _node = create_issue(
        args.repo, args.title,
        BODY_TEMPLATE.format(intent=args.intent or "_TBD_", acceptance=args.acceptance or "_TBD_"),
        labels,
    )
    title = apply_title_prefix(
        args._config, args.repo, number, getattr(args, "key", None), "epic", args.title
    )
    url = f"https://github.com/{args.repo}/issues/{number}"
    # Reported before the board is touched, and not after. These two lines used
    # to come last, so a refused project write -- the ordinary outcome for anyone
    # with repo access but not project access -- exited without ever naming the
    # issue that now existed. Issue numbers are never reused, so that was a
    # permanent orphan nobody knew to close.
    print(f"  epic #{number}: {title}")
    print(f"  {url}")
    if target:
        attach_to_initiative(target, args.repo, number, _node)
    with board_write_reported(number, url, args.project):
        item = add_to_project(args.owner, args.project, url)
        set_field(args.owner, args.project, item, "Status", "Todo")
        # Optional, always. An epic with no dates behaves exactly as it did
        # before these fields existed -- on every board, and in `validate`.
        # Said the same way `plan` says it: a date reached by arithmetic looks
        # exactly like one somebody typed, and the field cannot hold the
        # difference.
        note = (f" ({args.span} from {starts_on})" if getattr(args, "span", None) else "")
        for field_name, value in zip(DATE_FIELDS, (starts_on, targets_on),
                                     strict=True):
            if value:
                set_field(args.owner, args.project, item, field_name, value)
                print(f"  #{number} {field_name} = {value}"
                      f"{note if field_name == DATE_FIELDS[1] else ''}")
    return 0


def cmd_story(args) -> int:
    """Create a story, attach it to its epic, and set its fields -- in one call.

    One call because the multi-step version is where hand-editing goes wrong:
    an issue created now and attached to its epic later is an orphan in every
    roll-up run in between, and nothing complains. POLICY.md §3.
    """
    require_sprint_config(args._config, "creating a story")
    require_key_for_prefix(args._config, getattr(args, "key", None))
    # **`--epic none` is an explicit opt-out, and a bare omission still refuses.**
    # Some teams file one-off and ad-hoc work, and refusing it pushes that work
    # outside the tool entirely, where it is neither tracked nor exported -- not
    # great project management, and not this tool's decision to enforce. But an
    # orphan story is far more often an accident than an intention, so saying so
    # is required. POLICY.md §2.
    orphan = str(args.epic).strip().casefold() == "none"
    # Resolved and read before the story exists, as `task` does its `--story`:
    # an issue number is never reused, so a mistyped parent must cost nothing.
    # This used to create the story first and look the epic up afterwards, so
    # `--epic 9999` left an orphan behind its own error. And it took digits
    # only, so on a board spanning repositories `--epic ZMBNI-40` was refused
    # while `task --story ZMBNI-40` worked (#201).
    parent = None
    if not orphan:
        if not looks_like_issue_ref(str(args.epic).strip(), args._config):
            sys.exit(f"--epic {args.epic!r} names no epic: give its number, KEY-NUMBER or "
                     f"URL, or `none`.\n  `--epic none` files a story that stands alone.")
        epic_repo, epic = parse_issue_ref(str(args.epic), args._config, args.repo)
        try:
            parent = json.loads(gh(["issue", "view", str(epic), "--repo", epic_repo,
                                    "--json", "id,labels"]))
        except SystemExit as exc:
            sys.exit(f"--epic {args.epic!r} could not be read: {exc}\n"
                     f"  Nothing was created. `--epic none` files a story that stands "
                     f"alone.")
        parent_type = next((lb["name"][len("type:"):] for lb in parent.get("labels") or []
                            if lb["name"].startswith("type:")), None)
        if parent_type and parent_type != "epic":
            sys.exit(f"{epic_repo}#{epic} is a {parent_type}, and a story belongs to an "
                     f"epic.\n  Nothing was created.")
    labels = ["type:story"] + ([f"{KEY_LABEL}{args.key}"] if getattr(args, "key", None) else [])
    ensure_labels(args.repo, labels)
    number, node = create_issue(
        args.repo, args.title,
        BODY_TEMPLATE.format(intent=args.intent or "_TBD_", acceptance=args.acceptance or "_TBD_"),
        labels,
    )
    title = apply_title_prefix(
        args._config, args.repo, number, getattr(args, "key", None), "story", args.title
    )
    url = f"https://github.com/{args.repo}/issues/{number}"
    # Announced as soon as it exists, for the same reason as `epic`: everything
    # after this point can be refused independently of the issue creation that
    # already succeeded, and a story has two such steps rather than one.
    where = ("standing alone" if orphan else
             f"under epic #{epic}" if epic_repo == args.repo else
             f"under epic {epic_repo}#{epic}")
    print(f"  story #{number} {where}: {title}")
    print(f"  {url}")

    if parent:
        graphql(
            "mutation($parent: ID!, $child: ID!) { addSubIssue(input: "
            "{issueId: $parent, subIssueId: $child}) { subIssue { number } } }",
            parent=parent["id"], child=node,
        )

    with board_write_reported(number, url, args.project):
        item = add_to_project(args.owner, args.project, url)
        # Always `Todo`. `--status` went in #202: it was a second route to Done
        # that asked for no evidence, and every other status is a start of work,
        # which `issue move` is for -- claiming the issue, assigning the sprint.
        set_field(args.owner, args.project, item, "Status", "Todo")
        if args.points is not None:
            set_field(args.owner, args.project, item, "Story Points", args.points)
        if args.priority:
            set_field(args.owner, args.project, item, "Priority", args.priority)
    return 0


#: The Sprint iteration field with its iterations, as a selection inside
#: `projectV2` for `project_node`.
SPRINT_FIELD_SELECTION = """
      field(name: "Sprint") {
        ... on ProjectV2IterationField {
          id
          configuration {
            duration
            startDay
            iterations { id title startDate duration }
            completedIterations { id title startDate duration }
          }
        }
      }
"""


def sprint_field(login: str, number: int) -> dict:
    """The Sprint iteration field, with its iterations.

    Not reachable through `gh project field-list`, which reports the field but
    not its iterations -- and the iterations are the part you need, since an
    iteration is referenced by id, never by title.
    """
    node = project_node(login, number, SPRINT_FIELD_SELECTION)
    if node is None:
        sys.exit(f"no project {number} found for {login!r} as either a user or an organization")
    field = node.get("field")
    if not field:
        sys.exit("no Sprint iteration field on this project; run `gh agile setup`")
    return field


def iterations(login: str, number: int) -> tuple[list[dict], list[dict]]:
    config = sprint_field(login, number)["configuration"]
    return config["iterations"], config["completedIterations"]


def resolve_iteration(login: str, number: int, value: str) -> str:
    """Title, or `@current`, to an iteration id.

    `@current` is the first *active* iteration: GitHub returns completed ones in
    a separate list, so "the current sprint" is unambiguous rather than a date
    comparison this tool would have to get right.
    """
    active, completed = iterations(login, number)
    if value.strip().casefold() in ("@current", "current"):
        if not active:
            sys.exit("no active sprint; create one with `gh agile sprint create`")
        return active[0]["id"]
    for it in active + completed:
        if it["title"].casefold() == value.casefold():
            return it["id"]
    known = ", ".join(i["title"] for i in active) or "none active"
    sys.exit(f"no sprint titled {value!r}; active: {known}")


def sprint_assignments(login: str, project: int) -> dict[str, str]:
    """{project item id: sprint title} for every item currently in a sprint.

    Read before any iteration change and re-applied after, because GitHub gives
    no way to preserve them. `ProjectV2Iteration` -- the only input the
    configuration mutation accepts -- carries `startDate`, `duration` and
    `title` and **no id**, so every update mints fresh iteration ids and every
    item pointing at an old one is silently cleared. Verified: appending one
    sprint while re-sending the existing two identically cleared an assignment
    made seconds earlier.
    """
    # Through GraphQL, not `gh project item-list`: that command returns only
    # content, id, labels, repository, status and title -- no custom field
    # values at all, so a sprint read from it is always absent.
    _title, items = fetch_items(login, project)
    out = {}
    for item in items:
        sprint = field_values(item).get("Sprint")
        if sprint:
            out[item["id"]] = sprint
    return out


#: **Why this does not skip containers, though one should never be in a sprint.**
#:
#: It would work: dropping them here means the next iteration write clears the
#: stray value and nothing puts it back, and #170 was filed partly because this
#: pair is what preserves it. It is still the wrong place.
#:
#: A save-and-restore has one job -- put back exactly what was there -- and it
#: runs either side of the most destructive operation in this tool, with no
#: transaction and a budget check in between. A pair that silently restores less
#: than it saved cannot be reasoned about when a run dies half way, which is the
#: failure `require_graphql_budget` exists for.
#:
#: And it would repair by side effect: a person running `sprint create` would
#: find an epic's field quietly gone, with nothing having said so. Clearing a
#: value that should not exist is a repair, so it belongs in the pass named for
#: repairs -- `sprint unstamp`, which says what it did -- and `validate` points
#: there. Symmetric here, explicit there.


def restore_assignments(login: str, project: int, saved: dict[str, str]) -> int:
    """Re-apply saved sprint assignments by title. Costs one call per item."""
    if not saved:
        return 0
    _FIELDS.pop((login, project), None)  # iteration ids changed
    restored, failed = 0, []
    for item_id, title in saved.items():
        try:
            set_field(login, project, item_id, "Sprint", title)
            restored += 1
        except SystemExit as exc:
            # Carry the reason. Without it this printed only "could not
            # restore", and an unrestored assignment is silent data loss -- the
            # item is out of every sprint report and nothing says why.
            failed.append((item_id, title))
            print(f"  could not restore {title!r} for {item_id[:12]}…: {exc}", file=sys.stderr)
    if failed:
        print(
            f"  {len(failed)} sprint assignment(s) could not be re-applied from the "
            f"snapshot taken before the change.\n"
            f"  The `sprint:` labels are unaffected -- recover the field from them:\n"
            f"    gh agile sprint reconcile",
            file=sys.stderr,
        )
    return restored


def iteration_spans(existing: list[dict]) -> list[tuple]:
    """[(start, end)] for every iteration, inclusive of the end day."""
    import datetime as dt

    return sorted(
        (dt.date.fromisoformat(i["startDate"]),
         dt.date.fromisoformat(i["startDate"]) + dt.timedelta(days=i["duration"] - 1))
        for i in existing
    )


def overlapping(spans: list[tuple], start, end):
    """The first existing span intersecting [start, end], or None.

    Intersection, not containment. Testing containment read a partial overlap as
    uncovered and put three overlapping sprints on a live board; overlapping
    sprints make `@current` arbitrary, which is the one thing it exists to
    resolve.

    Shared with `sprint create` deliberately. This test used to live inside
    `ensure_sprints` while `create --start` -- the path a person actually types
    by hand -- had none at all, so the guard was missing from exactly the route
    most likely to need it.
    """
    return next((sp for sp in spans if sp[0] <= end and start <= sp[1]), None)


def ensure_sprints(login: str, project: int, config: dict, ahead: int,
                   *, quiet: bool = False) -> list[str]:
    """Guarantee a sprint covering today, plus `ahead` future ones.

    Jira's model, and the reason `move` should not have to create anything: the
    backlog always holds future sprints, so starting work never mutates the
    project's configuration.

    Gaps are **skipped, not backfilled**. After an idle month this creates the
    sprint covering today and numbering jumps -- Sprint 2 to Sprint 5 -- rather
    than inventing three sprints nobody worked in. Jira does the same.
    """
    import datetime as dt

    settings = sprint_settings(config)
    field = sprint_field(login, project)
    existing = field["configuration"]["completedIterations"] + field["configuration"]["iterations"]
    duration = settings["cadence_days"]
    today = today_utc()

    spans = iteration_spans(existing)

    def overlaps(start, end):
        return overlapping(spans, start, end) is not None

    key = (config.get("project") or {}).get("key") or ""
    made, entries = [], [
        f'{{startDate: "{i["startDate"]}", duration: {i["duration"]}, '
        f'title: {json.dumps(i["title"])}}}' for i in existing
    ]
    number = len(existing)

    # What is missing, rather than how many to make: a sprint covering today,
    # and `ahead` that start after it. Counting what exists first is what makes
    # this idempotent -- the first version created `ahead + 1` every run,
    # because it only ever asked whether a window overlapped, never whether the
    # requirement was already met.
    covering = next((span for span in spans if span[0] <= today <= span[1]), None)

    def append(start):
        nonlocal number
        end = start + dt.timedelta(days=duration - 1)
        if overlaps(start, end):
            return None
        number += 1
        title = settings["name_template"].format(
            n=number, key=key, start=start.isoformat(), end=end.isoformat(),
            year=start.year, iso_week=f"{start.isocalendar()[1]:02d}",
        )
        entries.append(
            f'{{startDate: "{start.isoformat()}", duration: {duration}, '
            f'title: {json.dumps(title)}}}'
        )
        spans.append((start, end))
        spans.sort()
        made.append(f"{title}  {start} .. {end}")
        return end

    uncovered = covering is None
    if uncovered:
        # Aligned to the configured start day, so a sprint created on a
        # Wednesday still begins on Monday and covers today.
        placed = append(aligned_start(today, settings["start_day"]))
        if placed is None and spans:
            # The aligned window overlapped an existing sprint, which happens
            # when the series starts *after* today: the first sprint was created
            # by hand on a date of somebody's choosing, and today falls before
            # it. Step back from that first sprint by exactly one cadence, which
            # both covers today and abuts the series -- rather than leaving a
            # hole and claiming there is a current sprint.
            earliest = min(start for start, _end in spans)
            candidate = earliest - dt.timedelta(days=duration)
            if candidate <= today:
                placed = append(candidate)
        if placed is None:
            print(f"  no sprint covers today ({today}), and none can be placed "
                  f"without overlapping an existing one", file=sys.stderr)

    while len([span for span in spans if span[0] > today]) < ahead:
        last_end = max(end for _start, end in spans) if spans else today
        if append(last_end + dt.timedelta(days=1)) is None:
            break  # cannot place another without overlapping; stop rather than loop

    saved = sprint_assignments(login, project) if made else {}
    if made:
        require_graphql_budget(len(saved), "creating a sprint")
        # Every existing iteration is re-sent. The configuration is replaced
        # wholesale -- the same trap that cleared Status from 16 items when
        # options were re-sent without their ids -- so anything omitted here is
        # deleted, taking its items' sprint assignment with it.
        graphql(
            "mutation($f: ID!) { updateProjectV2Field(input: {fieldId: $f, "
            'iterationConfiguration: {startDate: "%s", duration: %d, iterations: [%s]}}) '
            "{ projectV2Field { ... on ProjectV2IterationField { id } } } }"
            % (aligned_start(today, settings["start_day"]).isoformat(), duration,
               ", ".join(entries)),
            f=field["id"],
        )
        restored = restore_assignments(login, project, saved)
        if restored:
            print(f"  re-applied {restored} sprint assignment(s) the update cleared")
        heal_sprint_fields(login, project)
    if not quiet:
        for line in made:
            print(f"  created {line}")
        if not made:
            # Say which of the two is true, rather than asserting the happy one.
            # This claimed a current sprint existed while the series began the
            # following day and every board filtered on sprint:@current was
            # empty.
            if covering:
                print(f"  a current sprint and {ahead} ahead already exist")
            else:
                nxt = min((start for start, _e in spans if start > today), default=None)
                when = f"; the next starts {nxt}" if nxt else ""
                print(f"  nothing created, and no sprint covers today{when}")
    return made


def backfill_sprint_labels(args) -> int:
    """Stamp `sprint:` labels on issues that predate the stamping.

    Two sources, because the obvious one barely works:

    `field` reads the project item's `Sprint` value. Honest, but it holds one
    value and any iteration write clears it board-wide -- on the board this was
    written for, 2 of 25 items still had one, the other 23 having been wiped by
    ordinary sprint creation. It also cannot show carryover: the field forgot
    every sprint but the last.

    `timeline` maps the Status transitions -- when the item reached In Progress
    and when it reached Done -- into the sprint whose window contains each
    moment. That is a derivation rather than a record, and it is stated as one,
    but Status changes are the one thing GitHub keeps a real history of, so it
    recovers what the field has already lost. It also reconstructs carryover:
    an item started in one sprint and finished in another gets both labels.

    Neither invents a sprint. A moment falling in a gap -- and gaps are normal,
    since sprints are created on demand -- is reported and skipped.
    """
    import datetime as dt

    active, completed = iterations(args.owner, args.project)
    spans = sprint_spans(active + completed)
    if not spans:
        sys.exit("no sprints exist on this project; nothing to backfill from")

    def covering(stamp: str):
        if not stamp:
            return None
        return sprint_covering(spans, dt.date.fromisoformat(stamp[:10]))

    data = rows(args.owner, args.project, with_history=args.source == "timeline")
    stamped = skipped = uncovered = containers = 0
    for row in data:
        labels = set(row["labels"].split(";")) if row["labels"] else set()
        # **The bulk write, and the one that matters.** An epic or initiative is
        # deliberately in no sprint, so deriving one here would stamp every one
        # on the board in a single run and undo that wholesale -- and `backfill`
        # is precisely what someone runs *because* `validate` complained. Same
        # reasoning as the abandoned issue below: a label asserts the sprint the
        # work was worked in, and neither level was worked in one sprint.
        if sprint_exempt(labels):
            containers += 1
            continue
        wanted = []
        if args.source == "field":
            match = next((sp for sp in spans if sp[2] == row.get("field_sprint")), None)
            if match:
                wanted.append(match)
        else:
            # The close moment is dropped for an abandoned issue, and the start
            # moment kept: a story genuinely worked in Sprint 2 and then given up
            # on really was worked in Sprint 2, while one closed as not planned
            # without ever starting was worked in no sprint at all. Without this
            # the repair pass silently re-asserts the label `validate` has just
            # stopped demanding -- and `backfill` is precisely what someone runs
            # *because* `validate` complained.
            abandoned = (row.get("state_reason") or "").upper() == ABANDONED
            moments = (row.get("started_at"), None if abandoned else row.get("done_at"))
            for stamp in moments:
                if not stamp:
                    continue
                match = covering(stamp)
                if match:
                    wanted.append(match)
                else:
                    uncovered += 1
        # Oldest first, so the last label written is the sprint it finished in.
        for start, _end, _title in sorted({(w[0], w[1], w[2]) for w in wanted}):
            label = f"{SPRINT_LABEL}{start.isoformat()}"
            if label in labels:
                skipped += 1
                continue
            ident = f"{row['repository']}#{row['number']}"
            if args.dry_run:
                print(f"  would stamp {ident}  {label}")
            else:
                ensure_labels(row["repository"], [label])
                gh(["issue", "edit", str(row["number"]), "--repo", row["repository"],
                    "--add-label", label])
                print(f"  stamped {ident}  {label}")
            stamped += 1

    verb = "would stamp" if args.dry_run else "stamped"
    print(f"  {verb} {stamped}, already present {skipped}, across {len(data)} item(s)")
    if containers:
        # Counted out loud. A silent skip on a repair pass reads as a pass that
        # found nothing to do, which is the one thing it must not be confused with.
        print(f"  {containers} epic(s)/initiative(s) skipped; a level that spans "
              f"sprints is never stamped")
    if uncovered:
        print(f"  {uncovered} transition(s) fell outside every sprint and were skipped; "
              f"no sprint covers those dates", file=sys.stderr)
    return 0


def unstamp_containers(args) -> int:
    """Remove `sprint:` labels from the levels that span sprints.

    The one-off repair for labels written before the rule existed, and the only
    place in this tool that *removes* a `sprint:` label.

    **Removing one is not done lightly and this is the stated exception.** The
    label is the immutable record -- `sprint reconcile` exists because the field
    is lossy and the labels are not -- so deleting one destroys history that
    nothing else holds. What makes these different is what the label asserts:
    *the sprint this work was worked in*. Each was stamped at close, so it
    records the sprint the issue was **closed** in. For a story those are the
    same fact. For an epic spanning four sprints they are not, and the label is
    a claim the work never supported.

    They are not inert, either, which is why this is a command rather than a
    note in the guide. `reconcile_sprints` reads labels and writes the field,
    and `heal_sprint_fields` runs it automatically after every destructive
    iteration write -- the routine fortnightly append. Measured on the live
    board: five closed epics stamped before the rule existed, every one of them
    proposed for Sprint 2 by a plain `reconcile --dry-run`. The guard in
    `reconcile_sprints` stops the field being written; this clears the labels
    that keep asking for it.

    Deliberately narrow. Only `sprint:` labels, only on `type:epic` and
    `type:initiative`, and a story is never touched whatever else is true of it.
    """
    _title, items = fetch_items(args.owner, args.project)
    cleared = scanned = 0
    for item in items:
        content = item.get("content") or {}
        if content.get("__typename") != "Issue":
            continue
        labels = [n["name"] for n in content["labels"]["nodes"]]
        level = container_level(labels)
        if not level:
            continue
        scanned += 1
        stamps = [lb for lb in labels if lb.startswith(SPRINT_LABEL)]
        repo = (content.get("repository") or {}).get("nameWithOwner")
        ident = f"{repo}#{content['number']}"
        # **The field, not only the label -- #123 cleared half of this.** A
        # container assigned a sprint before #115 barred it keeps that value
        # for ever: `reconcile_sprints` only ever *sets* a field, the automatic
        # heal fills empty ones, and `restore_assignments` carries it across
        # every iteration write. Nothing removed it, and `validate` was
        # deliberately silent about a container's sprint state.
        #
        # Measured: `REPORTS-1` sat on the Roadmap and vanished from the
        # Backlog, whose filter is `no:sprint` -- an epic invisible on the one
        # board an unstarted epic belongs to.
        if field_values(item).get("Sprint"):
            if args.dry_run:
                print(f"  would clear {ident}  Sprint field  ({level})")
            else:
                clear_field(args.owner, args.project, item["id"], "Sprint")
                print(f"  cleared {ident}  Sprint field  ({level})")
            cleared += 1
        if not stamps:
            continue
        for label in sorted(stamps):
            if args.dry_run:
                print(f"  would clear {ident}  -{label}  ({level})")
            else:
                # `--remove-label` for the same reason `--add-label` is used to
                # write them: it is additive's mirror and needs no
                # read-modify-write, so two runs cannot race a label off an
                # issue somebody else just added.
                gh(["issue", "edit", str(content["number"]), "--repo", repo,
                    "--remove-label", label])
                print(f"  cleared {ident}  -{label}  ({level})")
            cleared += 1

    verb = "would clear" if args.dry_run else "cleared"
    print(f"  {verb} {cleared} stray value(s) across {scanned} epic(s)/initiative(s)")
    if not cleared:
        # Said plainly: a repair pass that prints nothing is indistinguishable
        # from one that failed to look.
        print("  nothing stray; every epic and initiative is already clean")
    return 0


def reconcile_sprints(login: str, project: int, *, dry_run: bool = False,
                      overwrite: bool = False, quiet: bool = False) -> int:
    """Set each item's `Sprint` field from its `sprint:` labels; return how many.

    The repair for GitHub's iteration model. Any write to the iteration
    configuration -- including appending the next sprint, the routine
    fortnightly act -- re-mints every iteration id and clears every item's
    Sprint value, retroactively, closed issues in completed sprints included.
    Save-and-restore around this tool's own writes cannot cover a write made in
    the web UI, or a run that died partway.

    So the labels are authoritative and the field is reconciled toward them.
    Authoritative has to mean something reconciles *to* it.

    **An empty field is damage; a disagreeing field is a decision.** Only the
    first is repaired unless `overwrite` is set. The damage this heals is
    *clearing*, and a field someone deliberately pointed at a future sprint --
    an open story re-planned, its labels recording where it was actually
    worked -- is not the same thing. Overwriting that by default would make an
    automatic repair fight the person using it; `validate` reports the
    disagreement instead, and `--overwrite` acts on it when asked.

    The **latest** label wins. An item carried across a boundary carries one per
    sprint it lived in, and the field holds where it is now, the last of them.
    """
    active, completed = iterations(login, project)
    by_start = {i["startDate"]: i["title"] for i in active + completed}
    if not by_start:
        if not quiet:
            print("  no sprints exist on this project; nothing to reconcile to",
                  file=sys.stderr)
        return 0

    _title, items = fetch_items(login, project)
    changed = agreed = unknown = disagreed = containers = 0
    for item in items:
        content = item.get("content") or {}
        if content.get("__typename") != "Issue":
            continue
        labels = [n["name"] for n in content["labels"]["nodes"]]
        # **The guard that matters, because nobody runs this on purpose.**
        # `heal_sprint_fields` calls it after every destructive iteration write
        # -- the routine fortnightly append -- so a stray `sprint:` label on an
        # epic puts that epic into a sprint without anyone aiming a command at
        # it. Measured on the live board: five closed epics stamped before the
        # rule existed, all five proposed for Sprint 2 by a plain `reconcile
        # --dry-run`. Skipped rather than repaired, because the field this
        # would write is the one a level spanning sprints must not have.
        if sprint_exempt(labels):
            containers += 1
            continue
        stamps = sorted(lb[len(SPRINT_LABEL):] for lb in labels
                        if lb.startswith(SPRINT_LABEL))
        if not stamps:
            continue
        latest = stamps[-1]
        wanted = by_start.get(latest)
        if not wanted:
            # A label naming a sprint the configuration no longer has. Never
            # invent one: the label is the record and the configuration is what
            # drifted, so say so and leave both alone.
            if not quiet:
                print(f"  #{content['number']}: no sprint starts {latest}; left alone",
                      file=sys.stderr)
            unknown += 1
            continue
        current = field_values(item).get("Sprint")
        if current == wanted:
            agreed += 1
            continue
        ident = f"#{content['number']} {content['title'][:44]}"
        if current and not overwrite:
            disagreed += 1
            if not quiet:
                print(f"  {ident}: field {current!r} disagrees with label {latest}; "
                      f"left alone (--overwrite to change it)", file=sys.stderr)
            continue
        if dry_run:
            print(f"  would set {ident}  {current or '(empty)'} -> {wanted}")
        else:
            set_field(login, project, item["id"], "Sprint", wanted)
            print(f"  set {ident}  {current or '(empty)'} -> {wanted}")
        changed += 1

    if not quiet or changed:
        verb = "would set" if dry_run else "set"
        tail = f", disagreeing {disagreed}" if disagreed else ""
        # Named, because a stray label on an epic is something to clear rather
        # than something to live with: `sprint unstamp` is what clears it.
        tail += (f", spanning {containers} (see `gh agile sprint unstamp`)"
                 if containers else "")
        print(f"  {verb} {changed}, already correct {agreed}, "
              f"unresolvable {unknown}{tail}")
    return changed


def heal_sprint_fields(login: str, project: int) -> None:
    """Repair fields the iteration write just cleared, in the same run.

    Runs after `restore_assignments`, which replays a snapshot taken moments
    earlier and covers items the labels know nothing about -- one assigned by
    hand and never moved through `move`. This covers the rest: anything the
    restore could not put back, for whatever reason, including the run dying
    partway. Empty fields only, so it can never argue with a deliberate
    placement.

    Silent when there is nothing to do, which is the normal case: a restore that
    worked leaves no empty fields for this to find.
    """
    reconcile_sprints(login, project, overwrite=False, quiet=True)


def cmd_sprint(args) -> int:
    if args.sprint_command == "reconcile":
        reconcile_sprints(args.owner, args.project,
                          dry_run=args.dry_run, overwrite=args.overwrite)
        return 0

    if args.sprint_command == "backfill":
        return backfill_sprint_labels(args)

    if args.sprint_command == "unstamp":
        return unstamp_containers(args)

    if args.sprint_command == "ensure":
        require_sprint_config(args._config, "`sprint ensure`")
        settings = sprint_settings(args._config)
        ahead = args.ahead if args.ahead is not None else settings["ahead"]
        ensure_sprints(args.owner, args.project, args._config, ahead)
        return 0

    if args.sprint_command == "list":
        active, completed = iterations(args.owner, args.project)
        if not active and not completed:
            print("  no sprints; create one with `gh agile sprint create`")
        for index, it in enumerate(active):
            end = _iteration_end(it)
            mark = "  (current)" if index == 0 else ""
            print(f"  {it['title']:12} {it['startDate']} .. {end}{mark}")
        for it in completed:
            print(f"  {it['title']:12} {it['startDate']} .. {_iteration_end(it)}  (completed)")
        return 0

    import datetime as dt

    field = sprint_field(args.owner, args.project)
    # Validated before it reaches the mutation, where it is interpolated into
    # the GraphQL document as a bare string. Unchecked, "17/08/2026" produced a
    # syntax error from the API rather than a message, and a value containing a
    # quote rewrote the mutation around it.
    if args.start:
        try:
            dt.date.fromisoformat(args.start)
        except ValueError:
            sys.exit(f"--start {args.start!r} is not an ISO date; use YYYY-MM-DD")
    if args.weeks is not None and not 1 <= args.weeks * 7 <= MAX_SPRINT_DAYS:
        # The profile enforces 1..30 on `cadence_days` and this path bypassed
        # it, so a sprint could be created that no profile would allow.
        sys.exit(f"--weeks {args.weeks} is {args.weeks * 7} days; "
                 f"a sprint is 1 to {MAX_SPRINT_DAYS} days")
    duration = args.weeks * 7 if args.weeks else field["configuration"]["duration"]
    start = args.start
    if not start:
        # Default to the day after the last iteration ends, so sprints abut
        # rather than overlap -- an overlap makes "the current sprint"
        # ambiguous, which @current then resolves arbitrarily.
        import datetime as dt

        #
        # The latest *end*, not the last entry: `(active + completed)[-1]` was
        # the last completed sprint whenever one existed, so the default start
        # fell inside a live sprint and the overlap check refused it. Every
        # `sprint create` without `--start` on a board with history failed,
        # since the original commit; the dry run's test found it (#201).
        active, completed = iterations(args.owner, args.project)
        last = max(active + completed, key=_iteration_end, default=None)
        if last:
            end = dt.date.fromisoformat(_iteration_end(last))
            start = (end + dt.timedelta(days=1)).isoformat()
        else:
            start = today_utc().isoformat()
    # The configuration is replaced wholesale, not appended to: `startDate` and
    # `duration` are required at the top level and every existing iteration has
    # to be sent back or it is dropped. Each iteration also needs an explicit
    # title -- GitHub does not generate one through the API the way the UI does.
    active, completed = iterations(args.owner, args.project)
    existing = completed + active
    title = args.title or f"Sprint {len(existing) + 1}"
    entries = [
        f'{{startDate: "{i["startDate"]}", duration: {i["duration"]}, '
        f'title: {json.dumps(i["title"])}}}'
        for i in existing
    ]
    # The same overlap rule `ensure` applies. Without it, `create --start` on a
    # date already covered produced a second sprint over the same days, and
    # `@current` then picked between them arbitrarily.
    begins = dt.date.fromisoformat(start)
    finishes = begins + dt.timedelta(days=duration - 1)
    clash = overlapping(iteration_spans(existing), begins, finishes)
    if clash:
        sys.exit(
            f"a sprint already covers {clash[0]} .. {clash[1]}, which "
            f"{start} .. {finishes.isoformat()} would overlap.\n"
            f"  Overlapping sprints make `@current` ambiguous -- every scrum "
            f"board filters on it.\n"
            f"  Pick a start after {clash[1]}, or let `gh agile sprint ensure` "
            f"place it."
        )

    saved = sprint_assignments(args.owner, args.project)
    require_graphql_budget(len(saved), "creating a sprint")
    # After every refusal -- the date, the overlap, the budget -- so a dry run
    # that passes is one the real run would not refuse. The one write that
    # clears every Sprint value on the board was the one write without a dry
    # run (#201).
    if getattr(args, "dry_run", False):
        print(f"  would append {title}: {start}, {duration} day(s)")
        print(f"  the write clears every item's Sprint value; {len(saved)} "
              f"assignment(s) would be re-applied")
        return 0
    entries.append(f'{{startDate: "{start}", duration: {duration}, title: {json.dumps(title)}}}')
    graphql(
        "mutation($f: ID!) { updateProjectV2Field(input: {fieldId: $f, "
        'iterationConfiguration: {startDate: "%s", duration: %d, iterations: [%s]}}) '
        "{ projectV2Field { ... on ProjectV2IterationField { id } } } }"
        % (start, duration, ", ".join(entries)),
        f=field["id"],
    )
    restored = restore_assignments(args.owner, args.project, saved)
    if restored:
        print(f"  re-applied {restored} sprint assignment(s) the update cleared")
    heal_sprint_fields(args.owner, args.project)
    print(f"  {title}: {start}, {duration} day(s)")
    return 0


def _iteration_end(iteration: dict) -> str:
    import datetime as dt

    start = dt.date.fromisoformat(iteration["startDate"])
    return (start + dt.timedelta(days=iteration["duration"] - 1)).isoformat()


#: Board types, as Agile means them. GitHub has no such concept: it has a *view*
#: with a layout and a filter, and the **filter** is what makes a board scrum or
#: kanban.
#:
#: A scrum board is time-boxed -- it shows the work committed to the current
#: iteration and resets when the sprint does. A kanban board is continuous: no
#: iteration, all work in flight, limited by WIP rather than by a sprint
#: boundary. Same columns, same items; the difference is whether an iteration
#: scopes it.
BOARD_TYPES = {
    "scrum": {
        "layout": "BOARD_LAYOUT",
        "filter": "sprint:@current",
        "about": "the current sprint only; resets each iteration",
    },
    "kanban": {
        "layout": "BOARD_LAYOUT",
        "filter": "-status:Done",
        "about": "continuous flow, no iteration boundary",
    },
    "backlog": {
        "layout": "TABLE_LAYOUT",
        "filter": "no:sprint -status:Done",
        "about": "everything not yet committed to a sprint",
    },
    "roadmap": {
        "layout": "ROADMAP_LAYOUT",
        # **A roadmap answers "where are we going", so finished work is off it.**
        # Every other non-scrum type already drops it -- kanban is `-status:Done`,
        # backlog is `no:sprint -status:Done` -- and roadmap was the lone
        # exception. Measured on project #4 before this changed: `label:type:epic`
        # returned 12 epics and all 12 were complete; adding the exclusions left
        # 1. Sections ascend by start, so those 12 sat *above* the one thing
        # actually ahead and a reader scrolled backwards to reach the future.
        #
        # The argument for keeping history on a roadmap -- that seeing Q1's epic
        # land in Q2 is what makes next quarter's plan readable -- needs a
        # baseline, and there is none: `LAYOUT_SECTIONS` groups by when work
        # *began*, derived from the descendants' `sprint:` labels, and nothing
        # records what was planned. A completed epic here shows that a thing
        # happened, not that it slipped, and `export` answers that better. When
        # `#175` adds a target date the baseline exists and this is worth
        # revisiting.
        #
        # **Both terms, not just the status one.** A closed-as-not-planned epic
        # need not carry Status `Done` -- that is the state-vs-Status gap `#138`
        # exists for -- so `-status:Done` alone leaves abandoned work on the
        # roadmap, which is the one thing more misleading than finished work.
        # **Both levels, because the top of the hierarchy belongs on the one
        # view that shows the shape of the plan.** `label:type:epic` excluded
        # `type:initiative` by construction, so an initiative was missing from
        # the roadmap while every one of its epics was on it.
        "filter": "level:container -status:Done is:open",
        "about": "epics still ahead, over time",
    },
}


#: Sprint defaults, overridden by the profile's "sprint" block.
#:
#: `name_template` takes Jira's shape -- Jira names a sprint "<Board> Sprint <n>"
#: -- so a board keyed ZMBNI produces "ZMBNI Sprint 3". Boards created before
#: this default arrived keep their existing names; renaming them would rewrite
#: the sprint every historical item points at, for cosmetics.
SPRINT_DEFAULTS = {
    "cadence_days": 14,
    "start_day": "monday",
    "autocreate": True,
    "ahead": 2,
    # `0004 W38-2026`: the sprint number first because it is the only part anyone
    # says out loud, the ISO week because that is how a person places it in the
    # year, and the year last because it is there to sort by. Thirteen characters
    # of which the first eight carry the meaning, which is what lets the board's
    # sprint column be eight wide -- Jira's `<Board> Sprint <n>` spends seven of
    # those on the word "Sprint" and truncates to nothing useful.
    #
    # **A profile that already names sprints keeps its template**, and existing
    # sprints are never renamed: any write to the iteration configuration clears
    # every item's Sprint value board-wide. A new default changes what the next
    # project does, not what an existing one is called.
    "name_template": "{n:04d} W{iso_week}-{year}",
    "record_label": True,
}

#: GitHub numbers `startDay` 1=Sunday … 7=Saturday. Python's weekday() is
#: 0=Monday … 6=Sunday. Two conventions, one off-by-one waiting to happen, so
#: the mapping is written down rather than computed inline.
WEEKDAYS = {
    "sunday": 1, "monday": 2, "tuesday": 3, "wednesday": 4,
    "thursday": 5, "friday": 6, "saturday": 7,
}


#: Named cadences, offered at project creation so the choice is made once,
#: deliberately, before anything depends on it.
#:
#: `none` is not a cop-out: a kanban team has no sprints, and forcing a cadence
#: on them would put every item in an iteration nobody uses. Choosing it is a
#: statement, and it is recorded like any other.
SPRINT_TEMPLATES = {
    "1-week": {"cadence_days": 7, "start_day": "monday", "ahead": 2},
    "2-week": {"cadence_days": 14, "start_day": "monday", "ahead": 2},
    "3-week": {"cadence_days": 21, "start_day": "monday", "ahead": 2},
    "4-week": {"cadence_days": 28, "start_day": "monday", "ahead": 2},
    "none": {"autocreate": False, "cadence_days": 14, "start_day": "monday", "ahead": 0},
}


def require_sprint_config(config: dict, doing: str) -> None:
    """Refuse until a sprint cadence has been chosen deliberately.

    Defaults used to apply silently, so the first sprint was created with
    whatever the tool assumed and the cadence was discovered later -- by which
    point sprints existed under it, and changing course meant either living with
    the wrong rhythm or renaming sprints, which clears every assignment because
    iterations carry no id.

    The cost of getting this wrong is paid later and by someone else, so it is
    asked up front.
    """
    if config.get("sprint"):
        return
    options = "\n".join(
        f"    {name:8} {spec.get('cadence_days')} days"
        + (", no sprints" if name == "none" else f", starting {spec['start_day']}")
        for name, spec in SPRINT_TEMPLATES.items()
    )
    sys.exit(
        f"no sprint cadence is configured, and {doing} depends on it.\n"
        f"  Choose one before creating work, so every sprint follows the same "
        f"rhythm:\n\n{options}\n\n"
        f"    gh agile project sprint-template --template 2-week\n\n"
        f"  Or write a `sprint` block into the profile by hand. `none` is a\n"
        f"  legitimate answer for a kanban team, and is recorded as a decision."
    )


def sprint_settings(config: dict) -> dict:
    settings = {**SPRINT_DEFAULTS, **(config.get("sprint") or {})}
    cadence = settings["cadence_days"]
    if isinstance(cadence, str):
        # "2-week" and "2 weeks" are sugar over the number of days GitHub
        # actually stores; Jira offers the enumeration, GitHub does not.
        digits = "".join(c for c in cadence if c.isdigit())
        if not digits:
            sys.exit(f"cadence_days {cadence!r} is not a duration; use days, or '2-week'")
        settings["cadence_days"] = int(digits) * (7 if "week" in cadence.lower() else 1)
    if not 1 <= settings["cadence_days"] <= 30:
        sys.exit(f"cadence_days must be 1..30, not {settings['cadence_days']}")
    if str(settings["start_day"]).lower() not in WEEKDAYS:
        sys.exit(f"start_day must be one of {', '.join(WEEKDAYS)}")
    return settings


def aligned_start(today, start_day: str):
    """The most recent `start_day` on or before today.

    Snapping back rather than forward is what keeps sprints landing on the same
    weekday, and what makes a sprint created mid-week still cover today. Jira
    behaves this way; the alternative drifts the boundary across weekdays until
    no two sprints start on the same one.
    """
    import datetime as dt

    target = (WEEKDAYS[start_day.lower()] - 2) % 7  # GitHub numbering -> Monday=0
    back = (today.weekday() - target) % 7
    return today - dt.timedelta(days=back)


def views_of(login: str, number: int) -> list[dict]:
    """Every view on the project, with its layout and filter.

    Was the fourth place running the two-root walk without catching the
    `SystemExit` it produces -- found the day after the other three, by needing
    it for `board show`. Verified before the change: `views_of("github", 1)`
    reported "Could not resolve to a User with the login of 'github'".
    """
    node = project_node(
        login, number,
        "views(first: 20) { nodes { id number name layout filter } }",
    )
    if node is None:
        sys.exit(f"no project {number} found for {login!r} as either a user or an organization")
    return node["views"]["nodes"]


#: The filter vocabulary `board show` can evaluate, and the only one it will.
#:
#: **`ProjectV2View` has no `items` field.** Introspected 2026-08-24: a view
#: exposes `filter` as an opaque string, plus `layout`, `verticalGroupByFields`
#: and `sortByFields`, and there is no way to ask GitHub what a view displays. So
#: a text board is *reconstructed* from the same inputs the web UI uses, not
#: mirrored from it -- which means the filter has to be evaluated here.
#:
#: Everything `BOARD_TYPES` generates is in this list. A term outside it is
#: **refused, never ignored**: silently dropping `label:key:ZMBNI` would render a
#: board showing another team's work under this team's name, and it would look
#: entirely plausible. Refusing costs the user one message; guessing costs them
#: a decision made on the wrong board.
FILTER_TERMS = {
    "status": "an item's Status field, e.g. status:Done or -status:Done",
    "sprint": "the Sprint field: sprint:@current, or a sprint title",
    "label": "a label on the issue, e.g. label:type:epic",
    "initiative": "everything in an initiative's tree, by slug: "
                  "initiative:large-new-feature",
    "level": "a level of the hierarchy: level:container is an epic or an "
             "initiative",
    "no": "a field that is empty: no:sprint, no:status, no:label",
    "is": "is:open, is:closed, is:issue",
}


def parse_filter(text: str) -> list[tuple[bool, str, str]]:
    """`-status:Done no:sprint` -> [(True, "status", "Done"), (False, "no", "sprint")].

    Quoted values are kept whole, because a status is `"In Progress"` in a view
    filter. Split on the *first* colon only: `label:key:AGILE` is one term whose
    value itself contains a colon.
    """
    import shlex

    out = []
    for token in shlex.split(text or ""):
        negated = token.startswith("-")
        body = token[1:] if negated else token
        key, sep, value = body.partition(":")
        if not sep or not value:
            sys.exit(
                f"cannot read the filter term {token!r}.\n"
                f"  Every term is key:value, optionally negated with a leading '-'.\n"
                f"  Understood: " + ", ".join(sorted(FILTER_TERMS))
            )
        key = key.casefold()
        if key not in FILTER_TERMS:
            listed = "\n".join(f"    {k:<8} {why}" for k, why in sorted(FILTER_TERMS.items()))
            sys.exit(
                f"the filter term {key!r} is not one this tool can evaluate.\n"
                f"  It is refused rather than ignored: a dropped term renders a board that "
                f"looks\n  right and shows the wrong items.\n"
                f"  Understood:\n{listed}\n"
                f"  The board's own filter is whatever the web UI holds; see it with "
                f"`gh agile board list`."
            )
        out.append((negated, key, value))
    return out


def item_matches(item: dict, terms: list[tuple[bool, str, str]],
                 *, current_sprint: str | None) -> bool:
    """Whether one board item satisfies every term. Negation inverts one term.

    `current_sprint` is passed in rather than looked up, so it is read once per
    run and every item is judged against the same answer -- and so this is
    testable without a project.
    """
    content = item.get("content") or {}
    fields = field_values(item)
    labels = {n["name"].casefold() for n in (content.get("labels") or {}).get("nodes", [])}
    status = fields.get("Status")
    sprint = fields.get("Sprint")

    for negated, key, alternatives in terms:
        # **A comma is OR, because that is what GitHub means by one**, and
        # because a board's filter comes *back* from the view it was written
        # to. `github_filter` expands `level:container` to
        # `label:type:initiative,type:epic` so the web UI agrees -- and
        # `board show` then reads that string back and has to understand it.
        # Measured: without this the roadmap it had just written matched 0 of
        # 86 items. A shorthand that expands must also parse on the way home.
        hit = any(matches_one(key, part, content, labels, status, sprint,
                              current_sprint, value=alternatives)
                  for part in alternatives.split(","))
        if hit == negated:
            return False
    return True


def matches_one(key, wanted, content, labels, status, sprint, current_sprint,
                *, value) -> bool:
    """One term against one value. `value` is the whole term, for messages."""
    wanted = wanted.strip().casefold()
    if key == "status":
        hit = same_status(status, wanted)
    elif key == "sprint":
        # `@current` is the first *active* iteration, decided by GitHub
        # returning completed ones separately -- the same rule
        # `resolve_iteration` follows, so a scrum board and `set --value
        # @current` cannot disagree about which sprint is current.
        if wanted in ("@current", "current"):
            hit = bool(sprint) and bool(current_sprint) and sprint == current_sprint
        else:
            hit = bool(sprint) and sprint.casefold() == wanted
    elif key == "label":
        hit = wanted in labels
    elif key == "initiative":
        # Exactly `label:initiative:<slug>`, and a term of its own because
        # `label:initiative:large-new-feature` reads badly and because a term
        # is where the meaning gets documented for `--help`.
        #
        # It works at all only because `initiative reconcile` puts the label
        # on every issue in the tree: a filter cannot traverse the hierarchy,
        # so the label is the only thing an item-at-a-time evaluator can see.
        hit = f"{INITIATIVE_LABEL}{wanted}" in labels
    elif key == "level":
        # **A shorthand for a set of `type:` labels**, following
        # `initiative:` -- a term is where the meaning gets documented, and
        # `github_filter` expands it to something GitHub's own view
        # evaluates the same way. `container` is the one set that has a
        # rule attached to it: the levels that hold work rather than being
        # it, which is what a roadmap shows.
        if wanted == "container":
            hit = bool(labels & {f"type:{t}" for t in CONTAINER_TYPES})
        else:
            hit = f"type:{wanted}" in labels
    elif key == "is":
        state = (content.get("state") or "").casefold()
        kind = content.get("__typename", "")
        hit = {"open": state == "open", "closed": state == "closed",
               "issue": kind == "Issue", "pr": kind == "PullRequest",
               "pullrequest": kind == "PullRequest"}.get(wanted, False)
    elif key == "no":
        hit = {"sprint": not sprint, "status": not status, "label": not labels,
               }.get(wanted)
        if hit is None:
            sys.exit(f"no:{value} is not understood; try no:sprint, no:status or no:label")
    else:                                   # unreachable: parse_filter refused it
        sys.exit(f"unhandled filter term {key!r}")
    return bool(hit)


def resolve_filter_initiatives(config: dict, text: str | None, repo: str | None) -> str | None:
    """Rewrite `initiative:<ref>` to `initiative:<slug>` in a filter the caller typed.

    `--initiative` on `epic` takes an issue number, a keyed reference or a slug,
    and the filter term took only the slug -- so `--filter initiative:35` matched
    the *label* `initiative:35`, which nothing carries, and rendered an empty
    board. **Silently**: a board showing nothing looks exactly like an initiative
    with nothing in it, which is the shape of wrong answer this tool refuses
    unknown filter terms to avoid.

    Only a reference is resolved, so a slug costs no API call. `looks_like_issue_ref`
    is what tells them apart, and it requires the key to be one the profile knows.
    """
    if not text:
        return text
    out = []
    for token in text.split():
        negated = token.startswith("-")
        bare = token[1:] if negated else token
        key, sep, value = bare.partition(":")
        if sep and key.casefold() == "initiative" and looks_like_issue_ref(value, config):
            bare = f"{key}:{initiative_target(config, value, repo)['slug']}"
        out.append(f"-{bare}" if negated else bare)
    return " ".join(out)


def github_filter(text: str) -> str:
    """A filter GitHub's own view can evaluate, from one this tool understands.

    `initiative:<slug>` is exactly `label:initiative:<slug>`, and GitHub knows
    `label:` and does not know `initiative:`. Saving the short form onto a view
    would put the web UI and `board show` into disagreement about what the board
    shows -- which is the one thing a reconstructed board must never do, since the
    whole claim is that it renders *that* definition rather than something
    retyped beside it.

    Only the shorthand is expanded. A term this tool cannot evaluate is still
    refused by `parse_filter` before it reaches here.
    """
    out = []
    for token in text.split():
        negated = token.startswith("-")
        bare = token[1:] if negated else token
        if bare.casefold().startswith(INITIATIVE_LABEL):
            bare = f"label:{bare}"
        elif bare.casefold().startswith("level:"):
            # GitHub knows `label:` and does not know `level:`, and it ORs the
            # comma-separated values of one qualifier. So the shorthand is
            # written out as the labels it stands for, and the web UI shows
            # what `board show` shows -- the whole point of this function.
            wanted = bare.split(":", 1)[1].casefold()
            levels = CONTAINER_TYPES if wanted == "container" else (wanted,)
            bare = "label:" + ",".join(f"type:{level}" for level in levels)
        out.append(f"-{bare}" if negated else bare)
    return " ".join(out)


def make_board(login: str, project: int, name: str, kind: str, extra: str | None) -> dict:
    """Create a board of the given type, or bring an existing one into line.

    Idempotent by name, like every other `setup` step: running it twice leaves
    one board, not two.
    """
    spec = BOARD_TYPES[kind]
    clauses = [spec["filter"]] + ([extra] if extra else [])
    # Expanded before it is written, so the view carries a filter GitHub can
    # evaluate and the web UI shows what `board show` shows.
    combined = github_filter(" ".join(c for c in clauses if c))

    existing = next((v for v in views_of(login, project) if v["name"] == name), None)
    if existing is None:
        created = graphql(
            'mutation($p: ID!, $n: String!) { createProjectV2View(input: {projectId: $p, '
            'name: $n, layout: %s}) { projectV2View { id number } } }' % spec["layout"],
            p=project_id(login, project), n=name,
        )
        view = created["data"]["createProjectV2View"]["projectV2View"]
        action = "created"
    else:
        view, action = existing, "updated"

    # Filter and layout are only settable through update -- the create input
    # takes neither, which is why every board is a create followed by an update.
    graphql(
        'mutation($v: ID!, $f: String!) { updateProjectV2View(input: {viewId: $v, '
        'filter: $f, layout: %s}) { projectV2View { number name filter } } }' % spec["layout"],
        v=view["id"], f=combined,
    )
    return {"number": view["number"], "name": name, "type": kind,
            "filter": combined, "action": action}


def sprint_spans(iters: list[dict]) -> list[tuple]:
    """Each iteration as `(start, end, title)`, with real dates and sorted.

    One function rather than two, because `move` and `sprint backfill` both have
    to answer "which sprint contains this moment" and a board where the live
    stamp and the repair pass disagree is worse than one where neither works.
    """
    import datetime as dt

    spans = []
    for it in iters:
        start = dt.date.fromisoformat(it["startDate"])
        spans.append((start, start + dt.timedelta(days=it["duration"] - 1), it["title"]))
    return sorted(spans)


def sprint_covering(spans: list[tuple], when):
    """The span containing `when`, or `None`. A date in a gap belongs to no sprint.

    Gaps are ordinary -- sprints are created on demand, so a quiet month has
    none -- and nothing here invents one to fill the hole.
    """
    return next((sp for sp in spans if sp[0] <= when <= sp[1]), None)


#: A close that says the work was abandoned rather than finished. GitHub's own
#: value, carried through the export as `state_reason` so the two are
#: distinguishable there too.
ABANDONED = "NOT_PLANNED"


#: The levels above a story: an initiative holds epics, an epic holds stories.
#:
#: **They contain work rather than being it**, and every rule that reads this
#: tuple follows from that one sentence. A container is not placed in a sprint
#: (`cmd_move`), is not estimated in points but tallied by its children
#: (`shows_progress`), is not held by one person (`render_who`, `cmd_validate`),
#: and its status is derived from what it holds (`promote_parents`).
#:
#: **Named for the set, not for the first rule that needed it.** This was
#: `CONTAINER_TYPES` / `container_level`, after the sprint rule that introduced it --
#: and then five more rules read it, of which only three were about sprints. A
#: reader at the tally, the promotion or the assignee check went looking for a
#: sprint that was not there. The sprint reasoning now lives at the sprint call
#: sites, where it is the point rather than a name every other site reads past.
#:
#: The general mistake, worth naming because it is easy to repeat: a set named
#: for the first rule that needed it, then read by six.
#:
#: One tuple, not two. A second list with the same contents drifts.
CONTAINER_TYPES = ("initiative", "epic")


def container_level(labels) -> str | None:
    """The level's name if this issue contains other issues, else None.

    Initiative first: an issue carrying both labels is the higher of the two, and
    the name is used only to say which level a rule is talking about.
    """
    return next((name for name in CONTAINER_TYPES if f"type:{name}" in set(labels)), None)


#: The type a team may use for story-internal housekeeping. POLICY.md §2 still
#: recommends a markdown checklist; this is what a task is called when somebody
#: files one as an issue anyway.
TASK_TYPE = "task"


def sprint_exempt(labels) -> str | None:
    """Why this issue is never placed in a sprint, or None if it belongs in one.

    **Two levels, two different reasons, and the message says which.** A
    container is exempt because it *spans* sprints -- the `Sprint` field holds
    one value and one label cannot say "all of them". A task is exempt because
    the board does not track it at all: it carries no points, sits on no board,
    and is counted by nothing, so putting it in a sprint would add it to a
    velocity nobody meant it to reach.

    One predicate because every caller wants the same answer -- *should this get
    a sprint* -- and a second list is how the two drift apart. Distinct strings
    because a reader told only that something was "skipped" learns nothing about
    which rule applied.
    """
    level = container_level(labels)
    if level:
        return f"{level}, which spans sprints"
    if f"type:{TASK_TYPE}" in set(labels):
        return "task, which the board does not track"
    return None


def issue_labels(repo: str, issue: int) -> list[str]:
    """The issue's label names.

    Its own call because the board read is deliberately lean:
    `LEAN_ITEM_SELECTION` carries an item's id, number, repository and type and
    no labels, and widening it would charge every board-wide read for something
    two transitions need. Asked only where it is needed -- see `cmd_move`.
    """
    data = json.loads(gh(["issue", "view", str(issue), "--repo", repo,
                          "--json", "labels"]))
    return [node["name"] for node in data.get("labels") or []]


def record_sprint_label(args, repo: str, issue_number: int, item_id: str,
                        *, not_planned: bool = False) -> str | None:
    """Stamp the issue with the sprint it is in, as `sprint:YYYY-MM-DD`.

    Called when work starts and again when it closes, so an issue carried across
    a boundary ends up with one label per sprint it lived in -- which the
    `Sprint` field cannot express at all, holding only the latest.

    **The `Sprint` field is not the only source.** It used to be the only one, and
    an issue taken straight from `Todo` to `Done` never passes through the one
    transition that fills it -- so the field was empty, this returned `None`
    silently, and `validate` then reported the state the tool had just created:
    `closed with no sprint: label -- run sprint backfill`. Measured on #72,
    closed the day it was filed. `backfill --source timeline` recovered the right
    answer from a board-wide read a moment later, which is the whole objection:
    the tool held that fact when it mattered and declined to use it. So when the
    field is empty the label is derived from the moment, through the same
    `sprint_covering` the repair pass uses.

    **An abandoned issue is never given a derived label.** The label asserts *the
    sprint this was worked in*, and work closed as `not planned` was worked in
    none -- deriving one would stamp every abandoned issue into whichever sprint
    it was abandoned in and pad that sprint with work nobody did. A label the
    *field* supports is kept either way: a story genuinely worked in Sprint 2 and
    then abandoned really was worked in Sprint 2.
    """
    if not sprint_settings(args._config).get("record_label", True):
        return None
    active, completed = iterations(args.owner, args.project)
    assigned = sprint_assignments(args.owner, args.project).get(item_id)
    match = next((i for i in active + completed if i["title"] == assigned), None)

    derived = match is None
    if derived:
        if not_planned:
            return None
        span = sprint_covering(sprint_spans(active + completed), today_utc())
        if span is None:
            return None
        start = span[0].isoformat()
    else:
        start = match["startDate"]

    issue = json.loads(gh(["issue", "view", str(issue_number), "--repo", repo,
                           "--json", "labels,stateReason"]))
    # The flag covers the close this run is performing; `stateReason` covers one
    # performed earlier, in the web UI or by an older run. Either is an answer to
    # "was this abandoned", and only a derived label has to ask.
    if derived and (issue.get("stateReason") or "").upper() == ABANDONED:
        return None
    label = f"{SPRINT_LABEL}{start}"
    if label in {lb["name"] for lb in issue["labels"]}:
        return None
    ensure_labels(repo, [label])
    gh(["issue", "edit", str(issue_number), "--repo", repo, "--add-label", label])
    return label


def adopt_issue(args, repo: str, issue: dict, item_id: str) -> None:
    """Give an issue created outside this tool the parts a machine can supply.

    An issue opened in the web UI, by a bot, or with `gh issue create` arrives
    with none of the convention: no `key:` label, and a project item whose Status
    is empty, which puts it in no column of any board.

    Two of the three gaps are mechanical and filled here. The **type is not**:
    nothing in an issue reliably distinguishes an epic from a story from a bug,
    and guessing writes a wrong `type:` label that later reads as a deliberate
    one. `gh agile validate` reports it as missing and a person decides --
    POLICY.md's line between what a machine may infer and what it may not.
    """
    labels = {lbl["name"] for lbl in issue.get("labels", [])}
    keys = keys_for_repo(args._config, repo)
    key = keys[0] if keys else None
    if key:
        label = f"{KEY_LABEL}{key}"
        if label not in labels:
            ensure_labels(repo, [label])
            gh(["issue", "edit", str(issue["number"]), "--repo", repo, "--add-label", label])
            print(f"    + {label}")

    # The title convention applies to issues however they arrived. Without this,
    # `project.issue_title_prefix` held only for issues this tool created, so a
    # board filled partly from the web UI had two naming schemes and the
    # identifier people say out loud was missing from exactly the issues nobody
    # had curated.
    mode = title_prefix_mode(args._config)
    if mode != "off" and key and not issue["title"].startswith(f"{key}-"):
        # `key+type` needs a type, and adopt deliberately does not guess one. If
        # the issue already carries a type: label, use it; otherwise fall back
        # to the key-only form, which is the part that identifies the issue.
        # Better a correct short prefix than an invented type.
        kind = next((lb[len("type:"):] for lb in labels if lb.startswith("type:")), None)
        effective = mode if (mode == "key" or kind) else "key"
        new_title = prefixed_title(effective, key, issue["number"], kind or "", issue["title"])
        gh(["issue", "edit", str(issue["number"]), "--repo", repo, "--title", new_title])
        print(f"    + title: {new_title}")
    # Status only when it is empty: an item already in a column has been placed
    # by somebody, and Todo would move their work backwards. The item is read by
    # id rather than by listing the project -- a full listing per adopted issue
    # is what turns a sync of twenty into twenty board reads. (That was written
    # when the GraphQL budget was the constraint that bit first. Since the board
    # readers were made ~100x cheaper it is REST that runs out, and reading one
    # item by id is still the right shape either way -- see docs/lessons.md.)
    data = graphql(
        "query($id: ID!) { node(id: $id) { ... on ProjectV2Item { "
        'fieldValueByName(name: "Status") { '
        "... on ProjectV2ItemFieldSingleSelectValue { name } } } } }",
        id=item_id,
    )
    value = ((data.get("data") or {}).get("node") or {}).get("fieldValueByName")
    if not (value or {}).get("name"):
        # By the issue's own state, not always Todo. `sync --adopt --state all`
        # put closed issues in Todo, and `validate` then reported "closed but
        # status is not Done" -- the tool manufacturing the violation it
        # detects.
        status = CYCLE_END if issue.get("state", "").upper() == "CLOSED" else "Todo"
        set_field(args.owner, args.project, item_id, "Status", status)
        print(f"    + Status = {status}")


#: How many issues `--adopt` will write to before it asks.
#:
#: `--adopt` is the one sync path that writes to the **issues** and not only to
#: the board: it applies a `key:` label to each and, with a title prefix
#: configured, renames it. It has already swept a whole live repository once --
#: `sync --adopt --state all` put every issue there onto a scratch project and
#: labelled all of them, which is recorded in docs/lessons.md. Labels are
#: additive and a rename is not.
#:
#: Ten, so that adopting a handful never asks and a repository-wide sweep always
#: does. The tool already refuses before less consequential acts --
#: `require_graphql_budget` before an iteration write, the Makefile's title check
#: before a teardown -- and this was the loudest thing with no gate at all.
ADOPT_CONFIRM_ABOVE = 10


def report_tasks_skipped(count: int) -> None:
    """Say how many tasks a sweep left off the board, and how to reach them.

    Silence would be indistinguishable from a repository that has no tasks in
    it, and the difference matters: one is nothing to do and the other is a
    deliberate exclusion somebody may want to override.
    """
    if count:
        print(f"  {count} task(s) left off the board; a task is story-internal. "
              f"To board them anyway:\n"
              f"    gh agile sync --query \"label:type:{TASK_TYPE}\"")


def cmd_sync(args) -> int:
    """Add issues that belong on the board and are not on it.

    Needed because **a project is a collection, not a filter** -- see the user
    guide. Additive only: an item is never removed, because removing it discards
    that item's Status, Points and Sprint, which live on the project item rather
    than on the issue.
    """
    config = args._config
    repos = [args.repo] if args.repo else sorted(
        {e["repo"] for e in profile_keys(config) if e.get("repo")}
    )
    if not repos:
        sys.exit("no repositories: pass --repo, or list keys in the profile")

    on_board = {
        (i["content"].get("repository"), i["content"].get("number"))
        for i in board_items(args.owner, args.project)
        if i.get("content")
    }
    # Compared on the trailing name rather than `owner/name` because `gh`
    # versions disagree: 2.86 reports `owner/name` in `content.repository`,
    # older ones reported a bare name. That leaves this loose -- two
    # repositories with the same name under different owners look identical
    # here -- which is tolerable for "is it already on the board" (the wrong
    # answer only skips an add) and is *not* tolerable for choosing an item to
    # write to, so `same_repo` compares the owner too whenever both sides have
    # one.
    numbers_on_board = {
        (str(repo).rsplit("/", 1)[-1] if repo else None, number)
        for repo, number in on_board
    }

    # Every candidate is collected before anything is written, so the count is
    # known while it can still be refused.
    candidates: list[tuple[str, dict]] = []
    skipped = tasks = 0
    for repo in repos:
        cmd = ["issue", "list", "--repo", repo, "--state", args.state,
               "--limit", str(args.limit), "--json", "number,title,url,state,labels"]
        if args.query:
            cmd += ["--search", args.query]
        for issue in json.loads(gh(cmd)):
            key = (repo.rsplit("/", 1)[-1], issue["number"])
            if key in numbers_on_board:
                skipped += 1
                continue
            # **A task is not boarded, and this is where that is true or not.**
            # `task` adds nothing to the project, but `sync` sweeps the whole
            # repository, so without this one run puts every task on the board
            # and the default quietly becomes the opposite of what POLICY.md
            # says. `--query "label:type:task"` still reaches them for a team
            # that wants them there: excluded by default, not excluded outright.
            names = {lb["name"] for lb in issue.get("labels") or []}
            if f"type:{TASK_TYPE}" in names and not args.query:
                tasks += 1
                continue
            candidates.append((repo, issue))

    if args.dry_run:
        for repo, issue in candidates:
            print(f"  would add {repo}#{issue['number']}  {issue['title'][:52]}")
        print(f"  would add {len(candidates)}, already present {skipped}, "
              f"across {len(repos)} repo(s)")
        report_tasks_skipped(tasks)
        return 0

    if args.adopt and len(candidates) > ADOPT_CONFIRM_ABOVE and not args.yes:
        sample = "\n".join(f"    {repo}#{issue['number']}  {issue['title'][:52]}"
                           for repo, issue in candidates[:5])
        more = f"\n    ... and {len(candidates) - 5} more" if len(candidates) > 5 else ""
        sys.exit(
            f"--adopt would write to {len(candidates)} issues, past the "
            f"{ADOPT_CONFIRM_ABOVE} this asks about:\n{sample}{more}\n"
            f"  Each gets a `{KEY_LABEL}` label, and is renamed if a title prefix is "
            f"configured.\n"
            f"  See the whole list:   gh agile sync --adopt --dry-run\n"
            f"  Then, if it is right: add --yes"
        )

    added = 0
    for repo, issue in candidates:
        item = json.loads(gh(["project", "item-add", str(args.project), "--owner",
                              args.owner, "--url", issue["url"], "--format", "json"]))
        print(f"  added {repo}#{issue['number']}  {issue['title'][:52]}")
        if args.adopt:
            adopt_issue(args, repo, issue, item["id"])
        added += 1

    print(f"  added {added}, already present {skipped}, across {len(repos)} repo(s)")
    report_tasks_skipped(tasks)
    return 0


#: How each layout is grouped into sections in the text view. The layout comes
#: from the view itself, not from the profile's board type, because the layout is
#: what the web UI actually renders and a view can be changed there.
LAYOUT_SECTIONS = {
    "BOARD_LAYOUT": "status",     # columns in the web UI, sections here
    "TABLE_LAYOUT": None,         # one flat table, as the web UI shows it
    # **Was `sprint`, and #115 made that degenerate.** It was chosen as "the
    # nearest text analogue of a timeline" when an epic could carry a sprint.
    # Since a container is guaranteed to have none, every epic landed in one
    # `(no sprint)` bucket -- measured on project #4, nine of ten. A timeline
    # with no time in it. `start` groups by when the work under an epic actually
    # began, derived from the `sprint:` labels of its descendants.
    "ROADMAP_LAYOUT": "start",
}


def board_row(item: dict, keys: dict[str, str]) -> dict:
    """One item, flattened to what both output formats need."""
    content = item.get("content") or {}
    fields = field_values(item)
    labels = [n["name"] for n in (content.get("labels") or {}).get("nodes", [])]
    repo = (content.get("repository") or {}).get("nameWithOwner")
    labelled = next((lb[len(KEY_LABEL):] for lb in labels if lb.startswith(KEY_LABEL)), None)
    # Story Points stays exactly as GitHub typed it -- a float, because the field
    # is NUMBER and fractional estimates are a legitimate team choice (0.5 for
    # trivial work). Whole numbers are *displayed* without the `.0` by
    # `render_points`, and that is a display concern: normalising here put `8` and
    # `0.5` in the same JSONL column, so a loader inferring the type from early
    # rows would call it an integer and then truncate the first half-point.
    return {
        "key": f"{labelled}-{content['number']}" if labelled
               else issue_key(repo, content["number"], keys),
        "number": content["number"],
        "repository": repo,
        "title": content.get("title") or "",
        "url": content.get("url") or "",
        "type": next((lb.split(":", 1)[1] for lb in labels
                      if lb.startswith("type:")), None),
        "status": fields.get("Status"),
        "story_points": fields.get("Story Points"),
        "sprint": fields.get("Sprint"),
        "labels": labels,
        "assignees": [n["login"] for n in (content.get("assignees") or {}).get("nodes", [])],
        # **The same builder the export rows use, rather than a second one that
        # can disagree with it.** This line was `content.parent.number`, which is
        # the pre-#90 defect still living here: the parent's number *whatever the
        # parent was*, so an epic under an initiative reported an initiative in a
        # column called `epic_number`, with nothing saying so. Harmless while
        # nothing could be a parent but an epic; wrong since #85 built the level
        # above.
        #
        # It also gives a row the parent's **key** rather than a bare number.
        # GitHub numbers issues per repository, so a board spanning repositories
        # has two `#12`; a number cannot name a parent and a key can. Nothing can
        # be ordered into a tree until a row can say whose child it is.
        **parent_columns(content.get("parent"), keys),
        # Already fetched by `FULL_ITEM_SELECTION`, and simply never carried
        # through -- so the tally in the `pts` column costs no extra call. Both
        # land in the JSONL rendering too, which splats this row, so a reader
        # gets the numbers rather than having to parse "3/6".
        "sub_issues_total": (content.get("subIssuesSummary") or {}).get("total") or 0,
        "sub_issues_done": (content.get("subIssuesSummary") or {}).get("completed") or 0,
        "state": content.get("state"),
    }


def status_excluded(name: str, terms: list[tuple[bool, str, str]]) -> bool:
    """Whether the filter makes this status impossible, rather than merely absent.

    `-status:Done` on a kanban board does not leave Done *empty*, it leaves Done
    *out*, and reporting "empty: Done" would say the sprint finished nothing when
    the board was never asked. Empty and excluded are different facts and the
    display must not merge them.
    """
    for negated, key, value in terms:
        if key == "status":
            if negated and same_status(name, value):
                return True
            if not negated and not same_status(name, value):
                return True
        elif key == "no" and value.casefold() == "status":
            return True
    return False


def key_cell(row: dict) -> str:
    """The key column's text: the indent, the key, and the stale mark.

    One function because `board_columns` measures this and `render_board` prints
    it, and #118 found what happens when those two compute a cell separately --
    a band whose `type` cell was measured from the rows overflowed and pushed
    every line out of alignment. Measured once, printed once.
    """
    return (" " * row.get("depth", 0) + row["key"]
            + (STALE_MARK if stale_status(row) else ""))


#: What the roadmap's sections say when an epic's work has not begun.
NOT_STARTED = "(not started)"


def derive_starts(issues: list[dict], rows: list[dict], keys: dict,
                  by_start: dict[str, str]) -> None:
    """Set `started_in` on each row: when the work under it actually began.

    **A roadmap is a WBS report, and its axis is when work started -- normally
    the planned order, and sometimes not, because plans get rearranged as work
    arrives.** So the order is derived from what happened rather than from what
    was intended, and an epic that was planned third and started first appears
    first.

    **First story started, read from the `sprint:` labels.** Those are the
    immutable record of the sprint a piece of work was *worked in* -- the whole
    reason they exist -- so the earliest label anywhere under an epic is when
    that epic began. Read from labels rather than from the Status timeline
    because the labels are already in hand: `fetch_items` returns the whole
    board, so an epic's children are here even when the filter shows only epics,
    and the timeline would be one query per issue.

    Sprint granularity is the right granularity. A roadmap answers *which
    fortnight did this begin in*, not which afternoon, and the labels are dated
    by sprint start for exactly that reason.

    Descendants, not direct children: an initiative's work begins when the first
    story under any of its epics begins, and a level in between must not hide it.

    A date the sprint configuration no longer covers is shown as the date rather
    than resolved to a neighbour -- **never invent a sprint**, the same rule
    `reconcile_sprints` follows when a label names one that is gone.
    """
    by_key: dict[str, list[dict]] = {}
    for item in issues:
        content = item.get("content") or {}
        if content.get("__typename") != "Issue":
            continue
        row = board_row(item, keys)
        by_key.setdefault(row.get("parent_key") or "", []).append(row)

    def earliest(key: str, seen: set) -> str | None:
        if key in seen:
            return None          # a malformed board must not hang a read
        seen.add(key)
        found = []
        for child in by_key.get(key, ()):
            stamps = [lb[len(SPRINT_LABEL):] for lb in child.get("labels") or []
                      if lb.startswith(SPRINT_LABEL)]
            found += stamps
            below = earliest(child["key"], seen)
            if below:
                found.append(below)
        return min(found) if found else None

    for row in rows:
        # The row's own labels count too: an epic worked on directly carries
        # them, and #123 cleared only the strays written before the rule.
        own = [lb[len(SPRINT_LABEL):] for lb in row.get("labels") or []
               if lb.startswith(SPRINT_LABEL)]
        below = earliest(row["key"], set())
        dates = own + ([below] if below else [])
        start = min(dates) if dates else None
        row["started_in"] = by_start.get(start, start) if start else NOT_STARTED
        # The date as well as the sprint's name, and both public: a JSONL reader
        # gets the chronology without parsing a section heading, and the heading
        # gets it without the reader having to know the sprint series.
        row["started_on"] = start or ""


def flat(rows: list[dict]) -> list[dict]:
    """Rows with `depth` set to 0: nothing here is indented.

    A grouped board separates a parent from its children, so it shows no tree
    and indents nothing -- and `depth` is a rendering property, so 0 is the
    truth about the rendering rather than a claim about the issue. Set rather
    than left absent so the JSONL field is always present and always an integer.
    """
    for row in rows:
        row["depth"] = 0
    return rows


def hierarchy_order(rows: list[dict]) -> list[dict]:
    """Rows as a forest: each root followed by its descendants, depth-first.

    **The value is the ordering; the indent only makes it visible.** Indentation
    alone would duplicate the `type` column, which already says what level a row
    is. What `type` cannot say is *which parent*, and that is the thing a reader
    was rebuilding by hand -- an initiative, its epics and their stories
    interleaved with unrelated work in issue-number order.

    **Roots, then the rest.** A child whose parent the filter excluded is a root
    rather than an orphan indented under nothing: the tree shown is the tree
    present, not the tree that exists. Work belonging to no tree at all -- a
    standalone bug, an orphan story -- is listed after the trees rather than
    interleaved with them, so the structured work reads first and the remainder
    reads as the remainder.

    Siblings by `(repository, number)`, which is the order this branch already
    used: a board may span repositories and two `#12` on one board is ordinary.

    `depth` is set on each row and is a **rendering** property -- how far this
    row is indented here -- not a claim about the hierarchy. On a grouped board
    nothing is indented and every row is 0, which is true of the rendering and
    says nothing about the issue. The row dicts are the same objects
    `render_board` and `board_columns` read, which is how the indent reaches the
    width measurement.
    """
    def order(row):
        return (str(row.get("repository") or ""), row["number"])

    by_key = {row["key"]: row for row in rows if row.get("key")}
    children: dict[str, list[dict]] = {}
    for row in rows:
        parent = row.get("parent_key")
        if parent and parent in by_key and parent != row.get("key"):
            children.setdefault(parent, []).append(row)
    for kids in children.values():
        kids.sort(key=order)

    roots = [row for row in rows
             if not (row.get("parent_key") and row["parent_key"] in by_key)]
    out: list[dict] = []
    seen: set[int] = set()

    def walk(row, depth):
        # A cycle cannot arise through GitHub's own sub-issue edges, but a read
        # must not hang on a board that has one somehow.
        if id(row) in seen:
            return
        seen.add(id(row))
        row["depth"] = depth
        out.append(row)
        for kid in children.get(row["key"], ()):
            walk(kid, depth + 1)

    for root in sorted((r for r in roots if children.get(r["key"])), key=order):
        walk(root, 0)
    for row in sorted((r for r in roots if not children.get(r["key"])), key=order):
        walk(row, 0)
    # Anything the walk could not reach -- a cycle with no root among the shown
    # rows -- keeps its place rather than vanishing. A row the ordering cannot
    # place must still be shown; dropping it would be a board quietly narrower
    # than its filter.
    for row in sorted((r for r in rows if id(r) not in seen), key=order):
        walk(row, 0)
    return out


def board_sections(rows: list[dict], grouping: str | None, sprint_order: list[str],
                   terms: list[tuple[bool, str, str]]) -> list[tuple[str, list[dict]]]:
    """`[(section name, rows)]` in the order the section should be printed.

    Sections the filter allows are returned even when empty, because "In Review is
    empty" is information a board exists to convey; the display collapses those
    onto one line. Sections the filter *excludes* are dropped -- see
    `status_excluded`.
    """
    if grouping is None:
        # **The one layout where a tree can be shown together.** A status-grouped
        # board separates a parent from its children by construction -- an epic
        # in `In Progress` while its stories are spread over `Todo`, `In Review`
        # and `Done` -- so indenting inside a section would put children under a
        # parent that is not there. `TABLE_LAYOUT` is one flat table, which is
        # Backlog and View 1, and is also how an `initiative:` filter is read.
        return [("", hierarchy_order(rows))]
    if grouping == "status":
        buckets = {s: [] for s in STATUSES if not status_excluded(s, terms)}
        for row in rows:
            match = next((s for s in STATUSES if same_status(row["status"], s)), None)
            # A status this tool does not know still gets its own section, under
            # the name the board actually holds. Someone can add a column in the
            # web UI, and folding "Icebox" into "(no status)" would report the
            # work as unplaced when it is placed somewhere we simply have no
            # policy for. `(no status)` is reserved for genuinely unset, which is
            # what `validate` reports on.
            buckets.setdefault(match or row["status"] or "(no status)", []).append(row)
        return [(name, flat(sorted(items, key=lambda r: r["number"])))
                for name, items in buckets.items()]
    if grouping == "start":
        # **A WBS report's axis: when work began, not when it was planned.**
        # Sections in the order the work actually started, which is normally the
        # planned order and sometimes is not -- plans get rearranged as work
        # arrives, and an epic planned third but started first belongs first.
        #
        # Ordered by the underlying date rather than by the section's name: a
        # sprint title sorts by its spelling, and `0004 W38-2026` beside
        # `AGILE Sprint 4` would sort alphabetically into nonsense. Not started
        # last, because it has no place on a timeline and is the remainder.
        buckets: dict[str, list[dict]] = {}
        for row in rows:
            buckets.setdefault(row.get("started_in") or NOT_STARTED, []).append(row)

        def when(name):
            if name == NOT_STARTED:
                return ("\uffff", "")
            return (min(r.get("started_on") or "" for r in buckets[name]), name)

        def heading(name):
            # **The name does not order the section; the date does.** This board
            # reads `AGILE Sprint 4`, `Sprint 1`, `Sprint 2`, `Sprint 3` -- and
            # `AGILE Sprint 4` ran *first*, two weeks before `Sprint 1`, because
            # a sprint is never renamed and each name says what it was called
            # when it ran. A reader seeing `AGILE Sprint 4` above `Sprint 2` and
            # concluding the sort is broken is reading the only thing the
            # heading gave them. So the heading carries the date it is sorted on.
            if name == NOT_STARTED:
                return name
            began = min(r.get("started_on") or "" for r in buckets[name])
            return name if name == began else f"{name} · from {began}"

        # **A tree, not a flat list, and the objection to indenting elsewhere
        # does not apply here.** A status-grouped board separates a parent from
        # its children by construction; this one groups by when work began, and
        # an initiative is dated by the earliest start among its epics -- so a
        # parent and the child that dated it land in the same section, which is
        # where the tree can honestly be drawn.
        #
        # An epic that started in a later section appears there at the top
        # level, under no repeated parent: the initiative is stated once, in
        # the section its work began in. Every row in a section shares one
        # `started_on` -- it is the sprint's start date -- so the ordering
        # inside it is `hierarchy_order`'s, by repository and number, which is
        # the tiebreak this branch already used.
        return [(heading(name), hierarchy_order(buckets[name]))
                for name in sorted(buckets, key=when)]

    # sprint: known sprints in configuration order, then the unassigned.
    buckets = {name: [] for name in sprint_order}
    for row in rows:
        buckets.setdefault(row["sprint"] or "(no sprint)", []).append(row)
    return [(name, flat(sorted(items, key=lambda r: r["number"])))
            for name, items in buckets.items()]


def render_points(points) -> str:
    """`8.0` -> `8`, `0.5` -> `0.5`, absent -> an em dash.

    GitHub stores a NUMBER field as a float, so every whole estimate arrives as
    `8.0`, and a board column reading "8.0" claims a decimal place the estimate
    does not have. Fractional points are left alone: half-points for trivial work
    are a real convention, and the tool takes no view on a team's scale.
    """
    if points in (None, ""):
        return "—"
    if isinstance(points, float) and points.is_integer():
        return str(int(points))
    return str(points)


#: The width every board falls back to: a pipe, a file, and any terminal that
#: will not say how wide it is.
#:
#: Fixed rather than "as wide as it gets", because `--out-dir` writes a file and
#: `make check-guide` diffs command output: a rendering whose line lengths depend
#: on the window that produced it is a file that changes when nothing changed.
BOARD_WIDTH = 80

#: Below this the title column stops giving ground. A very narrow terminal wraps
#: instead, which is legible; a title elided to six characters is not.
MIN_TITLE_WIDTH = 20


def display_width(stream=None) -> int:
    """How wide to render, in columns: the terminal's width, or `BOARD_WIDTH`.

    The `isatty` check comes first and `shutil.get_terminal_size` second, because
    that function consults `$COLUMNS` before it asks the device and will hand back
    a person's window size for a run that is writing to a file. Redirected output
    must not depend on the shell that launched it.
    """
    stream = sys.stdout if stream is None else stream
    try:
        if not stream.isatty():
            return BOARD_WIDTH
    except (AttributeError, ValueError):   # a closed or substituted stream
        return BOARD_WIDTH
    return shutil.get_terminal_size((BOARD_WIDTH, 24)).columns


#: What the `who` column says when an issue is in progress and nobody has it.
#:
#: A word rather than a symbol. The empty marker is `—`, which reads as *nothing
#: here* and is exactly what a reader skims past -- and this is the one cell on a
#: standup board worth stopping at. `validate` reports the same state as
#: `In Progress but unassigned`; this is the fast path to the same finding, on the
#: board a team actually reads aloud.
NOBODY = "nobody"

#: Ten characters of a login is enough to know who. Two people sharing a
#: ten-character prefix is not a team anybody has, and this column is paid for
#: out of the title, which is the part a person actually reads.
#:
#: Two people on one issue shows the first and a count: a standup asks *who is
#: driving this*, and the second name does not change the answer.
WHO_WIDTH = 10

#: The sprint column, capped hard. A sprint name is a label on a column, not a
#: sentence.
#:
#: **This only works on a name whose distinguishing part comes first.**
#: `AGILE Sprint 4` truncates to `AGILE S…` and loses the number, which is the
#: one thing that matters -- so the cap and `SPRINT_DEFAULTS["name_template"]`
#: are one decision, not two. `0004 W38-2026` truncates to `0004 W3…`: the
#: number leads, the week is the human anchor, and the year is there to sort by
#: rather than to read.
SPRINT_WIDTH = 8


def render_who(row: dict) -> str:
    """The `who` column: who has this, or that nobody does and it matters.

    An unassigned `Todo` is the ordinary state of a backlog -- flagging it would
    mark nearly every row and teach people to ignore the column. Only work that
    has *started* with nobody on it is called out, which is the same rule
    `validate` applies and the same one `move` maintains.
    """
    who = [name for name in (row.get("assignees") or []) if name]
    if not who and row.get("type") in CONTAINER_TYPES:
        # `nobody` is a call to action -- it means *this should have someone*.
        # An epic holds work done by several people and is not meant to have one
        # holder, so the empty marker is the honest cell: nothing is missing.
        return "—"
    if who:
        # A login, or the local part of one shaped like an address: the domain is
        # the same for everyone on the board and says nothing about who has this.
        first = who[0].split("@", 1)[0]
        extra = f" +{len(who) - 1}" if len(who) > 1 else ""
        return elide(first, max(WHO_WIDTH - len(extra), 1)) + extra
    return NOBODY if same_status(row.get("status"), CYCLE_START) else "—"


def shows_progress(row: dict) -> bool:
    """Whether this row's `pts` cell should carry a child tally instead.

    **The two levels above a story, and only those.** GitHub's sub-issues nest
    anywhere, so a story may carry a task list -- and this tool has never used
    that concept: `story` creates no children, nothing counts them, and the Gold
    model has no grain for them. Tallying one here would put a progress figure on
    a row whose children the rest of the tool ignores, and it would contradict
    the legend, which says *for epics and initiatives* because that is what a
    reader can act on.

    `CONTAINER_TYPES` rather than a second list. The same two levels span sprints
    and carry a tally, and they do so for one underlying reason -- they contain
    work rather than being it. Two lists with the same contents drift; this one
    does not.

    A tally needs children to count, so a parent with none keeps its em dash:
    `0/0` asserts a denominator that does not exist.
    """
    return row.get("type") in CONTAINER_TYPES and bool(row.get("sub_issues_total"))


def render_progress(row: dict) -> str:
    """The `pts` cell: story points, or `closed/total` children where there are none.

    **`closed`, never `done`.** `subIssuesSummary.completed` is GitHub's name for
    the count of *closed* children and includes those closed as `NOT_PLANNED` --
    measured on `#9`, six of seven with one abandoned. Abandoned is not
    completed, so reading this as "done" asserts something false about that row.
    What is true, and what a parent is actually waiting on, is how many are still
    open.

    **Per level, not transitively.** `subIssuesSummary` counts direct children,
    so an initiative tallies its epics and an epic tallies its stories. Measured:
    closing a story took its epic to 1/1 while the initiative stayed 0/1. A
    number reaching the whole tree is one nobody could reconcile with the board.
    """
    if shows_progress(row):
        return f"{row.get('sub_issues_done') or 0}/{row['sub_issues_total']}"
    return render_points(row.get("story_points"))


#: Marks a row whose issue is closed while its Status has not caught up.
#:
#: A footnote rather than a column. The condition is rare, and a column costs
#: every board its width whether or not anything is stale -- the mistake the
#: `who` column avoids by disappearing. One character beside the key is visible
#: when scanning a column of keys, and the line under the board says what it
#: means and how to fix it.
STALE_MARK = "*"


def stale_status(row: dict) -> bool:
    """Whether this row is finished work still sitting in a live column.

    A board filter reads the `Status` **field** and never looks at the issue's
    state, so a closed issue whose Status is still `In Progress` passes
    `-status:Done` and lands in the In Progress column -- **indistinguishable
    from work somebody is doing**. Measured; and observed on `#123`, which sat
    there for twenty-two hours after the work was finished.

    The cause is a `Closes #n` automation, which sets the issue's state and
    nothing else. `move --status Done --close` cannot produce it.
    """
    return row.get("state") == "CLOSED" and not same_status(row.get("status"), CYCLE_END)


def board_columns(rows: list[dict], width: int,
                  containers: list[dict] | None = None) -> dict[str, int]:
    """Column widths for the text view: the widest value, and the heading it carries.

    Measured across every row rather than per section, so the columns line up
    down the whole board and under one heading -- per-section widths staggered
    the sections against each other and left the heading true of the first only.
    """
    def widest(heading, values):
        return max([len(heading)] + [len(v) for v in values])

    # **The band is measured with the table, not beside it.** Its first three
    # cells reuse these widths so the two grids read as one, which only works if
    # both are counted: a band naming an `initiative` against rows that are all
    # `story` overflowed the type cell and pushed every band line out of
    # alignment with the table under it. Measured, on this board.
    band = containers or []
    key = widest("key", [key_cell(r) for r in rows] + [c["key"] for c in band])
    kind = widest("type", [r["type"] or "?" for r in rows]
                          + [c["type"] for c in band])
    # Measured from what is actually printed, not from the points alone: `3/6` is
    # wider than any estimate on most boards, and a cell rendered outside this
    # measurement pushes every row past the width the layout was chosen to fit.
    points = widest("pts", [render_progress(r) for r in rows]
                           + [c["progress"] for c in band])
    sprint = min(widest("sprint", [r["sprint"] or "—" for r in rows]), SPRINT_WIDTH)
    # **The `who` column appears only when it has something to say.** A backlog is
    # all `Todo` and nobody holds any of it, so the column would be fourteen
    # characters of `—` taken from the title -- and the title is what a person
    # reads. A width of 0 is the signal, and `board_line` drops the column and its
    # separator with it.
    #
    # Adaptive presence rather than adaptive *meaning*: the column says the same
    # thing wherever it appears. Widths here are already measured from the data,
    # so this is the same idea one step further.
    shown = [render_who(r) for r in rows]
    who = widest("who", shown) if any(w != "—" for w in shown) else 0
    spent = 2 + key + 2 + kind + 2 + points + 2 + sprint + 2 + (who + 2 if who else 0)
    return {"key": key, "type": kind, "points": points, "sprint": sprint, "who": who,
            "title": max(width - spent, MIN_TITLE_WIDTH)}


def board_line(values: dict[str, str], columns: dict[str, int]) -> str:
    """One row, or the heading: the same columns either way.

    `who` is dropped, separator and all, when its width is 0 -- see
    `board_columns` for why a board that has nothing to say about it says nothing.
    """
    who = f"{values['who']:<{columns['who']}}  " if columns["who"] else ""
    return (f"  {values['key']:<{columns['key']}}  {values['type']:<{columns['type']}}  "
            f"{values['points']:>{columns['points']}}  "
            f"{values['sprint']:<{columns['sprint']}}  {who}{values['title']}")


def elide(text: str, width: int) -> str:
    """`text` in at most `width` columns, with `…` standing for what was cut."""
    if len(text) <= width:
        return text
    return text[:width - 1].rstrip() + "…"


def board_containers(issues: list[dict], shown: list[dict], keys: dict) -> list[dict]:
    """The initiatives and epics the displayed work belongs to.

    **Derived from the sprint's own contents, not from the containers' status.**
    The parents of the items the filter selected, walked upward. It cannot go
    stale, it needs no epic status maintained to be correct, and it answers the
    question a sprint board exists to answer -- *what larger work is this sprint
    advancing*. Keying it off `In Progress` instead would list containers with
    nothing in this sprint and miss one whose status nobody had updated.

    **Costs no extra call.** `fetch_items` returns the whole board and the filter
    is applied afterwards, so a parent excluded from the rows is still in
    `issues` -- with its own `subIssuesSummary`, which is where the tally comes
    from. The chain is walked through that index rather than by asking GitHub
    again.

    A parent that is not on the board at all is still named, from the child's own
    `parent` snippet, with no tally. Dropping it would understate what the sprint
    advances, and *empty is not excluded* is the rule this board already follows.

    Initiatives first, then epics: the band reads down the hierarchy.
    """
    index = {}
    for item in issues:
        content = item.get("content") or {}
        repo = (content.get("repository") or {}).get("nameWithOwner")
        index[(repo, content.get("number"))] = item

    found: dict[tuple, dict] = {}
    for item in shown:
        parent = (item.get("content") or {}).get("parent")
        seen = set()
        while parent:
            repo = (parent.get("repository") or {}).get("nameWithOwner")
            ref = (repo, parent.get("number"))
            # A cycle is not possible through GitHub's own sub-issue edges, but
            # the walk is cheap to make safe and a malformed board should not
            # hang a read.
            if ref in seen:
                break
            seen.add(ref)
            labels = [n["name"] for n in (parent.get("labels") or {}).get("nodes") or []]
            level = container_level(labels)
            if not level:
                break
            if ref not in found:
                on_board = index.get(ref)
                row = board_row(on_board, keys) if on_board else None
                found[ref] = {
                    "key": row["key"] if row else key_for_issue(
                        parent["number"], repo, labels, keys),
                    "type": level,
                    "title": (row["title"] if row else parent.get("title")) or "",
                    "progress": render_progress(row) if row else "—",
                }
            nxt = index.get(ref)
            parent = (nxt.get("content") or {}).get("parent") if nxt else None

    return sorted(found.values(),
                  key=lambda c: (c["type"] != "initiative", c["key"]))


#: What the band says it is. Spelled out because the band breaks the rule the
#: rest of the board keeps: a board here is *reconstructed from its filter*, and
#: a term outside `FILTER_TERMS` is refused rather than ignored, precisely so a
#: board cannot quietly show the wrong set. These rows are the deliberate
#: exception -- items the filter excludes -- so they are labelled as derived and
#: kept out of the table rather than merged into it, where they would read as
#: something the filter selected.
BAND_HEADING = "advancing (derived from the work below, not selected by the filter):"


def render_band(containers: list[dict], columns: dict[str, int], width: int) -> list[str]:
    """The context band: one line per container, aligned to the table below it.

    The first three columns reuse the table's own widths, so the band reads as a
    continuation of the same grid rather than a second one. There is no `sprint`
    or `who` cell: a container is in no sprint by construction (#115) and is held
    by nobody by design (#117), so both would be a column of em dashes.

    Wrapped, not elided, for the reason the title column wraps: losing the tail
    of a name loses the half that says what the work is.
    """
    if not containers:
        return []
    lead = 2 + columns["key"] + 2 + columns["type"] + 2 + columns["points"] + 2
    text = max(width - lead, MIN_TITLE_WIDTH)
    out = [BAND_HEADING]
    for container in containers:
        lines = textwrap.wrap(container["title"], text) or [""]
        out.append(
            f"  {container['key']:<{columns['key']}}  "
            f"{container['type']:<{columns['type']}}  "
            f"{container['progress']:>{columns['points']}}  {lines[0]}"
        )
        out += [" " * lead + line for line in lines[1:]]
    return out + [""]


def render_board(view: dict, kind: str, rows: list[dict], sections, owner: str,
                 project: int, total: int, shown_filter: str,
                 width: int = BOARD_WIDTH, containers: list[dict] | None = None) -> str:
    """The text view. Vertical sections, because five statuses do not fit across 80
    columns without truncating every title to nothing.

    The title column takes whatever the other four leave, so a wide terminal shows
    the whole title. It used to be a hard 46 characters, which elided
    `Export pull requests, reviews and comments as events` identically at 80
    columns and at 200 -- and put the row itself at 88, past the width the layout
    was chosen to fit.
    """
    out = [view["name"],
           f"{kind} · {owner}/projects/{project} · {len(rows)} of {total} items",
           f"filter: {shown_filter or '(none) -- this board excludes nothing'}"]
    # **Said, not inferred.** The `pts` column holds two kinds of value once a
    # parent is on the board, and a heading naming only one of them leaves the
    # reader to work out which rows are which -- the defect the `who` heading was
    # added to avoid. The heading itself cannot say it: it sets the column's
    # minimum width, and `pts closed/total` would take ten characters from the
    # title on every board. So it is said once, here, and only where it is true.
    #
    # `closed`, never `done`: a child closed as NOT_PLANNED counts, and abandoned
    # is not completed. See `render_progress`.
    if any("started_in" in row for row in rows):
        # Named, because a section heading that reads like a sprint would
        # otherwise be taken for the Sprint field -- which these rows do not have
        # and by #115 never will.
        out.append("sections: when the work under each item began, from the "
                   "earliest sprint: label beneath it")
    if any(shows_progress(row) for row in rows):
        out.append("pts: story points, or closed/total sub-issues for epics "
                   "and initiatives")
    out.append("")
    columns = board_columns(rows, width, containers)
    # Above the status columns, and outside the table: the band is context for
    # what follows, not a section of it. Nothing below counts it -- the item
    # counts, the `empty:` line and the exit behaviour are what they were.
    out += render_band(containers or [], columns, width)
    if rows:
        # A heading, because five unlabelled columns put `8` next to
        # `AGILE Sprint 4` and leave the reader to infer which is which.
        out.append(board_line({"key": "key", "type": "type", "points": "pts",
                               "sprint": "sprint", "who": "who", "title": "title"},
                              columns))
        out.append("  " + "  ".join("─" * columns[c] for c in
                                    ("key", "type", "points", "sprint", "who", "title")
                                    if columns[c]))
    empty = []
    for name, items in sections:
        if not items:
            if name:
                empty.append(name)
            continue
        if name:
            out.append(f"{name} ({len(items)})")
        for row in items:
            title_lines = textwrap.wrap(row["title"], columns["title"]) or [""]
            out.append(board_line({
                "key": key_cell(row),
                "type": row["type"] or "?",
                "points": render_progress(row),
                # Cut, not elided. `elide` spends one of the eight characters on
                # `…` to say there is more, which the cap already implies -- and
                # on the default naming those eight are exactly the number and
                # the week (`0004 W38`), so the ellipsis would cost the week a
                # digit. On a legacy `<Key> Sprint <n>` name neither spelling
                # helps, which is the argument for the naming rather than for
                # the ellipsis.
                "sprint": (row["sprint"] or "—")[:columns["sprint"]],
                "who": render_who(row),
                "title": title_lines[0],
            }, columns))
            # **Wrapped, not elided.** A window is as wide as the developer made
            # it and the tool already renders to that width -- the fixed 80 is for
            # a pipe and a file. Where a title still does not fit, losing its tail
            # to `…` loses the half that usually says what the work is; the
            # continuation lines are indented to the title column so the board
            # still reads as a column.
            for continuation in title_lines[1:]:
                out.append(" " * (width - columns["title"]) + continuation)
        out.append("")
    if empty:
        out.append("empty: " + " · ".join(empty))
    # Only when there is one. An explanation of a mark nothing carries is noise
    # on every board that is in order, which is most of them.
    stale = [r for r in rows if stale_status(r)]
    if stale:
        if out and out[-1]:
            out.append("")
        out.append(f"{STALE_MARK} closed, but Status is not {CYCLE_END} -- the board is "
                   f"showing finished work as live.")
        for row in stale:
            out.append(f"    {row['key']}  Status: {row['status'] or '(none)'}  "
                       f"->  gh agile issue move {row['number']} {CYCLE_END}")
    return "\n".join(out).rstrip() + "\n"


#: Layouts that identify a board type on their own. `ROADMAP_LAYOUT` is used by
#: exactly one type, so a view drawn as a roadmap *is* a roadmap whatever its
#: filter says. `BOARD_LAYOUT` is shared by scrum and kanban and `TABLE_LAYOUT` by
#: backlog and custom, so neither decides anything and neither is listed.
LAYOUT_IMPLIES = {"ROADMAP_LAYOUT": "roadmap"}


def board_kind(view: dict, config: dict) -> str:
    """A view's board type: the profile, then the filter, then the layout.

    **The filter match is the fragile one, and it has to be.** It asks whether the
    type's base filter appears in the view's, which holds while a board is in step
    with this tool and fails the moment the base filter here changes -- a roadmap
    created before `#174` carries `label:type:epic` and no longer contains the
    spec, so it would report as `custom` until someone re-ran `setup`. Reporting a
    roadmap as custom is a small wrong answer, but it is the kind that makes a
    reader distrust the column, and the layout already knows.

    So the layout is consulted last, for the types it can identify alone. It is
    also what the web UI actually renders, which is the same reason
    `LAYOUT_SECTIONS` groups on it rather than on the profile's declared type.
    """
    declared = {b["name"]: b["type"] for b in (config.get("boards") or [])}
    by_specificity = sorted(BOARD_TYPES.items(), key=lambda kv: len(kv[1]["filter"]),
                            reverse=True)
    return declared.get(view["name"]) or next(
        (k for k, spec in by_specificity
         if spec["filter"] and spec["filter"] in (view.get("filter") or "")),
        LAYOUT_IMPLIES.get(view.get("layout"), "custom"),
    )


def listed_views(views: list[dict]) -> str:
    """Views as `board list` numbers them, for an error that has to be acted on.

    With the number, because it is the other way to name a board and the reader
    is being asked to pick one.
    """
    width = max([1] + [len(str(v.get("number", ""))) for v in views])
    return "\n".join(f"    {str(v.get('number', '?')):>{width}}  {v['name']}" for v in views)


def find_view(login: str, project: int, wanted: str) -> dict:
    """One view by number, or by name: exact, then unique prefix, then unique substring.

    **The number is the stable handle.** `board list` prints it, GitHub assigns
    it, and it survives the rename that a name does not -- so `board show 3` is
    accepted, and an all-digit argument is a number unless some board is actually
    called that. The name is tried first for exactly that case.

    Prefix before substring so "Sprint" reaches "Sprint board" even when another
    board mentions sprints halfway through its name; substring after it so
    `board show agile` still finds "Team: AGILE" without the quoting a colon and a
    space demand. Ambiguity surviving all four is **refused and listed** rather
    than resolved by picking the first -- rendering the wrong team's board under
    the right team's name is the kind of wrong answer nobody checks.
    """
    views = views_of(login, project)
    folded = wanted.casefold()
    candidates = [
        [v for v in views if v["name"] == wanted],
        [v for v in views if wanted.isdigit() and v.get("number") == int(wanted)],
        [v for v in views if v["name"].casefold().startswith(folded)],
        [v for v in views if folded in v["name"].casefold()],
    ]
    for matches in candidates:
        if len(matches) == 1:
            return matches[0]
    narrowest = next((m for m in candidates if m), [])
    if not narrowest:
        sys.exit(f"no board matches {wanted!r} on project {project}. There is:\n"
                 f"{listed_views(views)}")
    sys.exit(f"{wanted!r} matches more than one board:\n{listed_views(narrowest)}\n"
             f"  Name one exactly, or give its number.")


def cmd_board_show(args) -> int:
    """Render one board as text, or as JSONL that can re-create that text.

    The filter comes from the view, so this shows what the web UI shows rather
    than what someone retyped -- and `--filter` appends to it rather than
    replacing it, because a board's own filter is the part that must not be lost.
    """
    view = find_view(args.owner, args.project, args.name)
    kind = board_kind(view, args._config)
    own = view.get("filter") or ""
    # Only what the caller typed: the view's own filter already carries the
    # expanded `label:initiative:<slug>` form, written by `board create`.
    extra = resolve_filter_initiatives(args._config, args.filter, current_repo())
    combined = " ".join(c for c in (own, extra) if c)
    terms = parse_filter(combined)

    if not terms:
        # **A board that excludes nothing is not a board**, and the reader is
        # usually being misled by its name rather than by this tool. On the
        # Zamboni project a view renamed `Backlog` in the web UI had never been
        # given the backlog filter, so closed work showed there and in the scrum
        # board's Done section at once -- reported as a bug here, and it was not
        # one: a board is reconstructed, never mirrored, so the filter comes from
        # the view rather than from its name. Both signals were present and both
        # were easy to skim past.
        #
        # The *type* is deliberately not inferred from the name. Guessing that a
        # view called `Backlog` wants the backlog filter is the same
        # name-based inference that refusing an unknown filter term exists to
        # avoid. The fact is stated and the choice is left with the reader.
        #
        # `terms`, not the view's own filter: a filterless view shown with
        # `--filter status:Todo` is filtered, and must not be flagged.
        print(f"  {view['name']!r} has no filter, so it shows every item on the "
              f"project.\n"
              f"    A board that excludes nothing is usually a view that was named "
              f"and never configured.\n"
              f"    `gh agile board create --name {view['name']!r} --type "
              f"{'|'.join(BOARD_TYPES)}` converges an\n"
              f"    existing view by name and gives it the filter for that type.",
              file=sys.stderr)

    active, completed = iterations(args.owner, args.project)
    current = active[0]["title"] if active else None
    sprint_order = [i["title"] for i in active + completed]

    keys = {}
    for entry in profile_keys(args._config):
        keys.setdefault(entry.get("repo"), entry.get("key"))

    _title, items = fetch_items(args.owner, args.project)
    issues = [i for i in items
              if (i.get("content") or {}).get("__typename") == "Issue"
              and not i.get("isArchived")]
    shown = [i for i in issues if item_matches(i, terms, current_sprint=current)]
    rows = [board_row(i, keys) for i in shown]
    grouping = LAYOUT_SECTIONS.get(view["layout"], "status")
    if grouping == "start":
        # Needs the whole board, not the filtered rows: a roadmap shows epics and
        # the dates come from the stories under them, which the filter excludes.
        # Free, because `fetch_items` has already returned them.
        derive_starts(issues, rows, keys, {i["startDate"]: i["title"]
                                           for i in active + completed})
    sections = board_sections(rows, grouping, sprint_order, terms)
    # **Only where it earns its place.** A scrum board filters on
    # `sprint:@current`, and a container is deliberately in no sprint, so it is
    # the one board where the larger work cannot appear among the rows. On a
    # kanban or backlog board the parents are already there and a band would
    # repeat them.
    containers = board_containers(issues, shown, keys) if kind == "scrum" else []

    stamp = _now()
    if args.format == "jsonl":
        body = board_jsonl(view, kind, rows, sections, args, combined, len(issues),
                           stamp, containers)
        suffix = "jsonl"
    else:
        # A file gets the fixed width whatever the terminal is doing: `--out-dir`
        # writes a record, and a record that is 203 columns on one machine and 80
        # on the next is a diff nobody can read.
        width = BOARD_WIDTH if args.out_dir else display_width()
        body = render_board(view, kind, rows, sections, args.owner, args.project,
                            len(issues), combined, width, containers)
        suffix = "txt"

    if args.out_dir:
        directory = pathlib.Path(args.out_dir)
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / f"board_{kind}_{slug(view['name'])}_{file_stamp(stamp)}.{suffix}"
        path.write_text(body)
        print(f"  {path}  ({len(rows)} item(s))")
    else:
        sys.stdout.write(body)
    return 0


def slug(text: str) -> str:
    """`Team: AGILE` -> `team-agile`. For a filename, so no colons and no spaces."""
    kept = [c.lower() if c.isalnum() else "-" for c in text]
    return "-".join(part for part in "".join(kept).split("-") if part) or "board"


def board_jsonl(view: dict, kind: str, rows: list[dict], sections, args,
                shown_filter: str, total: int, stamp: str,
                containers: list[dict] | None = None) -> str:
    """One metadata line, then one line per item, in section order.

    The header carries what the text view is built from -- layout, section order,
    the filter actually applied -- so the display can be re-created from the file
    without going back to GitHub. Each item names its section for the same reason.
    """
    header = {
        "kind": "board",
        "name": view["name"],
        "board_type": kind,
        "layout": view["layout"],
        "filter": shown_filter,
        "view_filter": view.get("filter") or "",
        "owner": args.owner,
        "project": args.project,
        "generated_at": stamp,
        "sections": [name for name, _ in sections],
        "item_count": len(rows),
        "board_item_count": total,
    }
    lines = [json.dumps(header, sort_keys=True)]
    # Its own `kind`, so a reader can tell a container the filter excluded from
    # an item it selected. Merging them would be the same confusion the text
    # rendering keeps the band out of the table to avoid.
    for container in containers or []:
        lines.append(json.dumps({"kind": "container", **container}, sort_keys=True))
    for name, items in sections:
        for row in items:
            lines.append(json.dumps({"kind": "item", "section": name, **row},
                                    sort_keys=True))
    return "\n".join(lines) + "\n"


def render_board_list(views: list[dict], config: dict) -> str:
    """The index of boards: number, name, type, layout, filter.

    The number is first and bare, because it is what `board show` takes. Widths
    come from the values rather than from a guess -- the name column was a fixed
    28 and "Engineering: all work" ran into the type beside it.
    """
    rows = [{
        "number": str(view["number"]),
        "name": view["name"],
        "type": board_kind(view, config),
        "layout": view["layout"].replace("_LAYOUT", "").lower(),
        "filter": view.get("filter") or "",
    } for view in views]
    headings = {"number": "#", "name": "name", "type": "type",
                "layout": "layout", "filter": "filter"}
    columns = {c: max([len(headings[c])] + [len(r[c]) for r in rows]) for c in headings}

    def line(row):
        return (f"  {row['number']:>{columns['number']}}  {row['name']:<{columns['name']}}  "
                f"{row['type']:<{columns['type']}}  {row['layout']:<{columns['layout']}}  "
                f"{row['filter']}").rstrip()

    out = [line(headings),
           "  " + "  ".join("─" * columns[c] for c in
                            ("number", "name", "type", "layout", "filter"))]
    out += [line(row) for row in rows]
    return "\n".join(out) + "\n"


def cmd_board(args) -> int:
    if args.board_command == "list":
        print(render_board_list(views_of(args.owner, args.project), args._config), end="")
        return 0

    if args.board_command == "show":
        return cmd_board_show(args)

    result = make_board(args.owner, args.project, args.name, args.type,
                        resolve_filter_initiatives(args._config, args.filter, current_repo()))
    print(f"  {result['action']} #{result['number']}: {result['name']} "
          f"[{result['type']}]  filter: {result['filter']}")

    if args.save:
        config = args._config
        boards = [b for b in config.get("boards", []) if b.get("name") != args.name]
        boards.append({"name": args.name, "type": args.type,
                       **({"filter": args.filter} if args.filter else {})})
        config["boards"] = boards
        target = find_config(getattr(args, "config", None)) or pathlib.Path(CONFIG_PATH)
        target.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
        print(f"  saved to {target}; `gh agile setup` will keep it in step")
    return 0


def write_sprint_template(config: dict, template: str, path) -> dict:
    settings = dict(SPRINT_TEMPLATES[template])
    settings["template"] = template
    settings.setdefault("name_template", SPRINT_DEFAULTS["name_template"])
    settings.setdefault("autocreate", True)
    config["sprint"] = settings
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
    return settings


def backfill_titles(args, config: dict, mode: str) -> int:
    """Rename every issue on the project to match `mode`. Idempotent, by design.

    `project title-prefix` changes what *new* issues are called, and says so --
    which leaves a board adopting the setting permanently mixed: everything
    before it bare, everything after carrying `KEY-<n>`. Measured on the Zamboni
    board the day the setting was taken up, where 18 of 19 issues predated it.

    The hand-written version is a shell loop over `gh issue list` calling
    `gh issue edit --title`, and it is short enough to write twice and subtle
    enough to get wrong once: skip on "already has a prefix" and a re-run
    double-prefixes, because the prefix it found belonged to a different issue.
    Here the title is **stripped and rebuilt** instead of tested, so the result
    depends on the issue rather than on how many times this has run.

    The key comes from the issue's own `key:` label before the profile's default
    for the repository -- a mono-repo carries several keys against one repo, and
    the label is which one this issue answers to.
    """
    data = rows(args.owner, args.project, with_history=False)
    renamed = skipped = unkeyed = 0
    for row in sorted(data, key=lambda r: (r["repository"], r["number"])):
        repo, number, title = row["repository"], row["number"], row["title"]
        labels = set(row["labels"].split(";")) if row["labels"] else set()
        key = next((lb[len(KEY_LABEL):] for lb in labels if lb.startswith(KEY_LABEL)), None)
        key = key or next(iter(keys_for_repo(config, repo)), None)
        if not key:
            # Nothing to prefix with and nothing safe to strip: without a key,
            # `strip_title_prefix` cannot tell this tool's prefix from the
            # issue's own words. Reported rather than skipped in silence.
            unkeyed += 1
            print(f"    ? {repo}#{number}: no key applies; left alone")
            continue
        kind = next((lb[len("type:"):] for lb in labels if lb.startswith("type:")), None)
        # `key+type` needs a type and a machine may not infer one, so an issue
        # with no `type:` label gets the key-only form -- the part that
        # identifies it. Same rule `sync --adopt` follows.
        effective = mode if (mode != "key+type" or kind) else "key"
        want = prefixed_title(effective, key, number, kind or "", strip_title_prefix(title, key))
        if want == title:
            skipped += 1
            continue
        if args.dry_run:
            print(f"    would rename {repo}#{number}: {want}")
        else:
            gh(["issue", "edit", str(number), "--repo", repo, "--title", want])
            print(f"    renamed {repo}#{number}: {want}")
        renamed += 1

    verb = "would rename" if args.dry_run else "renamed"
    print(f"  {verb} {renamed}, already correct {skipped}, across {len(data)} item(s)")
    if unkeyed:
        print(f"  {unkeyed} item(s) had no key and were left alone", file=sys.stderr)
    return 0


def cmd_project(args) -> int:
    """Create the board and record it in the profile, or set its cadence.

    Creation belongs to this tool rather than `gh project create` because two
    things have to happen with it: `project.number` is written to the profile so
    every later command can default `--project`, and a second project in the
    same repository is refused -- with one profile holding one number, a second
    board would make that default ambiguous.
    """
    config = args._config
    target = find_config(getattr(args, "config", None)) or pathlib.Path(CONFIG_PATH)
    if args.project_command == "title-prefix":
        # Existing issues are left alone unless `--backfill` asks otherwise.
        # Renaming a board's worth of issues emits a RenamedTitleEvent for each
        # and changes titles under people mid-sprint, so it stays something
        # somebody chooses rather than something the setting does on their behalf.
        if args.dry_run and not args.backfill:
            sys.exit("--dry-run only means something with --backfill.\n"
                     "  Without it this command writes one line to the profile and "
                     "renames nothing.")
        project = config.setdefault("project", {})
        project["issue_title_prefix"] = args.mode
        if args.mode != "off" and not (config.get("keys") or []):
            sys.exit("no keys are listed in the profile, so there is nothing to prefix "
                     "titles with.\n  Add one first: gh agile key --key ZMBNI")
        print(f"  issue title prefix: {args.mode}  e.g. {TITLE_PREFIX_MODES[args.mode]}")
        if args.dry_run:
            # Nothing is written, the profile included: a preview that quietly
            # changed the setting would be a preview nobody could trust.
            print(f"  would write to {target}")
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
            print(f"  written to {target}")
        if not args.backfill:
            print("  applies to issues created from now on; "
                  "`--backfill` renames the ones already there")
            return 0
        return backfill_titles(args, config, args.mode)

    if args.project_command == "owner":
        # For a profile written before the owner was recorded. `project create`
        # sets it from now on, and a profile naming a number with no owner works
        # only for the one account that happens to hold that number.
        project = config.setdefault("project", {})
        was = project.get("owner")
        project["owner"] = args.owner
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
        print(f"  project.owner: {args.owner}" + (f"  (was {was})" if was else ""))
        print(f"  written to {target}; --owner now defaults to it")
        return 0

    if args.project_command == "sprint-template":
        settings = write_sprint_template(config, args.template, target)
        print(f"  sprint cadence: {args.template} "
              f"({settings['cadence_days']} days from {settings['start_day']})"
              + ("  -- no sprints; kanban" if args.template == "none" else ""))
        print(f"  written to {target}")
        return 0

    existing = (config.get("project") or {}).get("number")
    if existing and not args.force:
        sys.exit(
            f"the profile already names project #{existing}. One project per main "
            "repository, because project.number is what every command defaults to.\n"
            "  To start a different project: remove project.number from the profile "
            "here, or work from the clone of that project's main repository."
        )

    # Asked before the board exists, so the cadence is a decision rather than
    # something discovered after sprints already follow it.
    if (args.project_command == "create" and not args.sprint_template
            and not (config.get("sprint") or {}).get("template")):
        require_sprint_config(config, "creating a project")

    created = json.loads(gh(["project", "create", "--owner", args.owner,
                             "--title", args.title, "--format", "json"]))
    number = created["number"]
    print(f"  project #{number} created: {created['url']}")

    config.setdefault("project", {})
    # The owner is recorded alongside the number, because the number alone is
    # only meaningful to the account that holds it. Known for free here: this is
    # the account the project was just created under.
    config["project"].update({"number": number, "name": args.title, "owner": args.owner})
    if args.key:
        config["project"]["key"] = args.key
        entries = profile_keys(config)
        if not any(e.get("key") == args.key for e in entries):
            entries.append({"key": args.key, "name": args.title, "repo": args.repo})
        config["keys"] = entries
    target = find_config(getattr(args, "config", None)) or pathlib.Path(CONFIG_PATH)
    if args.sprint_template:
        settings = write_sprint_template(config, args.sprint_template, target)
        print(f"  sprint cadence: {args.sprint_template} "
              f"({settings['cadence_days']} days from {settings['start_day']})")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
    print(f"  profile updated: {target}")
    return 0


def cmd_key(args) -> int:
    """Record, or show, the key for a repository.

    Also writes the project's `shortDescription`, which is the nearest GitHub
    has to a place for this: a project carries a `title` and a
    `shortDescription` and no key of any kind, so the human-readable pairing --
    "Zamboni Iceberg table maintainer" / ZMBNI -- lives there while the machine
    reads the config file.
    """
    config = args._config
    entries = profile_keys(config)
    target = find_config(getattr(args, "config", None)) or pathlib.Path(CONFIG_PATH)

    if not args.key:
        if not entries:
            print("  no keys recorded")
        for entry in entries:
            print(f"  {entry['key']:10} {entry.get('repo', '?'):28} {entry.get('name', '')}")
        return 0

    if problem := key_problem(args.key):
        sys.exit(f"{args.key!r}: {problem}")
    entries = [e for e in entries if e.get("key") != args.key]
    entries.append({"key": args.key, "name": args.name or args.key, "repo": args.repo})
    config["keys"] = entries
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
    print(f"  {args.key} -> {args.repo}  (in {target})")
    # Said, not done: a board is a view on a shared project, and creating one
    # because a key was recorded is a write nobody asked for (#211).
    if len(entries) > 1 and not any(b.get("type") == "kanban"
                                    for b in config.get("boards") or []):
        print(f"\n  {len(entries)} keys now, so a cross-team board has something to show:\n"
              f"    gh agile board create --name \"{CROSS_TEAM_BOARD['name']}\" "
              f"--type kanban --save")

    # Only when the key being recorded *is* this project's key. A key's name
    # describes the key -- "Zamboni Iceberg table maintainer" for ZMBNI -- and
    # writing it into the project's shortDescription relabelled a project called
    # gh-agile as Zamboni. Two different things, one flag.
    project_key = (config.get("project") or {}).get("key")
    if args.project and args.name and project_key and args.key == project_key:
        graphql(
            "mutation($p: ID!, $d: String!) { updateProjectV2(input: "
            "{projectId: $p, shortDescription: $d}) { projectV2 { shortDescription } } }",
            p=project_id(args.owner, args.project), d=f"{args.name} [{args.key}]",
        )
        print(f"  project #{args.project} described as {args.name!r} [{args.key}]")
    return 0


def cmd_task(args) -> int:
    """Create a task and attach it to its story. The fourth creation command.

    **`--story` is required and there is no `none`.** An epic may stand under no
    initiative and #91 gave a story the same, because the work is real either
    way. A task is not: the whole definition is *how one person is organising
    their own story*, so a parentless task is not a thin task -- it is an issue
    with the wrong label on it.

    **Not boarded, and that is the point rather than an omission.** A board
    listing tasks is the ceremony POLICY.md §2 warns about: on a kanban board of
    fifty items, one story broken into five turns one card into six. So nothing
    here touches the project, and there is no `--points`, `--priority` or
    `--status` either -- the flags that would let a task carry a number it must
    not carry do not exist on this command.

    The parent is resolved **before the issue is created**, the same ordering
    `epic --initiative` uses: issue numbers are never reused, so a typo caught
    afterwards leaves a permanent hole in the sequence.
    """
    require_key_for_prefix(args._config, getattr(args, "key", None))
    # Resolved first, so a mistyped `--story` costs nothing. `parse_issue_ref`
    # takes the keyed form as well as a bare number, as every other command does.
    repo, story = parse_issue_ref(str(args.story), args._config, args.repo)
    try:
        parent = json.loads(gh(["issue", "view", str(story), "--repo", repo,
                                "--json", "id,labels,title"]))
    except SystemExit as exc:
        sys.exit(f"--story {args.story!r} could not be read: {exc}\n"
                 f"  Nothing was created; an issue number is never reused, so this "
                 f"refuses before it costs one.")
    parent_labels = [n["name"] for n in parent.get("labels") or []]
    parent_type = next((lb[len("type:"):] for lb in parent_labels
                        if lb.startswith("type:")), None)
    if parent_type and parent_type != "story":
        # The level is defined by its parent. A task hanging off an epic is a
        # structure nobody meant, and `validate` reports it -- better to refuse
        # before the issue exists than to create one and then complain about it.
        sys.exit(f"{repo}#{story} is a {parent_type}, and a task belongs to a story.\n"
                 f"  A task is how one person is organising their own story; under "
                 f"anything else it is\n  a story or an epic that has been mislabelled.")

    labels = ["type:task"] + ([f"{KEY_LABEL}{args.key}"] if getattr(args, "key", None) else [])
    ensure_labels(repo, labels)
    number, node = create_issue(
        repo, args.title,
        BODY_TEMPLATE.format(intent=args.intent or "_TBD_", acceptance=args.acceptance or "_TBD_"),
        labels,
    )
    title = apply_title_prefix(
        args._config, repo, number, getattr(args, "key", None), "task", args.title
    )
    url = f"https://github.com/{repo}/issues/{number}"
    # Announced before the edge is made, for the same reason `epic` and `story`
    # announce before the board write: what follows can be refused on its own,
    # and an issue nobody named is an issue nobody can find.
    print(f"  task #{number} under story #{story}: {title}")
    print(f"  {url}")

    graphql(
        "mutation($parent: ID!, $child: ID!) { addSubIssue(input: "
        "{issueId: $parent, subIssueId: $child}) { subIssue { number } } }",
        parent=parent["id"], child=node,
    )
    # Said, not left to be discovered. A task absent from the board looks like a
    # failed write unless the command says it was never going to be there.
    print("  not added to the board: a task is story-internal and changes no "
          "number on it")
    return 0


def cmd_set(args) -> int:
    """Set a field on an issue already on the board.

    The gap the first real repair found: `story` sets fields at creation and
    nothing could set them afterwards, so a half-created item -- a rate limit
    hit between two field writes -- could only be fixed by hand, which is what
    this tool exists to avoid.
    """
    # **Status has one door, and it is `issue move`.** That is where Done asks for
    # evidence, starting work claims the issue and assigns the sprint, and the
    # `sprint:` label is stamped. A field write here skipped all of it -- the
    # second route to Done that #202 closes. Refused before anything is read.
    if args.field.strip().casefold() == "status":
        sys.exit("Status changes through `gh agile issue move ISSUE STATUS`, which asks "
                 "for the evidence\n  Done needs and claims the issue and its sprint when "
                 "work starts; closing is\n  `gh agile issue close ISSUE`.")
    repo, args.issue = parse_issue_ref(args.issue, args._config, getattr(args, "repo", None))
    item = board_item_for(args.owner, args.project, repo, args.issue)
    if not item:
        sys.exit(f"issue {repo}#{args.issue} is not on project {args.project}")
    # **Refused, not accepted and ignored.** `task` has no `--points` flag, but
    # `set` reaches any issue on the board, and a number written here would be
    # summed by everything downstream that sums points. Saying so is the whole
    # difference between a rule and a hope.
    if args.field.casefold() in ("story points", "points"):
        labels = issue_labels(repo, args.issue)
        if f"type:{TASK_TYPE}" in set(labels):
            sys.exit(
                f"{repo}#{args.issue} is a task, and a task carries no estimate.\n"
                f"  A task is how one person is organising their own story, so it "
                f"changes no number\n  on the board -- points on one would be summed "
                f"into a velocity nobody meant.\n"
                f"  Estimate the story instead."
            )
    # **The same rule, at the other door.** `plan` is where a container's dates
    # are set and it refuses a story; `set` reaches every field on every issue,
    # so without this the sanctioned path refuses and the generic one writes it
    # anyway. A date on a story is read by nothing -- the roadmap places a story
    # from its Sprint, which is what #115 left it.
    # `and` short-circuits, so the issue is read only for the two field names
    # this rule is about.
    if (args.field.casefold() in {name.casefold() for name in DATE_FIELDS}
            and not container_level(issue_labels(repo, args.issue))):
        sys.exit(
            f"{repo}#{args.issue} is not an epic or an initiative, and only "
            f"those carry a plan.\n"
            f"  A story's dates are its sprint. Set one with `--field Sprint`.\n"
            f"  For a container, `gh agile plan` writes both dates in one call "
            f"and can clear them."
        )
    value = args.value
    if args.number is not None:
        value = args.number
    # Same aliasing as `move`, for the one field where it matters: `set --field
    # Status --value In-Review` should not behave differently from `move
    # --status In-Review`.
    if args.field.casefold() == "status":
        value = canonical_status(str(value))
    set_field(args.owner, args.project, item["id"], args.field, value)
    print(f"  #{args.issue} {args.field} = {value}")
    return 0


#: `none` on a date flag: take the date off rather than set one. Spelled the way
#: `story --epic none` already spells the same idea -- an explicit opt-out that
#: reads as a decision, where a bare `--start` with no argument reads as a
#: mistake. One sentinel, so a reader who has met one has met both.
CLEAR_DATE = "none"


def planned_dates(start: str | None, target: str | None) -> list[tuple[str, str | None]]:
    """`(field, value)` for each date **given**, with `None` meaning clear.

    Separated from `cmd_plan` so the parsing is testable without a board, and so
    every date is parsed before any of them is written: `plan X --start
    2026-10-01 --target soon` must write nothing at all, not the half of itself
    that happened to be valid. The same rule `epic` follows for a different
    reason -- there, a refusal after the issue exists costs an issue number;
    here it costs a plan that is half one thing and half another.

    Not-given and cleared are different answers and stay tellable apart: absent
    is "leave it", `none` is "take it off".
    """
    out = []
    for field_name, raw, flag in zip(DATE_FIELDS, (start, target),
                                     ("--start", "--target"), strict=True):
        if raw is None:
            continue
        out.append((field_name, None if raw.strip().casefold() == CLEAR_DATE
                    else iso_date(raw, flag)))
    return out


def item_date(login: str, project: int, item_id: str, field_name: str) -> str | None:
    """One DATE field's value on one item, or None if it holds nothing.

    Its own call, for the reason `issue_assignees` is: `board_items` reads
    `LEAN_ITEM_SELECTION` -- an item's id, number, repository and type and
    deliberately nothing else -- and widening it would charge every board-wide
    read for something one command needs. Addressed by node id, so it costs 1
    point rather than a whole-board read.
    """
    data = graphql(
        "query($i: ID!) { node(id: $i) { ... on ProjectV2Item { fieldValues(first: 20) "
        "{ nodes { ... on ProjectV2ItemFieldDateValue { date field "
        "{ ... on ProjectV2FieldCommon { name } } } } } } } }",
        i=item_id,
    )
    nodes = (((data.get("data") or {}).get("node") or {}).get("fieldValues") or {}).get("nodes") or []
    return next((n["date"] for n in nodes
                 if (n.get("field") or {}).get("name") == field_name and n.get("date")), None)


def cmd_plan(args) -> int:
    """Set or clear the dates on an epic or an initiative that already exists.

    **A team designs and plans before it staffs and schedules.** The dates
    arrive when somebody is available, when a quarter is agreed, when a
    dependency lands -- so they are inherently a later edit, and `--start` on
    `epic` and `initiative`, which only works while the issue is being created,
    is the wrong shape for them. Raised by the owner, who described that
    sequence.

    **Its own command rather than a mode on three others**, and the precedent is
    `move`: starting work is one call because Status, Sprint, the label and the
    assignee are one decision expressed in four writes. Planning is the same
    shape -- both dates are one decision, and `set` writes one field per
    invocation, so re-planning through `set` is two commands and two board
    writes that can half-fail. `plan` also knows what it is writing to, which
    `set` by design does not: `set` reaches any field on any issue.

    Clearing is here because a plan that slips is re-planned and a date set in
    error has to come off. `clear_field` has existed since #170 and nothing
    reached it from a command line until now.
    """
    span = getattr(args, "span", None)
    if args.start is None and args.target is None and span is None:
        sys.exit("plan needs --start, --target, --for, or a combination. A date is "
                 f"YYYY-MM-DD in UTC,\n  {CLEAR_DATE!r} removes one, and --for sizes "
                 f"the span from the start -- 6w, 10d, 3sprints.")
    if span and args.target:
        sys.exit(SPAN_AND_TARGET)
    # Refused rather than resolved one way: `--start none --for 6w` asks for the
    # span to be measured from the date it is removing in the same breath.
    if span and (args.start or "").strip().casefold() == CLEAR_DATE:
        sys.exit("--for measures from a start date, and --start none takes it away.\n"
                 "  Clear the dates, or give the start this span runs from.")
    repo, args.issue = parse_issue_ref(args.issue, args._config, getattr(args, "repo", None))
    # **Every refusal before the first write**, in the order that costs least:
    # the dates parse with no API call at all, the level is one issue read, and
    # only then is the board asked for the item.
    wanted = planned_dates(args.start, args.target)
    level = container_level(issue_labels(repo, args.issue))
    if not level:
        sys.exit(
            f"{repo}#{args.issue} is not an epic or an initiative, and only those "
            f"carry a plan.\n"
            f"  A story's dates are its sprint -- #115 is the rule that a level "
            f"which spans\n  sprints holds none, which is why these two fields "
            f"exist for the levels above.\n"
            f"  Move the story with `gh agile issue edit {args.issue} --field "
            f"Sprint --value ...`."
        )
    item = board_item_for(args.owner, args.project, repo, args.issue)
    if not item:
        sys.exit(f"issue {repo}#{args.issue} is not on project {args.project}")
    # **The start a span runs from may already be on the item**, which is what
    # makes `plan X --for 8w` a sentence: re-sizing a phase is a thing a planner
    # does on its own, without restating a start date that has not changed. Read
    # only when `--for` is given and `--start` is not, so nothing else pays for it.
    note = ""
    if span:
        starts_on = next((v for name, v in wanted if name == DATE_FIELDS[0]), None)
        if starts_on is None:
            starts_on = item_date(args.owner, args.project, item["id"], DATE_FIELDS[0])
        if not starts_on:
            sys.exit(
                f"--for measures a span, and {repo}#{args.issue} has no start date to "
                f"measure it from.\n  Pass --start YYYY-MM-DD as well, or set one first."
            )
        wanted.append((DATE_FIELDS[1], target_from(starts_on, span, args._config)))
        note = f" ({span} from {starts_on})"
    for field_name, value in wanted:
        if value is None:
            clear_field(args.owner, args.project, item["id"], field_name)
            print(f"  #{args.issue} {field_name} cleared")
        else:
            set_field(args.owner, args.project, item["id"], field_name, value)
            # The provenance is printed because the field cannot hold it: a date
            # arrived at by arithmetic looks exactly like one somebody typed.
            print(f"  #{args.issue} {field_name} = {value}"
                  f"{note if field_name == DATE_FIELDS[1] else ''}")
    return 0


#: Who the implicit claim assigns, and what `--add-assignee @me` names: whoever
#: is running the command. `gh` resolves it against the token it owns, so the tool neither
#: sees a credential nor has to guess a username from a git config.
CALLER = "@me"


def issue_assignees(repo: str, issue: int) -> list[str]:
    """Who the issue is assigned to now.

    Its own call, because `board_items` reads `LEAN_ITEM_SELECTION` -- the item
    id and the issue number, and deliberately nothing else.
    """
    return [a["login"] for a in json.loads(
        gh(["issue", "view", str(issue), "--repo", repo, "--json", "assignees"])
    )["assignees"]]


def claim_issue(repo: str, issue: int, wanted: str, *, explicit: bool) -> str:
    """Assign the issue, and say what happened. Additive, like `--add-label`.

    **An unassigned issue is a gap; an assigned one is a decision.** The rule the
    sprint heal already follows. Starting work claims an issue nobody holds and
    leaves alone one that somebody does -- silently adding yourself to another
    person's work would make the convention argue with the team. `--add-assignee`
    is how to say otherwise: passing it -- a login, or `@me` -- assigns whatever
    the status and whoever already holds it.
    """
    if not explicit:
        held = issue_assignees(repo, issue)
        if held:
            return f"  #{issue} already assigned to {', '.join(held)}; left alone"
    who = wanted or CALLER
    gh(["issue", "edit", str(issue), "--repo", repo, "--add-assignee", who])
    # `@me` rather than the login it resolves to: naming the person would cost a
    # `gh api user` call on every move, to restate what was typed.
    return f"  #{issue} assigned to {who}"


#: What GitHub records for a close, against what `gh issue close --reason` is told.
CLOSE_REASONS = {"completed": "COMPLETED", "not planned": "NOT_PLANNED"}


def close_issue(repo: str, issue: int, *, not_planned: bool,
                comment: str | None = None) -> None:
    """Close the issue, and check GitHub recorded the reason that was asked for.

    **The exit code cannot be trusted here.** `gh issue close --reason` on an
    issue that is already closed prints `already closed` to stderr, changes
    nothing, and exits 0 -- so a discarded `--not-planned` looked exactly like a
    successful one. Reported rather than assumed, for the same reason permission
    failures stopped being reported as success.

    The read costs one call on one transition, and it is the difference between
    `closed` and the truth. `abandoned` and `completed` are not interchangeable:
    the export keeps them apart in `state_reason`, and `validate` and
    `sprint backfill` both decide whether to demand a `sprint:` label from it --
    so a reason silently downgraded to `COMPLETED` puts a false *worked in this
    sprint* label on an issue nobody worked.
    """
    wanted = "not planned" if not_planned else "completed"
    gh(["issue", "close", str(issue), "--repo", repo, "--reason", wanted]
       + (["--comment", comment] if comment else []))
    recorded = json.loads(gh(["issue", "view", str(issue), "--repo", repo,
                              "--json", "state,stateReason"]))
    reason = (recorded.get("stateReason") or "").upper()
    if reason == CLOSE_REASONS[wanted]:
        print(f"  #{issue} closed as {wanted}")
        return
    # Not fatal: the issue *is* closed, the status is set, and failing here would
    # leave the caller worse off than telling them. Loud, though, and on stderr.
    print(f"  #{issue} closed, but GitHub recorded {reason or 'no reason'} rather than "
          f"{CLOSE_REASONS[wanted]}.\n"
          f"    A project workflow that closes on Status=Done gets there first, and the "
          f"reason\n"
          f"    cannot be changed once an issue is closed. Reopen and close it again to "
          f"correct it.", file=sys.stderr)


def abandoning(args) -> bool:
    """Whether this run is closing the issue as *not planned*.

    Both attributes, because `not_planned` alone changes nothing: `cmd_move`
    reads it only inside `if args.close`. They were `move --close --not-planned`,
    and `--not-planned` without `--close` was parsed, accepted and dropped. Since
    #202 only `issue close -r "not planned"` sets them, and it sets both.
    """
    return bool(getattr(args, "not_planned", False) and getattr(args, "close", False))


#: An issue's parent and grandparent, with everything needed to decide whether to
#: promote them: the level, from the labels, and the project item plus its Status.
#:
#: Two levels in one round trip rather than one query per hop. A story's chain is
#: epic then initiative and stops there, so the depth is the hierarchy's, not a
#: guess -- and walking it lazily would cost a second query on every start for a
#: level that is usually absent.
PARENT_CHAIN_QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      parent { ...level parent { ...level } }
    }
  }
}
fragment level on Issue {
  number
  repository { nameWithOwner }
  labels(first: 50) { nodes { name } }
  projectItems(first: 20) {
    nodes {
      id
      project { number }
      fieldValueByName(name: "Status") {
        ... on ProjectV2ItemFieldSingleSelectValue { name }
      }
    }
  }
}"""


def promote_parents(args, repo: str, issue: int) -> None:
    """Carry a start upward: an epic whose story has begun has begun.

    Nothing moved an epic out of `Todo`. Its stories started, ran and closed
    beneath it while it read as untouched, and the only thing that ever changed
    it was somebody remembering to -- which is the bookkeeping this tool exists
    to remove. On the backlog an epic in `Todo` with a child in flight is
    indistinguishable from one nobody has touched.

    **Promoted only from `Todo` or empty, and never demoted.** The rule is the
    one the sprint heal already follows: *an empty field is damage, a set one is
    a decision*. An epic left in `Todo` while work runs under it is a gap nobody
    chose. An epic somebody deliberately put in `Blocked` or `In Review` is a
    decision, and a tool that overwrites it argues with the person using it --
    so every other status is left exactly alone, silently, because reporting a
    non-event on every start is noise. Nor does it ever go back: a parent does
    not return to `Todo` because its last in-flight child paused.

    **Status only, never a sprint.** `set_field` is called directly rather than
    routed back through `move`, so none of the sprint machinery runs -- which is
    what #115 established for these levels and what a recursive call would have
    quietly undone.

    Both levels, because an initiative is as invisible as an epic was: starting a
    story promotes the epic, and the epic's start promotes the initiative above
    it. A parent that is not one of those levels is left alone -- a story's own
    parent, once tasks exist, is not something a task starting should move.

    Costs one query plus at most two field writes, and only on a start.
    """
    owner, _, name = repo.partition("/")
    try:
        data = graphql(PARENT_CHAIN_QUERY, owner=owner, name=name, number=issue)
    except SystemExit as exc:
        # Not fatal. The status write has already succeeded and the caller's work
        # has started; failing here would report an error for an issue that moved
        # correctly. Said on stderr so it is not mistaken for nothing to do.
        print(f"  could not read the parents of {repo}#{issue}: {exc}", file=sys.stderr)
        return

    node = ((data.get("data") or {}).get("repository") or {}).get("issue") or {}
    chain = []
    parent = node.get("parent")
    while parent:
        chain.append(parent)
        parent = parent.get("parent")

    for level_node in chain:
        labels = [n["name"] for n in (level_node.get("labels") or {}).get("nodes") or []]
        level = container_level(labels)
        if not level:
            continue
        item = next((n for n in (level_node.get("projectItems") or {}).get("nodes") or []
                     if (n.get("project") or {}).get("number") == args.project), None)
        if not item:
            # On the hierarchy but not on this board. `sync` is what puts it
            # there; promoting something absent is not this command's business.
            continue
        status = (item.get("fieldValueByName") or {}).get("name")
        if status and not same_status(status, "Todo"):
            continue
        set_field(args.owner, args.project, item["id"], "Status", CYCLE_START)
        print(f"  #{level_node['number']} {level} follows its child: "
              f"Status = {CYCLE_START}")


def cmd_close(args) -> int:
    """Close an issue, as `gh issue close` does, and bring its Status with it.

    `move --close --not-planned` was the only close, and `--not-planned` without
    `--close` silently did nothing. The cleanup of ZMBNI-185 was
    `gh issue close 185 -r "not planned" -c ...`, so that is the spelling (#202).

    Both reasons end at Status `Done`, because a closed issue on any other Status
    is live work to every board filter. **Completed is the Done path entire** --
    the evidence rule, the closing `sprint:` label. **Not planned** needs no
    evidence and stamps no label, because a `sprint:` label asserts the sprint
    work was *done in*. Closed first, then Status, for the reason `cmd_move`
    gives where it does it.
    """
    args.status = CYCLE_END
    args.close = True
    args.not_planned = args.reason == "not planned"
    args.add_assignee = None
    return cmd_move(args)


def cmd_reopen(args) -> int:
    """Reopen an issue, as `gh issue reopen` does, and put its Status back.

    `Todo` unless `--status` names another: a reopened issue is waiting to be
    picked up again, and moving it through `cmd_move` means `--status
    "In Progress"` claims it and assigns the sprint as any start of work does.
    Its `sprint:` labels stay -- they record where it was worked, which reopening
    does not undo.
    """
    repo, number = parse_issue_ref(args.issue, args._config, getattr(args, "repo", None))
    gh(["issue", "reopen", str(number), "--repo", repo]
       + (["--comment", args.comment] if args.comment else []))
    print(f"  #{number} reopened")
    args.issue, args.repo = str(number), repo
    args.evidence = args.evidence_file = args.add_assignee = None
    return cmd_move(args)


def cmd_move(args) -> int:
    """Change an issue's status, requiring the evidence that status implies.

    `In Progress` needs nothing new. `Done` requires Evidence, because that is
    the transition after which nobody revisits the issue -- and an issue closed
    with the word "done" has thrown away the reasoning that made it defensible.
    """
    # `ZMBNI-34` names the repository as well as the number, which is the point
    # of having a key at all; a bare number takes the repository from --repo,
    # --key, or the working directory.
    repo, issue = parse_issue_ref(args.issue, args._config, getattr(args, "repo", None))
    args.issue = issue
    # Refused before anything is written. An empty value used to mean the
    # caller; `gh` has no such spelling, so it is now a mistake, and finding it
    # after the Status write would leave half a move behind.
    asked = getattr(args, "add_assignee", None)
    if asked is not None and not asked.strip():
        sys.exit('--add-assignee needs a login; "@me" assigns you.')
    # Canonicalised once, here, so everything downstream -- the evidence lookup,
    # the field write, the cycle-start and cycle-end comparisons and what gets
    # printed -- sees the spelling GitHub holds rather than the one that was
    # typed. `In-Review` and `in review` are the same transition.
    args.status = canonical_status(args.status)
    # Nothing was done, so there is nothing to evidence: a close as not planned
    # reaches Done -- a closed issue on any other Status reads as live work on
    # the board (`stale_status`) -- without the section Done otherwise demands.
    # Offered text is still written; `-c` is where the reason belongs.
    required = () if abandoning(args) else tuple(REQUIRED_FOR.get(args.status.casefold(), ()))
    # Read whenever the text was offered, not only when the status demands it.
    # This was `if required else {}`, so on every status but the cycle end the
    # flags were parsed, accepted and thrown away: no warning, exit 0, and the
    # status change succeeded, which is every reason to believe the text landed.
    # Measured on the Zamboni board: four issues moved to In Review with
    # substantial --evidence, all four bodies left with an empty ## Evidence,
    # noticed days later when the text existed nowhere else. Recording why
    # something is Blocked is worth having anyway -- a blocked issue with no note
    # of what blocks it is the least useful state on a board.
    offered = bool(getattr(args, "evidence", None) or getattr(args, "evidence_file", None))

    # What the issue already says counts. `require_sections` validated the text
    # *supplied on the command line* and never looked at the body, which was
    # harmless while `Done` was the only status that could write evidence --
    # supplied and resulting were the same thing. Since evidence can be written
    # at `In Review`, the common shape is write-then-close, and that was exactly
    # the shape this refused: AGILE-62's own body carried a full Evidence
    # section and `move 62 --status Done` still exited with "no text supplied".
    #
    # The cost was never the message. Retyping a long section invites
    # `--evidence "see above"`, and a one-line placeholder that satisfies the
    # validator is precisely the erosion POLICY.md §4 exists to prevent. A guard
    # that makes the honest path expensive teaches the dishonest one.
    body = None
    if required and not offered:
        body = issue_body(repo, args.issue)
        problems = section_problems(parse_sections(body), required)
        if not problems:
            print(f"  #{args.issue} {', '.join(required)} already in the body")
            required = ()
        elif not sys.stdin.isatty():
            # Named as a body problem, not as a missing argument. The old message
            # said only "no text supplied", which is the misleading half: it sent
            # people to look for a flag when the answer was to write the section.
            sys.exit(
                f"the issue body does not carry what a move to {args.status} requires:\n"
                "  - " + "\n  - ".join(problems) + "\n"
                "  Nothing was supplied on the command line either. Write the section\n"
                "  on the issue, or pass --evidence TEXT, --evidence-file FILE, or - "
                "for stdin."
            )
    sections = (read_template(args, required=required or OPTIONAL_SECTIONS,
                              interactive_ok=bool(required))
                if required or offered else {})
    if required:
        require_sections(sections, required)

    item = board_item_for(args.owner, args.project, repo, args.issue)
    if not item:
        sys.exit(f"issue {repo}#{args.issue} is not on project {args.project}")

    if sections:
        if body is None:
            body = issue_body(repo, args.issue)
        for name, text in sections.items():
            body = replace_section(body, name, text)
        gh(["issue", "edit", str(args.issue), "--repo", repo, "--body", body])
        print(f"  #{args.issue} body updated: {', '.join(sections)}")

    # **Closed before the Status is written, and the order is the whole fix.**
    # A project can carry a built-in *auto-close when Status is Done* workflow.
    # Measured on the sandbox 2026-09-13: setting Status to `Done` and issuing no
    # close at all left the issue CLOSED as `COMPLETED` one second later -- and
    # GitHub attributes that close to the **project owner**, not to
    # `github-project-automation`, which is why the timeline looked like ours.
    #
    # Arriving second is fatal rather than merely late: `gh issue close --reason`
    # on an already-closed issue is a no-op that warns to stderr and **exits 0**,
    # so `--not-planned` was discarded and the command still printed `closed`.
    # There is no repair afterwards; the reason cannot be changed on a closed
    # issue. Closing first, then setting Status, keeps `NOT_PLANNED` -- measured
    # on the same project that loses it the other way round.
    if getattr(args, "close", False):
        close_issue(repo, args.issue, not_planned=args.not_planned,
                    comment=getattr(args, "comment", None))
    set_field(args.owner, args.project, item["id"], "Status", args.status)
    print(f"  #{args.issue} Status = {args.status}")

    # **An epic or an initiative is never put in a sprint.** The two blocks below
    # keyed off the status alone, so starting an epic assigned it the current
    # sprint and stamped a `sprint:` label exactly as if it were a story. Both
    # are wrong for a level that spans sprints, and wrong in the way that is
    # hardest to notice: the `Sprint` field is filled only when empty, so the
    # epic stays pinned to the iteration it happened to start in -- on the scrum
    # board for one sprint, silently gone the next while the work continues. It
    # also writes a false record, since a `sprint:` label asserts the sprint the
    # work was *worked in* and one label cannot say "all of them".
    #
    # Underneath both: the `Sprint` field holds exactly one value, so putting a
    # container in a sprint does not say "started here" -- it says "committed to
    # this iteration", which is false the moment the next one begins. That
    # sentence used to sit on `CONTAINER_TYPES`, where every rule that reads the
    # tuple had to read past it; it belongs here, with the rule it explains.
    #
    # Looked up only on the two transitions that touch the sprint, so every other
    # status change costs nothing. Status and the assignee claim are unaffected:
    # an epic still starts, it simply does not join an iteration.
    container = None
    if same_status(args.status, CYCLE_START) or same_status(args.status, CYCLE_END):
        container = sprint_exempt(issue_labels(repo, args.issue))
        if container:
            # Said out loud rather than skipped quietly: an issue that starts
            # with no sprint line looks like the sprint write failed. The reason
            # is named because the two are different -- see `sprint_exempt`.
            print(f"  #{args.issue} is a{'n' if container[0] in 'aeiou' else ''} "
                  f"{container}; leaving Sprint and {SPRINT_LABEL} labels alone")

    # Starting work puts the item in the current sprint, if it is not already in
    # one. Anything else means a board where in-progress work sits outside every
    # sprint, and a sprint report that quietly omits it. A warning rather than a
    # refusal when no sprint is active: declining to start work because nobody
    # created a sprint would be the tool making a process decision.
    if same_status(args.status, CYCLE_START) and not container:
        # Same reason: item-list carries no custom field values, so the sprint
        # has to come from the GraphQL side.
        assigned = sprint_assignments(args.owner, args.project)
        if not assigned.get(item["id"]):
            active, _completed = iterations(args.owner, args.project)
            if not active and sprint_settings(args._config).get("autocreate"):
                # On demand, because a sprint series must be driven by work and
                # not by a clock. A cron that tops sprints up would manufacture
                # them through a quiet quarter, leaving a row of empty sprints
                # nobody planned; creating one when work actually starts leaves
                # the idle months genuinely absent, which is what the burndown
                # should show. `ensure_sprints` skips the gap rather than
                # backfilling it, so the numbering jumps and says so.
                print("  no active sprint; creating the one that covers today")
                ensure_sprints(args.owner, args.project, args._config,
                               sprint_settings(args._config)["ahead"])
                active, _completed = iterations(args.owner, args.project)
            if active:
                set_field(args.owner, args.project, item["id"], "Sprint", "@current")
                print(f"  #{args.issue} Sprint = {active[0]['title']} (current)")
            else:
                # `none`, or a series that cannot be placed. Not a refusal:
                # declining to start work because nobody created a sprint would
                # be the tool making a process decision.
                print("  no active sprint; leaving Sprint unset", file=sys.stderr)
        stamped = record_sprint_label(args, repo, args.issue, item["id"],
                                      not_planned=abandoning(args))
        if stamped:
            print(f"  #{args.issue} + {stamped}")

    # Outside the sprint block above, deliberately: that one skips the levels
    # that span sprints, and an epic's own start is exactly when the initiative
    # above it should follow.
    if same_status(args.status, CYCLE_START):
        promote_parents(args, repo, args.issue)

    # Starting work claims the issue, for the same reason it assigns the sprint:
    # work in flight that reads unassigned is invisible to the one question a
    # board answers beside "what is in progress" -- who has it. Both are
    # automatic because a person doing three things by hand does two.
    # Given at all is somebody asking, so it is
    # honoured whatever the status. Absent, only starting work claims. The two
    # cases mean the same person and different things, which is why the flag has
    # no argparse default: `default=""` could not tell them apart.
    given = getattr(args, "add_assignee", None) is not None
    wanted = (getattr(args, "add_assignee", None) or "").strip()
    # **A container is never claimed implicitly.** The implicit claim fills a gap
    # -- work in flight that reads as nobody's -- and on an epic or initiative
    # there is no gap to fill: it holds stories worked by several people, so
    # there is no single "who has this", and the caller is merely whoever
    # happened to start one of them. `--add-assignee` still assigns at any level,
    # because given at all is somebody asking rather than the tool guessing.
    if given or (same_status(args.status, CYCLE_START) and not container):
        # After the Status line and never before it. The status write has already
        # succeeded by here, and these are two grants -- the same split
        # `board_write_reported` exists for: if the assignee write is refused,
        # the output has to carry both facts.
        print(claim_issue(repo, args.issue, wanted, explicit=given))

    if same_status(args.status, CYCLE_END) and not container:
        # Again at the end: an item carried across a boundary finishes in a
        # different sprint than it started, and the closing one is what a
        # velocity figure is built from. Both labels survive; the latest date is
        # the sprint it closed in, and the earlier ones are the carryover.
        stamped = record_sprint_label(args, repo, args.issue, item["id"],
                                      not_planned=abandoning(args))
        if stamped:
            print(f"  #{args.issue} + {stamped}")

    return 0


def replace_section(body: str, name: str, text: str) -> str:
    """Replace one `## Heading` block, appending the heading if absent."""
    sections = parse_sections(body)
    if name not in sections:
        return body.rstrip() + f"\n\n## {name}\n{text}\n"
    out, skipping = [], False
    for line in body.splitlines():
        if line.strip().startswith("## "):
            heading = line.strip()[3:].strip()
            skipping = heading == name
            out.append(line)
            if skipping:
                out.append(text)
            continue
        if not skipping:
            out.append(line)
    return "\n".join(out).rstrip() + "\n"


#: Which sections a transition demands. Only Done, deliberately: requiring
#: evidence to start work is ceremony, requiring it to finish is the point.
REQUIRED_FOR = {"done": ("Evidence",)}

#: Where a bare blob goes when the status demands nothing. `read_template` maps
#: unheaded text onto the single required section, and with nothing required
#: there was no section to map onto -- so text passed to `--evidence` on
#: `In Review` parsed to no sections and vanished a second way, past the guard
#: above. Evidence, because that is what the flag is called and what the note is.
OPTIONAL_SECTIONS = ("Evidence",)


def master_rows(login: str, project: int, config: dict, stamp: str) -> dict[str, list[dict]]:
    """Configuration as three full tables: project, boards, sprints.

    **Always a full refresh, never incremental.** These are small, they change
    rarely, and a watermark over them would be a way to miss the one change that
    mattered -- a board's filter edited, a key added. Reload the whole thing and
    the question of what changed becomes the loader's, where it belongs.
    """
    project_row = {
        "exported_at": stamp,
        "project_id": project,
        "project_name": (config.get("project") or {}).get("name") or "",
        "project_key": (config.get("project") or {}).get("key") or "",
        # Semicolon-joined rather than a nested structure: this is a CSV, and a
        # loader that has to parse JSON out of a cell is a loader that will get
        # it wrong once.
        "keys": ";".join(k.get("key", "") for k in profile_keys(config)),
        "repos": ";".join(sorted({k.get("repo", "") for k in profile_keys(config)})),
        # Seconds on the way out, like every other duration. `cadence_days` is
        # the profile's hand-authored spelling -- a person writes 14, not
        # 1209600 -- and the unit suffix stops at the file's edge.
        "sprint_cadence": sprint_settings(config)["cadence_days"] * 86400,
        "sprint_start_day": sprint_settings(config)["start_day"],
    }

    board_rows = []
    for view in views_of(login, project):
        declared = {b["name"]: b["type"] for b in (config.get("boards") or [])}
        board_rows.append({
            "exported_at": stamp,
            "project_id": project,
            "board_id": view["number"],
            "board_name": view["name"],
            "board_type": declared.get(view["name"], "custom"),
            "layout": view["layout"].replace("_LAYOUT", "").lower(),
            "filter": view.get("filter") or "",
        })

    sprint_rows = []
    try:
        active, completed = iterations(login, project)
    except SystemExit as exc:
        # An empty sprints table and an unreadable one render identically, and
        # one of them is a lie -- a board with four sprints reported as having
        # none reads as a configuration fact. Say which this is. Deliberately
        # not fatal: the project and board tables are already built and are
        # worth handing over.
        active, completed = [], []
        print(f"  sprints could not be read, so none are reported: {exc}", file=sys.stderr)
    import datetime as dt

    today = today_utc()
    for state, group in (("completed", completed), ("active", active)):
        for iteration in group:
            start = dt.date.fromisoformat(iteration["startDate"])
            end = start + dt.timedelta(days=iteration["duration"] - 1)
            sprint_rows.append({
                "exported_at": stamp,
                "project_id": project,
                "sprint_name": iteration["title"],
                "start_date": start.isoformat(),
                "end_date": end.isoformat(),
                # Seconds, like every other duration here. GitHub stores the
                # iteration length in days; the day count stays available as
                # start_date .. end_date.
                "duration": iteration["duration"] * 86400,
                # GitHub reports completed separately from active; current and
                # future are told apart by the date, since it does not.
                "state": ("completed" if state == "completed"
                          else "current" if start <= today <= end else "future"),
            })
    return {"project": [project_row], "boards": board_rows, "sprints": sprint_rows}


def without_tasks(data: list[dict]) -> tuple[list[dict], int]:
    """Export rows with `type:task` removed, and how many that was.

    The rule from #137, in one place so it can be tested as a rule: **a task is
    not exported.** It has no metric and no KPI, it is story-internal
    housekeeping many teams keep in a checklist file, and a grain exists to be
    measured. #135 makes a task change no number anywhere -- and a row that
    changes no number is not a measurement.

    Reversible on demand: the data is still in GitHub, so the decision changes
    without rewriting anything built on it. That is the other reason it is the
    cheap direction.
    """
    kept = [row for row in data
            if f"type:{TASK_TYPE}" not in set((row.get("labels") or "").split(";"))]
    return kept, len(data) - len(kept)


def cmd_export(args) -> int:
    """Full or incremental, to stdout or to a timestamped file.

    Incremental is watermark-based and deliberately overlapping: see
    DEFAULT_OVERLAP_SECONDS. Rows repeat across runs by design, and the target
    resolves them latest-wins on its primary key.
    """
    import datetime as dt

    # `state_key`, not `key`. The out-dir branch below used a bare `key` for the
    # project-key directory name and shadowed this one, so the watermark was
    # *read* from "owner/project" and *written* to "AGILE". A file export
    # therefore never advanced the value it would next read, and only kept
    # working because stdout runs happened to advance the read key -- which is
    # precisely what this release stops them doing.
    state_key = f"{args.owner}/{args.project}"
    state = read_state(args.state) if args.state else {}
    since = args.since or (state.get(state_key, {}).get("watermark") if args.state else None)

    started = _now()
    events: list[dict] | None = [] if args.grain in ("events", "both", "all") else None
    data = rows(args.owner, args.project, with_history=not args.no_history,
                since=since, events=events)
    # **Tasks are not exported, and this is a stated rule rather than an
    # accident of a filter.** Decided on #137: a task has no metric and no KPI.
    # It is story-internal housekeeping -- many teams do the same thing with a
    # checklist file -- and a grain exists to be measured. #135 already makes a
    # task change no number anywhere; a row that changes no number is not a
    # measurement, and the export is a measurement surface.
    #
    # Filtered here rather than in `rows`, which `validate` and `board show`
    # also read: they must keep seeing tasks, or #136's checks go blind.
    #
    # The events are filtered with them, or `github_events` would carry the
    # history of issues `github_issues` has no row for -- a foreign key into
    # nothing, which is worse than the absence.
    data, skipped_tasks = without_tasks(data)
    if events is not None:
        exported = {(r["repository"], r["number"]) for r in data}
        events[:] = [e for e in events
                     if (e.get("repository"), e.get("number")) in exported]

    # Pull requests are fetched once and used twice: for `github_prs`, and for
    # the review events that go into `github_events`. `since` goes to GitHub as
    # `updated:>=` rather than being applied here, so an incremental run never
    # transfers a pull request nobody has touched -- the search is the only part
    # of this export with a server-side filter, and `--grain prs` is therefore
    # the cheapest grain to run often.
    pulls: list[dict] | None = None
    if args.grain in ("prs", "events", "both", "all"):
        keys = {}
        for entry in profile_keys(args._config):
            keys.setdefault(entry.get("repo"), entry.get("key"))
        project_key = (args._config.get("project") or {}).get("key") or str(args.project)
        fetched = pull_requests(args._config, since)
        if args.grain in ("prs", "all"):
            pulls = [pr_row(pull, keys) for pull in fetched]
        if events is not None:
            for pull in fetched:
                events.extend(pr_event_rows(pull, project_key, keys))
        print(f"  {len(fetched)} pull request(s)"
              + (f" updated since {since}" if since else ""), file=sys.stderr)
    for row in data:
        # Stamped per row as well as in the filename: a loader that concatenates
        # several exports keeps the ordering without re-deriving it from a path.
        row["exported_at"] = started

    if since:
        print(f"  incremental since {since}: {len(data)} row(s)", file=sys.stderr)
    else:
        print(f"  full export: {len(data)} row(s)", file=sys.stderr)
    if skipped_tasks:
        # Said, because a count that silently omits rows is the failure this
        # repo already names. The reason is given rather than only the number,
        # so nobody reads it as a bug and goes looking for the missing grain.
        print(f"  {skipped_tasks} task(s) not exported: story-internal, no metric "
              f"(see github_catalog.json)", file=sys.stderr)

    if events is not None:
        for event in events:
            event["exported_at"] = started
        print(f"  {len(events)} event row(s)", file=sys.stderr)

    if pulls is not None:
        for pull in pulls:
            pull["exported_at"] = started

    if args.out_dir:
        # One directory per project key, so several projects can export into one
        # tree without colliding: exports/ZMBNI/agile_issues_....csv
        directory = pathlib.Path(args.out_dir)
        project_key = (args._config.get("project") or {}).get("key")
        if project_key and directory.name != project_key:
            directory = directory / project_key
        directory.mkdir(parents=True, exist_ok=True)
        suffix = "csv" if args.csv else "json"
        # Built from what was asked for rather than filtered afterwards: the
        # skip rules were a list of exceptions per grain, and `prs` would have
        # meant two more of them.
        tables = []
        if args.grain in ("issues", "both", "all"):
            tables.append(("issues", data))
        if events is not None:
            tables.append(("events", events))
        if pulls is not None:
            tables.append(("prs", pulls))
        if args.grain in ("master", "all"):
            tables += list(master_rows(args.owner, args.project, args._config, started).items())
        for grain, payload in tables:
            if payload is None:
                continue
            path = directory / f"github_{grain}_{file_stamp(started)}.{suffix}"
            with path.open("w", newline="") as handle:
                _write(payload, handle, csv_format=args.csv)
            print(f"  wrote {path}", file=sys.stderr)
    else:
        _write({"events": events, "prs": pulls}.get(args.grain, data),
               sys.stdout, csv_format=args.csv)

    # The watermark advances only when the rows were written to timestamped
    # files. A watermark is a promise that everything up to it has been
    # delivered somewhere durable, and stdout is not durable: piping an export
    # into `less`, or into a script that fails, used to advance it just as far
    # as a completed run to disk. The next real export then began after rows
    # nothing had kept.
    #
    # Found by reading the board with a bare `export` and getting `[]` back --
    # harmlessly, because that project keyed separately, but the same command
    # against the pipeline's own project would have moved its watermark.
    if args.state and args.out_dir:
        # Pulled back by the overlap, so the next run re-reads the window in
        # which the timeline may still have been catching up.
        cut = dt.datetime.strptime(started, "%Y-%m-%dT%H:%M:%SZ") - dt.timedelta(
            seconds=args.overlap_seconds
        )
        watermark = cut.strftime("%Y-%m-%dT%H:%M:%SZ")
        write_state(args.state, state_key, watermark, len(data))
        print(f"  watermark -> {watermark} in {args.state}", file=sys.stderr)
    elif args.state and since:
        # Still incremental -- the window is the same one the pipeline would
        # see -- but the watermark stays where it is, so this run costs the
        # pipeline nothing.
        print(f"  watermark unchanged ({since}): stdout is not a durable "
              f"destination. Use --out-dir to advance it.", file=sys.stderr)
    return 0


def _write(data: list[dict], handle, *, csv_format: bool) -> None:
    if not csv_format:
        json.dump(data, handle, indent=2)
        handle.write("\n")
        return
    if not data:
        return
    columns: list[str] = []
    for row in data:  # union of keys, first-seen order: fields vary per item
        columns.extend(k for k in row if k not in columns)
    writer = csv.DictWriter(handle, fieldnames=columns, extrasaction="ignore")
    writer.writeheader()
    writer.writerows(data)


#: One issue, from the issue's side: its labels, and its item on each project it
#: is on, with that item's Sprint value. Everything `fix` needs, in one query.
#:
#: Measured on board #4, in GraphQL points, because the arithmetic is not what
#: the code shape suggests:
#:
#:     this query                                    1
#:     iterations()                                  2
#:     board_items()   -- `project item-list -L 200` 106
#:     fields_of()     -- `project field-list -L 50` 106
#:     fetch_items()   -- paginated GraphQL, first:100  8
#:
#: **The cost is the `-L` you ask for, not the rows you get back.** `-L 200`
#: against a 25-item board costs 102 points; `-L 25` costs 26 and `-L 5` costs 6.
#: So the `gh project ... list` commands are an order of magnitude dearer than
#: the "heavy" paginated GraphQL they were assumed to be cheaper than, and a
#: repair routed through `board_items` costs ~105 points to write one field.
#:
#: Going at it from the issue rather than the board also removes the ambiguity
#: `board_item_for` has to defend against: an issue names its own repository, so
#: there is no number to collide.
ISSUE_ITEM_QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      number
      labels(first: 50) { nodes { name } }
      projectItems(first: 20) {
        nodes {
          id
          project { number }
          fieldValueByName(name: "Sprint") {
            ... on ProjectV2ItemFieldIterationValue { title }
          }
        }
      }
    }
  }
}"""


def issue_project_item(repo: str, issue: int, project: int) -> tuple[str, list[str], str | None]:
    """`(item id, the issue's labels, its current Sprint title)` for one project.

    The project is matched on its number: an issue can be on several, and taking
    the first would be the same defect `board_item_for` exists to prevent.
    """
    owner, _, name = repo.partition("/")
    try:
        data = graphql(ISSUE_ITEM_QUERY, owner=owner, name=name, number=issue)
    except SystemExit as exc:
        # GraphQL answers a missing issue with an error, not a null, so `gh`
        # exits before the check below is reached. The reason is kept rather
        # than replaced -- a swallowed reason cost hours once, and "could not
        # resolve" also covers a repository the caller cannot read, which is a
        # different problem with the same words.
        sys.exit(f"could not read issue {repo}#{issue}: {exc}")
    found = ((data.get("data") or {}).get("repository") or {}).get("issue")
    if not found:
        sys.exit(f"no issue {repo}#{issue}")
    labels = [n["name"] for n in (found.get("labels") or {}).get("nodes", [])]
    for node in (found.get("projectItems") or {}).get("nodes", []):
        if (node.get("project") or {}).get("number") == project:
            return node["id"], labels, ((node.get("fieldValueByName") or {}) or {}).get("title")
    sys.exit(f"issue {repo}#{issue} is not on project {project}")


def cmd_fix(args) -> int:
    """Repair one issue's `Sprint` field from its `sprint:` labels.

    The per-issue form of `sprint reconcile`, which is board-wide and has no
    `--id`. Same rule, same direction: **the labels are the record and the field
    is reconciled toward them**, and an empty field is damage while a
    disagreeing field is somebody's decision -- so only an empty one is written
    unless `--overwrite` is given.

    Cheap on purpose, and cheap for a measured reason rather than an assumed one:
    one `ISSUE_ITEM_QUERY` plus `iterations()` is 3 GraphQL points, against ~105
    for the first draft of this command, which went through `board_items`. See
    the table on `ISSUE_ITEM_QUERY`.
    """
    repo, issue = parse_issue_ref(args.issue, args._config, getattr(args, "repo", None))
    item_id, labels, current = issue_project_item(repo, issue, args.project)

    active, completed = iterations(args.owner, args.project)
    by_start = {i["startDate"]: i["title"] for i in active + completed}
    if not by_start:
        sys.exit("no sprints exist on this project; nothing to reconcile to")

    # The per-issue form of the same rule `reconcile_sprints` follows: a level
    # that spans sprints is not given a Sprint field, so there is nothing here to
    # repair toward. Reported rather than refused -- being asked is reasonable,
    # and the answer is that the label is the stray thing, not the empty field.
    if level := container_level(labels):
        print(f"  {repo}#{issue} is an {level}, which spans sprints; it has no Sprint "
              f"field to repair")
        if any(lb.startswith(SPRINT_LABEL) for lb in labels):
            print(f"  it does carry a {SPRINT_LABEL} label, which is a stray: "
                  f"`gh agile sprint unstamp` clears those")
        return 0

    stamps = sorted(lb[len(SPRINT_LABEL):] for lb in labels if lb.startswith(SPRINT_LABEL))
    if not stamps:
        print(f"  {repo}#{issue} carries no {SPRINT_LABEL} label; nothing to reconcile from")
        print("  `sprint backfill` recovers one from the Status timeline")
        return 0

    # The latest label wins: an item carried across a boundary carries one per
    # sprint it lived in, and the field holds where it is now.
    latest = stamps[-1]
    wanted = by_start.get(latest)
    if not wanted:
        sys.exit(
            f"no sprint on this project starts {latest}, which {repo}#{issue} is labelled "
            f"with.\n  The label is the record and the configuration is what drifted, so "
            f"neither is changed here."
        )

    if current == wanted:
        print(f"  {repo}#{issue} Sprint = {wanted!r} already; nothing to do")
        return 0
    if current and not args.overwrite:
        print(f"  {repo}#{issue} Sprint = {current!r} but labelled {latest} ({wanted!r})")
        print("  a disagreeing field is a decision, not damage; --overwrite acts on it")
        return 0
    if args.dry_run:
        print(f"  would set {repo}#{issue} Sprint = {wanted!r} (from {SPRINT_LABEL}{latest})")
        return 0

    set_field(args.owner, args.project, item_id, "Sprint", wanted)
    print(f"  {repo}#{issue} Sprint = {wanted!r} (from {SPRINT_LABEL}{latest})")
    return 0


#: How a merged pull request appears in `git log --format=%s`. Both spellings,
#: because the merge style is a repository setting somebody can change and a
#: parser that knows only today's silently stops reporting.
#:
#: Matched by hand rather than with `re`: nothing else in this file imports it,
#: and two prefixes and a suffix do not earn a dependency on a second way of
#: describing strings.
MERGE_PREFIX = "Merge pull request #"
SQUASH_OPEN = "(#"


def merged_pull_requests(subjects: list[str]) -> list[int]:
    """The pull requests in these commit subjects, in order, without repeats."""
    found = []
    for subject in subjects:
        text = subject.strip()
        number = None
        if text.startswith(MERGE_PREFIX):
            head = text[len(MERGE_PREFIX):].split(" ", 1)[0]
            number = int(head) if head.isdigit() else None
        elif text.endswith(")"):
            # The squash form, `Title (#188)`, and only at the end: `#188` in the
            # middle of a subject is prose about an issue, not this merge.
            _before, marker, tail = text[:-1].rpartition(SQUASH_OPEN)
            number = int(tail) if marker and tail.isdigit() else None
        if number is not None and number not in found:
            found.append(number)
    return found


def closing_issues(pull_request: int) -> list[tuple[str, int]] | None:
    """Which issues that pull request closes, **as GitHub resolved it**.

    Not by parsing `Closes #n` out of the commit message: the reference lives in
    the pull request *body* and the merge commit names only the pull request.

    **And the link is not the close.** Measured across five consecutive pull
    requests here, `closingIssuesReferences` was registered for every one and
    the close fired for only some -- so this says what a merge *claimed*, and
    the issue's own state says what happened. See #190.
    """
    result = subprocess.run(
        ["gh", "pr", "view", str(pull_request), "--json", "closingIssuesReferences"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        # **`None`, not `[]`.** A call that failed and a pull request that closes
        # nothing are different answers, and collapsing them reports a clean
        # merge to somebody whose token has just expired. See #192.
        return None
    refs = (json.loads(result.stdout or "{}") or {}).get("closingIssuesReferences") or []
    # The repository as well as the number, for the reason `board_item_for`
    # exists: a board may span repositories and each numbers its issues from 1,
    # so a bare number can match two rows.
    return [(f"{ref['repository']['owner']['login']}/{ref['repository']['name']}",
             ref["number"]) for ref in refs]


#: The two states a merge leaves an issue in, and what each one needs. Different
#: commands, which is why this is not a filter over one message -- and giving the
#: wrong one is worse than giving none, since `--close` on an issue that is
#: already closed is a no-op that exits 0, the mechanism that cost
#: `--not-planned` its reason in #96.
STILL_OPEN = (
    "is still open, although a merged pull request in this range says it closes it.",
    "`issue close`, because nothing else has closed it and the reason is this\n"
    "      tool's to choose -- completed, or `-r \"not planned\"` if that is what happened.",
)
CLOSED_NOT_DONE = (
    "was closed by this merge, and the board has not caught up:",
    "`issue move`, not `issue close`: it is already closed, and closing an issue\n"
    "      twice is a no-op that exits 0 -- which is how a close reason gets lost.",
)


def render_unfinished(issue: int, detail: str, command: str, why: str) -> str:
    """What the developer sees. One issue, what is wrong, and the command."""
    body = "\n".join(f"      {line}" for line in detail.splitlines()[1:] if line.strip())
    return (
        f"\n  #{issue} {detail.splitlines()[0]}\n"
        + (f"{body}\n" if body.strip() else "")
        + f"\n      finish it:  {command}\n      {why}\n"
    )


def outstanding(args, board: list[dict], repo: str, issue: int) -> str | None:
    """The report for one issue, or None if the merge left it in order.

    **The rule is not restated here.** `validate` already knows what a closed
    issue should look like -- Status `Done`, a `sprint:` label, a tally that
    agrees -- and a second copy of that list is one that can disagree with it.
    It is called on the board this command already read, so N issues cost one
    board read rather than N.

    An issue left **open** is deliberately not `validate`'s business: the board
    cannot see pull requests, and a story left open after a partial merge is
    ordinary. What makes it reportable is local to the merge being pulled, which
    is where this is standing.
    """
    # Matched here rather than through `select_by_ref`, which refuses an
    # ambiguous bare number by exiting -- correct for a command somebody typed
    # and fatal in a hook, which may never stop a pull. The repository came back
    # with the number, so there is nothing to disambiguate.
    row = next((r for r in board
                if r["number"] == issue and same_repo(r.get("repository"), repo)), None)
    if row is None:
        return None
    if row["state"] != "CLOSED":
        detail, why = STILL_OPEN
        return render_unfinished(
            issue, detail,
            f'gh agile issue close {issue} --evidence "..."', why)
    said, found = io.StringIO(), 0
    # `SystemExit` suppressed for the same reason: `validate --id` refuses a bare
    # number that two repositories share, and a refusal here would take the pull
    # with it. Nothing to report is the right answer to a question this cannot
    # ask unambiguously.
    with contextlib.suppress(SystemExit), contextlib.redirect_stdout(said):
        found = cmd_validate(argparse.Namespace(
            owner=args.owner, project=args.project, id=str(issue),
            _config=args._config, _board=board))
    if found == 0:
        return None
    detail, why = CLOSED_NOT_DONE
    return render_unfinished(
        issue, f"{detail}\n{said.getvalue().strip()}",
        f'gh agile issue move {issue} Done --evidence "..."', why)


#: The line that marks a hook as this tool's, so `hooks` knows what it may
#: replace. A hook somebody wrote themselves is theirs, and overwriting it
#: because the filename matched would be the worst kind of helpfulness.
HOOK_MARKER = "# gh-agile post-merge hook"

#: What `gh agile hooks` writes. **No path into this extension's checkout**, and
#: no choice of interpreter: `gh` resolves the extension, and where `gh` keeps
#: its extensions is a host-and-OS detail that would rot quietly inside every
#: consumer's `.git/hooks`.
#:
#: A **raw** f-string, so what is written here is what lands in the file: an
#: ordinary one turns `\n` into a newline and `\` at a line end into nothing,
#: which silently reflowed this script into one line the first time.
POST_MERGE_HOOK = rf"""#!/bin/sh
{HOOK_MARKER} -- installed by `gh agile hooks`, and safe to delete.
#
# A merged pull request closes an issue and GitHub sets no Status -- or does not
# close it at all. Either way the wrap-up is a person's, because a project
# workflow can only write Status: no Evidence, no closing sprint: label, no
# choice between completed and not planned. This is where that person is told,
# at the moment they are already at the terminal.
#
# Read-only, and it never blocks a pull: a hook that can stop you pulling is a
# hook people delete. Every path below ends in `exit 0`.
#
# `unfinished` exits non-zero only when it could not run. A finding is not a
# failure, so that code means "the check did not happen" and nothing else --
# which is what lets the message below be this hook's own words rather than
# whatever error happened to reach the terminal.
[ -x "$(command -v gh)" ] || exit 0
if said=$(gh agile unfinished --quiet 2>&1); then
    [ -n "$said" ] && printf '%s\n' "$said" >&2
    exit 0
fi
printf '%s\n' \
  "" \
  "  gh-agile: the post-merge check did not run, so nothing was checked." \
  "$said" \
  "  If that says the command is unknown, this clone's gh-agile is older than" \
  "  its hook:  gh extension upgrade agile" \
  "  To stop checking here, delete $0" \
  "" >&2
exit 0
"""


def cmd_hooks(args) -> int:
    """Install the post-merge hook into this clone.

    **A hook is per clone, and that is git's decision rather than an oversight.**
    Hooks are executable code, so cloning never brings them; even the versioned
    route -- `core.hooksPath` with the hook committed -- needs one `git config`
    per clone. Something is done once per developer per repository either way.
    What this removes is the part that was wrong: that the something was
    undocumented, specific to the `gh-agile` repository, and silently
    ineffective anywhere else (#192, #193).
    """
    result = subprocess.run(["git", "rev-parse", "--git-dir"],
                            capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit("not inside a git repository, so there is nowhere to install a hook")
    path = pathlib.Path(result.stdout.strip()) / "hooks" / "post-merge"
    if path.exists() and HOOK_MARKER not in path.read_text():
        sys.exit(
            f"{path} exists and was not written by this tool, so it is not mine "
            f"to replace.\n"
            f"  Add this line to it instead, and it will do the same thing:\n"
            f"    gh agile unfinished --quiet || true"
        )
    existed = path.exists()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(POST_MERGE_HOOK)
    path.chmod(0o755)
    print(f"  {'replaced' if existed else 'installed'} {path}")
    print("  `git pull` here now names any issue a merge closed and nobody finished")
    return 0


def cmd_unfinished(args) -> int:
    """What a merge closed and nobody finished. For a git hook, at the terminal.

    **`Item closed -> Status = Done` is deliberately off** (#186): a project
    workflow writes Status and nothing else, so an issue it touches reads Done
    with no Evidence, no closing `sprint:` label and no choice between completed
    and not planned. The wrap-up is a person's, and what a person needs is to be
    told at the moment they are already at the terminal rather than at the next
    time somebody remembers to run `validate`.

    **Read-only, and it never blocks a pull.** The hook it is written for turns
    every outcome into `exit 0`.

    **The exit code is the seam that hook reads, and it says one thing: whether
    the check ran.** 0 whenever it did, whatever it found -- an outstanding issue
    is a finding, not a failure. Non-zero only when it could not run at all, so
    the hook can say *the check did not happen* in its own words instead of
    letting a stray `gh` error stand in for it (#192).

    A range that does not resolve is not a failure: a first clone has no
    `ORIG_HEAD` and a pull that merged nothing has nothing to say.
    """
    log = subprocess.run(["git", "log", "--format=%s", args.range],
                         capture_output=True, text=True)
    if log.returncode != 0:
        return 0
    issues = []
    for pull_request in merged_pull_requests(log.stdout.splitlines()):
        closed = closing_issues(pull_request)
        if closed is None:
            # **Not the same as closing nothing.** Reporting "nothing waiting"
            # because the API call failed is the quiet wrong answer this bug is
            # about: it looks exactly like a clean merge.
            print(f"  could not ask GitHub what pull request #{pull_request} closes",
                  file=sys.stderr)
            return 1
        for ref in closed:
            if ref not in issues:
                issues.append(ref)
    if not issues:
        if not args.quiet:
            print(f"  nothing closed by {args.range} is waiting to be finished")
        return 0
    try:
        board = rows(args.owner, args.project, with_history=False)
    except (MissingScope, SystemExit) as exc:
        # `rows` exits on a board it cannot read -- the right answer to somebody
        # who typed a command, and the wrong one inside a hook, where it would
        # be indistinguishable from a clean pull.
        print(f"  could not read project {args.project}: {exc}", file=sys.stderr)
        return 1
    reports = [text for repo, issue in issues
               if (text := outstanding(args, board, repo, issue))]
    if not reports:
        if not args.quiet:
            print(f"  nothing closed by {args.range} is waiting to be finished")
        return 0
    # On stderr and unmissable, for the reason the red-build report is: the whole
    # defect is a line that scrolled past.
    for text in reports:
        print(text, file=sys.stderr)
    return 0


def select_by_ref(data: list[dict], ref: str, config: dict) -> list[dict]:
    """The rows for one issue reference, refusing when a bare number is ambiguous.

    A `KEY-NUMBER` reference names the repository and is resolved outright. A
    bare number does not, and on a project spanning repositories it can match
    more than one row -- so both are listed and the caller is asked to say which
    rather than being handed whichever came back first. That guess is the defect
    `board_item_for` exists to prevent, and it would be no better here.
    """
    text = str(ref).strip()
    if text.isdigit():
        matches = [r for r in data if r["number"] == int(text)]
        if len(matches) > 1:
            listed = "\n".join(f"    {r['repository']}#{r['number']}  {r['title'][:52]}"
                               for r in matches)
            sys.exit(
                f"#{text} is on this project from more than one repository:\n{listed}\n"
                "  Name one with a KEY-NUMBER reference, e.g. AGILE-"
                f"{text}, so there is no guess."
            )
    else:
        repo, number = parse_issue_ref(text, config, None)
        matches = [r for r in data
                   if r["number"] == number and same_repo(r.get("repository"), repo)]
    if not matches:
        sys.exit(f"{ref} is not on this project")
    return matches


def cmd_validate(args) -> int:
    """The conventions a machine can check. POLICY.md §3.

    `--id` narrows the report to one issue. It does **not** make the run
    cheaper: the projects API has no way to fetch one item by issue number --
    only by project item id, which is what has to be looked up in the first
    place -- so the board is read either way and the filter is applied after.
    Anyone narrowing this to save budget should reach for `fix --id` instead,
    which never reads the board at all.
    """
    # `_board` lets a caller in this process hand over a board it has already
    # read -- `unfinished` asks about several issues and would otherwise pay for
    # a full read each time. Not a flag: nothing on a command line can supply it.
    board = getattr(args, "_board", None) or rows(args.owner, args.project,
                                                  with_history=False)
    only = getattr(args, "id", None)
    data = select_by_ref(board, only, args._config) if only is not None else board
    # From the whole board, never the filtered view: `--id` narrows what is
    # *reported*, and a parent's status is needed to judge the child whether or
    # not the parent is one of the issues asked about.
    status_of = {r["issue_key"]: r.get("field_status")
                 for r in board if r.get("issue_key")}
    problems: dict[str, list[str]] = defaultdict(list)
    # **Reported, but not a failure.** A finding that is somebody's deliberate
    # choice cannot be fatal without making the validator argue with the person
    # using it -- and a check that fails forever is a check people stop running.
    # It still has to be *visible*, because the same state arrives by accident far
    # more often than on purpose.
    notes: dict[str, list[str]] = defaultdict(list)
    #: {(level, parent key): (the parent's status, the first child seen)}. Keyed
    #: on the parent so an epic with four children in flight is one finding
    #: rather than four -- the thing to fix is the parent, once.
    stalled: dict[tuple[str, str], tuple[str, str]] = {}

    active, completed = iterations(args.owner, args.project)
    sprint_config = active + completed
    #: title -> start date, for comparing the live field against the labels,
    #: which are dated rather than named.
    sprint_starts = {i["title"]: i["startDate"] for i in sprint_config}

    for row in data:
        ident = f"#{row['number']} {row['title'][:48]}"
        labels = set(row["labels"].split(";")) if row["labels"] else set()
        status = row.get("field_status")

        if status and not any(same_status(status, s) for s in STATUSES):
            problems["status is not one of " + ", ".join(STATUSES)].append(f"{ident}: {status!r}")
        # A note rather than a problem since `--epic none` made the orphan
        # sayable. `validate` cannot tell an intended orphan from an accidental
        # one -- nothing marks the difference -- so it says what it sees and
        # leaves the judgement with the reader. POLICY.md §2.
        if "type:story" in labels and not row["epic_number"]:
            notes["story has no epic"].append(ident)

        # **A task is defined by its parent.** One under an epic, an initiative
        # or nothing at all is not a thin task -- it is a story or an epic that
        # has been mislabelled, and the tally, the sprint and the board all
        # behave wrongly for it. `task` refuses to create one, so this catches
        # the hand-labelled and the adopted.
        #
        # A problem rather than a note: unlike an orphan story, this is nobody's
        # deliberate choice and relabelling clears it.
        if f"type:{TASK_TYPE}" in labels and row.get("parent_type") != "story":
            where = row.get("parent_type") or "nothing"
            problems["task is not under a story"].append(f"{ident}: under {where}")

        # **The third direction, and the one that misreads a board daily rather
        # than at the end.** The other two compare an epic's *closed* state with
        # its children's; this compares a start. An epic left in `Todo` while
        # work runs under it looks exactly like an epic nobody has touched --
        # which is what #114 was raised for.
        #
        # `move` now carries a start upward, so this fires for a status set by
        # hand, or work begun outside the tool. It stays a problem rather than a
        # note because it is nobody's deliberate choice and one field write
        # clears it -- unlike the orphan story above, which somebody may have
        # meant.
        if (same_status(status, CYCLE_START) and row.get("parent_key")
                and row.get("parent_type") in CONTAINER_TYPES):
            parent_status = status_of.get(row["parent_key"])
            if not parent_status or same_status(parent_status, "Todo"):
                stalled.setdefault(
                    (row["parent_type"], row["parent_key"]),
                    (parent_status or "unset", ident),
                )
        if "type:epic" in labels and not row["sub_issues_total"]:
            problems["epic has no stories"].append(ident)
        # The same shape one level up. An initiative is a list of the epics a
        # large feature requires, so one with none is a plan with nothing in it.
        #
        # Deliberately **not** checked: an epic with no initiative. Initiatives
        # are optional and most epics will never belong to one -- reporting that
        # would make the common case a finding, which is how a validator gets
        # ignored.
        if "type:initiative" in labels and not row["sub_issues_total"]:
            problems["initiative has no epics"].append(ident)

        # The roll-up, both ways. Ported from the Zamboni markdown suite's
        # `test_an_epic_is_only_done_when_all_its_stories_are`, which was the one
        # check of its five with no equivalent here.
        #
        # Only for an epic that has children: one with none is `epic has no
        # stories` above, and reporting the same issue under two headings is
        # noise rather than a second finding.
        #
        # `subIssuesSummary.completed` is GitHub's name for the count of **closed**
        # children, not for how many were closed as completed -- measured on `#9`,
        # which reported 6 of 7 with six children closed, one of those as
        # `NOT_PLANNED`. That is the count this wants: an epic is waiting on what
        # is still open, whatever reason the rest were closed for.
        #
        # An initiative sits a level above an epic and the arithmetic is the
        # same, so the check is the same -- but **per level, not transitively**.
        # Measured: closing a story took its epic to 1/1 while the initiative
        # stayed 0/1, because `subIssuesSummary` counts direct children. An
        # initiative's tally is therefore epics closed, not stories, and writing
        # this as if it reached the whole tree would report a number nobody could
        # reconcile with the board.
        if labels & {"type:epic", "type:initiative"} and row["sub_issues_total"]:
            parent = "initiative" if "type:initiative" in labels else "epic"
            total, closed = row["sub_issues_total"], row["sub_issues_done"]
            finished = row["state"] == "CLOSED" or same_status(status, CYCLE_END)
            tally = f"{ident}: {closed}/{total} sub-issue(s) closed"
            if finished and closed < total:
                problems[f"{parent} is finished with a sub-issue still open"].append(tally)
            # The direction that goes unnoticed. An epic marked finished over open
            # children is a claim visibly too strong -- the open children are right
            # there under it. An epic left open with every child closed looks like
            # nothing at all: no field disagrees, no child is in the wrong state,
            # it simply persists. Reported by the Zamboni team as the single
            # largest source of stale board state, three epics at once. See #72.
            if not finished and closed == total:
                problems[f"every sub-issue is closed but the {parent} is not"].append(tally)
        if row["state"] == "CLOSED" and status and not same_status(status, CYCLE_END):
            problems[f"closed but status is not {CYCLE_END}"].append(f"{ident}: {status!r}")
        if row["state"] == "OPEN" and same_status(status, CYCLE_END):
            problems[f"status {CYCLE_END} but still open"].append(ident)
        if not labels & {f"type:{t}" for t in ISSUE_TYPES}:
            problems["no type: label"].append(ident)

        # Sprint invariants. The validator used to be blind to sprints, which
        # is where every failure in this project's history actually happened:
        # overlapping sprints, in-progress work in no sprint, and a Sprint field
        # cleared by an ordinary iteration write while the labels stayed right.
        stamps = sorted(lb[len(SPRINT_LABEL):] for lb in labels
                        if lb.startswith(SPRINT_LABEL))
        # **A level that spans sprints is never asked for one.** `move` stopped
        # giving an epic or initiative a Sprint value or a `sprint:` label
        # deliberately, and a validator still demanding both reports the tool's
        # own correct behaviour as a failure -- which exits 1 for as long as any
        # epic is in progress, and a check that fails forever is a check people
        # stop running. Same predicate as `move` uses, so the next level added is
        # covered by one list.
        # `sprint_exempt` rather than `container_level`: a task is exempt too,
        # and for a different reason -- a container spans sprints, a task is not
        # tracked by the board at all. Demanding a sprint of either reports the
        # tool's own correct behaviour as a failure.
        container = sprint_exempt(labels)
        # **The mirror of that exemption, and the half #121 did not have.** A
        # container is not asked for a sprint -- demanding one is the
        # check-that-fails-forever failure. But a container that *has* one is
        # a state that should not exist: it was assigned before #115 barred
        # it, nothing since removes it, and the `no:sprint` boards it belongs
        # on silently exclude it. Measured on `REPORTS-1`, found by a person
        # asking why an epic was on the roadmap and not the backlog.
        if container_level(labels) and row.get("field_sprint"):
            problems["epic or initiative is in a sprint -- "
                     "run `gh agile sprint unstamp`"].append(
                f"{ident}: {row['field_sprint']}")
        if (same_status(status, CYCLE_START) and not row.get("field_sprint")
                and not container):
            problems[f"{CYCLE_START} but in no sprint"].append(ident)
        # **The other half of starting work.** Status, sprint and assignee are set
        # together by `move --status "In Progress"`, and only two of the three were
        # ever checked -- so the sprint half got caught and the assignee half never
        # did. Reported by the Zamboni team; see #125.
        #
        # **`container` is consulted here, and this reverses an earlier decision
        # rather than overlooking it.** That decision exempted these levels from
        # the sprint check but not this one, on the stated reasoning that "`move`
        # claims it like anything else". Two things then changed. `move` now
        # promotes a parent when a child starts (#117) and sets a status without
        # claiming anything, so the premise stopped being true. And the claim
        # itself was a guess: an epic holds stories worked by several people, so
        # there is no single "who has this", and filling it from whoever started
        # the first story is only ever right at team size one.
        #
        # So an empty assignee on a container is **the normal state, not a gap**,
        # and the rule this file runs on -- an unassigned issue is a gap, an
        # assigned one is a decision -- does not apply to a level nobody is meant
        # to hold. Reporting it would be reporting the default. Setting one is
        # still allowed and still meaningful; it is simply never demanded.
        # `container` here is `sprint_exempt`, which covers the task too, and the
        # reasoning carries: the board does not track a task, so who holds it is
        # the story's answer rather than its own.
        if same_status(status, CYCLE_START) and not row["assignees"] and not container:
            problems[f"{CYCLE_START} but unassigned"].append(ident)
        # **There is deliberately no check for a *closed* issue with no assignee**,
        # and the reasoning is worth keeping. Two attempts were measured and both
        # were wrong:
        #
        #   `closed with no assignee` reports 23 of 47 on this board, including
        #   six epics closed on the roll-up and two closed `NOT_PLANNED` -- all
        #   correct states. A check that cries wolf gets ignored.
        #
        #   `closed, carries a sprint: label, no assignee` reports 16, every one a
        #   true historical instance from before starting work claimed the issue.
        #   All unfixable -- who did the work is not recoverable -- so it would be
        #   16 permanent notes on every run forever.
        #
        # And it would buy nothing for the case it was proposed for. An issue
        # closed by a `Closes #n` automation without ever being started has no
        # `sprint:` label either, so `closed with no sprint: label` below already
        # reports it. `started_at` is not available here in any case: `validate`
        # reads with `with_history=False` on purpose, one timeline query per issue
        # being the expensive part of an export.
        # Not asked of an abandoned issue. The label means *the sprint this was
        # worked in*, and work closed as not planned was worked in none -- so
        # demanding one here is what put a false `sprint:2026-08-31` on #72,
        # a duplicate closed on sight, via the `sprint backfill` this very
        # message recommends.
        # `container` for the same reason, and it matters more here than it
        # reads: this message recommends `sprint backfill`, so leaving it in
        # place would have the tool recommend a repair that writes the very
        # label it has just stopped writing -- the #72 shape exactly.
        if (row["state"] == "CLOSED" and same_status(status, CYCLE_END) and not stamps
                and not container
                and (row.get("state_reason") or "").upper() != ABANDONED):
            problems["closed with no sprint: label -- run `sprint backfill`"].append(ident)
        if stamps and row.get("field_sprint"):
            live = sprint_starts.get(row["field_sprint"])
            if live and live not in stamps:
                # The field and the labels disagree. The field is the one that
                # gets cleared and re-set; believe the labels and say so.
                problems["Sprint field disagrees with the sprint: label(s)"].append(
                    f"{ident}: field={row['field_sprint']!r} ({live}) labels={','.join(stamps)}"
                )

    for (level, parent_key), (parent_status, child) in sorted(stalled.items()):
        problems[f"{level} is {'Todo' if parent_status == 'unset' else parent_status} "
                 f"with a child {CYCLE_START}"].append(
            f"{parent_key} ({parent_status}), e.g. {child}")

    # **Advice, not a failure.** The board works; the automation is merely off,
    # and there is no mutation that could turn it on -- so this can only ever
    # point at the web UI, which is exactly what #91's non-fatal severity is
    # for. It is reported here rather than only in `init` because `init` runs
    # once at setup and this is what somebody chasing `closed but status is not
    # Done` is already running.
    if only is None:
        for line in automation_notes(args.owner, args.project):
            notes["project automation that needs a decision"].append(line)

    # Sprint overlap is a property of the iteration series, not of any issue, so
    # Board-wide, so skipped under `--id` for the same reason as the sprint
    # overlap below: these are properties of the set rather than of any issue.
    if only is None:
        claimed: dict[str, list[str]] = defaultdict(list)
        wearing: dict[str, list[str]] = defaultdict(list)
        for row in data:
            labels = set(row["labels"].split(";")) if row["labels"] else set()
            ident = f"#{row['number']} {row['title'][:48]}"
            for slug in (lb[len(INITIATIVE_LABEL):] for lb in labels
                         if lb.startswith(INITIATIVE_LABEL)):
                wearing[slug].append(ident)
                if "type:initiative" in labels:
                    claimed[slug].append(ident)
        for slug, owners in sorted(claimed.items()):
            if len(owners) > 1:
                # Two trees behind one board filter, looking entirely correct --
                # the failure `initiative create` refuses a taken slug to avoid,
                # and which a hand-applied label can still produce.
                problems[f"two initiatives claim {INITIATIVE_LABEL}{slug}"].extend(owners)
        for slug, wearers in sorted(wearing.items()):
            if slug not in claimed:
                # A label naming no initiative on this board: a detached subtree
                # whose label was never cleaned up, or an initiative that is not
                # on the board at all. The board filter shows these as part of an
                # initiative that, as far as the board knows, does not exist.
                problems[
                    f"{INITIATIVE_LABEL}{slug} names no initiative on this board -- "
                    f"run `initiative reconcile`"
                ].extend(wearers)

        overlaps_found = []
        spans = iteration_spans(sprint_config)
        for index, (start, end) in enumerate(spans):
            for other_start, other_end in spans[index + 1:]:
                if other_start <= end and start <= other_end:
                    overlaps_found.append(f"{start}..{end} overlaps {other_start}..{other_end}")
        for line in overlaps_found:
            problems["sprints overlap -- `@current` is ambiguous"].append(line)

    def report(findings: dict[str, list[str]]) -> int:
        for rule, offenders in findings.items():
            print(f"\n{rule} ({len(offenders)}):")
            for offender in offenders:
                print(f"  {offender}")
        return sum(len(v) for v in findings.values())

    for rule, offenders in problems.items():
        print(f"\n{rule} ({len(offenders)}):")
        for offender in offenders:
            print(f"  {offender}")
    if notes:
        print("\nnotes -- reported, not failures:")
        noted = report(notes)
    else:
        noted = 0
    tail = f", {noted} note(s)" if noted else ""
    if not problems:
        print(f"\n{len(data)} item(s): no problems found{tail}")
        return 0
    print(f"\n{sum(len(v) for v in problems.values())} problem(s) across "
          f"{len(data)} item(s){tail}")
    return 1


def cmd_self_test(args) -> int:
    """Stand up a scratch project, exercise every command, tear it down.

    Written because the case-sensitivity bug that made every cycle time null
    could only be caught by real data: the transitions were in the timeline and
    the comparison silently missed them. A unit test with a fixture would have
    reproduced the same wrong assumption.

    Everything created here is deleted in a `finally`, including after a failed
    assertion -- an aborted run must not leave a scratch project behind.
    """
    import time

    project: int | None = None
    issues: list[int] = []
    stamp = args.stamp or "self-test"
    try:
        created = json.loads(gh(["project", "create", "--owner", args.owner,
                                 "--title", f"gh-agile {stamp}", "--format", "json"]))
        project = created["number"]
        print(f"  scratch project #{project} created")

        # `_config` is set by apply_defaults for a real invocation; the
        # namespaces built here are synthetic and have to carry it too.
        setup = argparse.Namespace(owner=args.owner, project=project, spec=None,
                                   repo=args.repo, _config=args._config)
        cmd_setup(setup)

        common = {"owner": args.owner, "project": project, "repo": args.repo,
                  "intent": "self-test", "acceptance": "self-test", "_config": args._config}
        # Each issue is recorded the moment it exists, not after both do. The
        # earlier version assigned the list once at the end, so a failure
        # between the two -- a rate limit, say -- left the epic behind with
        # nothing tracking it for teardown. Found by `sync`, which reported an
        # orphaned "guide epic" nobody had noticed.
        cmd_epic(argparse.Namespace(title=f"{stamp} epic", key=None, **common))
        epic_number = _latest_issue(args.repo)
        issues.append(epic_number)
        cmd_story(argparse.Namespace(title=f"{stamp} story", epic=epic_number, points=3,
                                     priority="high", status="Todo", key=None, **common))
        story_number = _latest_issue(args.repo)
        issues.append(story_number)

        # Drive the story through a real transition, then wait for the timeline
        # to catch up -- it is eventually consistent, measured at ~75s.
        # Polled, not read once. `item-list` is eventually consistent like the
        # rest of the API, and a story added a second ago is sometimes not in it
        # yet -- which surfaced as a bare StopIteration traceback after teardown
        # had already run, with nothing saying what was missing.
        item = None
        for _attempt in range(10):
            item = next(
                (i for i in json.loads(gh(["project", "item-list", str(project), "--owner",
                                           args.owner, "--format", "json"]))["items"]
                 if (i.get("content") or {}).get("number") == story_number),
                None,
            )
            if item:
                break
            time.sleep(3)
        if not item:
            sys.exit(f"story #{story_number} never appeared on project #{project} after 30s")
        for index, status in enumerate((CYCLE_START, CYCLE_END)):
            if index:
                # Separated deliberately. Two transitions a second apart risk
                # arriving as one event, and a cycle time of zero seconds is
                # indistinguishable from a broken join.
                time.sleep(args.gap)
            set_field(args.owner, project, item["id"], "Status", status)
            print(f"  story -> {status}")

        # Wait for everything that is then asserted on, which used to be two of
        # the three timeline facts: the loop polled for started_at and done_at
        # while the checks below also require added_to_board_at. Measured
        # 2026-08-21 -- one run reported "[FAIL] the story reached the board" and
        # an immediate re-run of the same code passed, because
        # AddedToProjectV2Event had not propagated yet. A flaky assertion in the
        # one test that touches real GitHub is worse than no assertion: it gets
        # read as a regression and costs an afternoon proving it is not.
        deadline = time.time() + args.timeout
        started = None
        while time.time() < deadline:
            rows_now = rows(args.owner, project, with_history=True)
            story = next(r for r in rows_now if r["number"] == story_number)
            if story["started_at"] and story["done_at"] and story["added_to_board_at"]:
                started = story
                break
            time.sleep(10)

        checks = {
            "the story reached the board": bool(story["added_to_board_at"]),
            "story points round-tripped": story.get("field_story_points") == 3,
            "priority round-tripped": str(story.get("field_priority", "")).casefold() == "high",
            "the epic is the story's parent": story["epic_number"] == epic_number,
            "the timeline yielded a cycle time": bool(started),
        }
        for name, ok in checks.items():
            print(f"  [{'ok' if ok else 'FAIL'}] {name}")
        if not checks["the timeline yielded a cycle time"]:
            print(f"       (no status history within {args.timeout}s. Timeline lag is "
                  f"variable and has\n        exceeded 420s; this is more often GitHub "
                  f"being slow than a real failure.\n        Re-run, or raise --timeout, "
                  f"before believing it. The parsing itself is\n        covered offline by "
                  f"tests/test_history.py.)")
        return 0 if all(checks.values()) else 1
    finally:
        for number in issues:
            subprocess.run(["gh", "issue", "delete", str(number), "--repo", args.repo, "--yes"],
                           capture_output=True)
        if project:
            subprocess.run(["gh", "project", "delete", str(project), "--owner", args.owner],
                           capture_output=True)
        print(f"  torn down: project #{project}, issues {issues}")


def _latest_issue(repo: str) -> int:
    listed = json.loads(gh(["issue", "list", "--repo", repo, "--limit", "1",
                            "--state", "all", "--json", "number"]))
    return listed[0]["number"]


def field_help(rows: list[tuple[str, str, str, str]]) -> str:
    """A table of argument, type, obligation, description -- mandatory first.

    argparse lists arguments in declaration order and says nothing about what a
    field means, so the obligation and the description have to be written out.
    """
    order = {"required": 0, "optional": 1}
    rows = sorted(rows, key=lambda r: order.get(r[2], 2))
    width = [max(len(r[i]) for r in rows) for i in range(3)]
    lines = ["", "fields:"]
    for name, kind, need, description in rows:
        lines.append(
            f"  {name:<{width[0]}}  {kind:<{width[1]}}  {need:<{width[2]}}  {description}"
        )
    return "\n".join(lines)



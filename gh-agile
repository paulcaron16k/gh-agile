def add_global_flags(parser: argparse.ArgumentParser, *, default) -> None:
    """`--owner`, `--project` and `--config`: which project, wherever they are typed.

    `--owner` has no default, so "not given" is distinguishable from an explicit
    `@me`. Left unset it comes from `project.owner` in the profile and falls
    back to the caller; `@me` always means the caller, even when the profile
    names someone else.
    """
    parser.add_argument("--owner", default=default,
                        help="project owner; defaults to project.owner in the "
                             'profile, then to you. "@me" forces you')
    parser.add_argument("--project", type=int, default=default,
                        help="project number; defaults to project.number in the profile")
    parser.add_argument("--config", default=default,
                        help=f"profile path; searched: {', '.join(CONFIG_PATHS)}")


def inherit_global_flags(parser: argparse.ArgumentParser) -> None:
    """Accept the global flags after the subcommand as well as before it.

    Measured: `gh agile board list --project 19` was `unrecognized arguments:
    --project 19`, because argparse only parses a parser's own options before
    its subcommand. `gh project list --owner X` puts the flag after the verb,
    so that is where people type it (#201).

    **`default=SUPPRESS` on every copy below the top**, which is what makes this
    safe. A subparser writes all of its defaults into the shared namespace, so
    an ordinary `None` there would overwrite `--project 4` typed before the
    subcommand. Suppressed, a flag that was not typed at that level writes
    nothing, and the one that was typed wins wherever it was.
    """
    for action in parser._actions:
        if not isinstance(action, argparse._SubParsersAction):
            continue
        for child in action.choices.values():
            add_global_flags(child, default=argparse.SUPPRESS)
            inherit_global_flags(child)


#: The work-item types whose title used to be a positional: `epic "Title"`.
WORK_ITEM_GROUPS = ("initiative", "epic", "story", "task")

#: Every verb `gh issue` and `gh pr` have. **Never read as a title**, whether or
#: not this tool has the verb yet: suggesting `epic create -t list` for
#: `epic list` would be ZMBNI-185 again, offered as advice.
GH_VERBS = frozenset({
    "create", "list", "status", "view", "edit", "close", "reopen", "comment",
    "delete", "develop", "lock", "unlock", "pin", "unpin", "transfer", "checkout",
    "checks", "diff", "merge", "ready", "review", "revert", "update-branch",
    "move", "reconcile",
})

#: Top-level commands that moved under `issue`: the new verb, and the flag whose
#: value became a positional. `move ISSUE --status S` is `issue move ISSUE S`;
#: `set --issue N` is `issue edit N`; `fix --id N` is `issue reconcile N`.
MOVED_UNDER_ISSUE = {"move": ("move", "--status"), "set": ("edit", "--issue"),
                     "fix": ("reconcile", "--id")}

#: `move`'s flags that take a value, so the issue is not mistaken for one.
MOVE_VALUE_FLAGS = ("--evidence", "--evidence-file", "--add-assignee", "-R", "--repo")

#: Global flags that take a value, so the command can be found after them.
GLOBAL_VALUE_FLAGS = ("--owner", "--project", "--config")


def retired_spelling(argv: list[str]) -> str | None:
    """The replacement for a spelling AGILE-200 retired, or None.

    **Every retired spelling already fails at argument parsing** -- nothing is
    reinterpreted as something else -- which is safe and not yet kind: argparse
    says `invalid choice: 'My title'`, and leaves the person to work out that the
    title wants `create -t`. `main` is the release (README, *Versions*), so the
    break reaches every install at its next upgrade, and the error has to name
    the new spelling rather than wait for the release note (#202; the table is
    #206's to finish and, a release later, to remove).

    Rebuilt from what was typed, so the suggestion runs as given.
    """
    import shlex

    rest = list(argv)
    head = []
    while rest and rest[0].startswith("-"):
        flag = rest.pop(0)
        head.append(flag)
        if flag in GLOBAL_VALUE_FLAGS and rest:
            head.append(rest.pop(0))
    if not rest:
        return None
    command, tail = rest[0], rest[1:]
    if command in WORK_ITEM_GROUPS:
        if command == "story" and tail[:1] == ["create"]:
            # `--status` went from `story create` in #202, so a correct verb and
            # title can still carry it.
            status, after = _pull_flag(tail[1:], "--status")
            if status is not None:
                if after and not after[0].startswith("-"):
                    after = ["-t", *after]
                new = shlex.join(["gh", "agile", *head, "story", "create", *after])
                return (f"`story create` has no --status: a story starts in Todo.\n  {new}"
                        + _status_after_create(status))
        if tail and tail[0] == "create" and len(tail) > 1 and not tail[1].startswith("-"):
            # `initiative create "Title"`: the verb was right, the title was not.
            title, after, was = tail[1], tail[2:], f"{command} create TITLE"
        elif tail and tail[0] not in GH_VERBS and not tail[0].startswith("-"):
            # `epic "Title"`: no verb at all.
            title, after, was = tail[0], tail[1:], f"{command} TITLE"
        else:
            return None
        status, after = _pull_flag(after, "--status")
        new = shlex.join(["gh", "agile", *head, command, "create", "-t", title, *after])
        hint = (f"`{was}` is now `{command} create -t TITLE`, as "
                f"`gh issue create -t` takes it:\n  {new}")
        return hint + _status_after_create(status)
    if command == "move" and "--close" in tail:
        # `move X --status Done --close [--not-planned]` is `issue close X`, the
        # way `gh issue close -r` spells the reason.
        _status, after = _pull_flag(tail, "--status")
        abandoned = "--not-planned" in after
        after = [t for t in after if t not in ("--close", "--not-planned")]
        issue = _first_positional(after)
        reason = ["-r", "not planned"] if abandoned else []
        new = shlex.join(["gh", "agile", *head, "issue", "close",
                          *([issue] if issue else []), *reason, *after])
        return (f"`move --close` is now `issue close`, as `gh issue close` takes it, "
                f"with the reason as -r:\n  {new}")
    if command in MOVED_UNDER_ISSUE:
        verb, flag = MOVED_UNDER_ISSUE[command]
        value, after = _pull_flag(tail, flag)
        if command == "move":
            # The issue was already positional; the status joins it.
            first = _first_positional(after)
            positionals = [p for p in (first, value) if p is not None]
        else:
            positionals = [value] if value is not None else []
        new = shlex.join(["gh", "agile", *head, "issue", verb, *positionals, *after])
        return (f"`{command}` is now `issue {verb}`, with the issue first as every "
                f"targeted `gh` command takes it:\n  {new}")
    return None


def _first_positional(tokens: list[str]) -> str | None:
    """Remove and return `move`'s issue: the first token that is no flag's value.

    Every flag's value is skipped, or `--evidence "text" 12` would read the
    evidence as the issue.
    """
    index = 0
    while index < len(tokens):
        token = tokens[index]
        if token in MOVE_VALUE_FLAGS or token in GLOBAL_VALUE_FLAGS:
            index += 2
            continue
        if not token.startswith("-"):
            return tokens.pop(index)
        index += 1
    return None


def _status_after_create(status: str | None) -> str:
    """The second command, when a retired `--status` asked to start the work."""
    if status is None or same_status(status, "Todo"):
        return ""
    return ("\n  then move it, which asks for what that status needs and claims the issue "
            "when work starts:\n"
            f"  gh agile issue move <number> {shlex_quote(canonical_status(status))}")


def shlex_quote(text: str) -> str:
    import shlex

    return shlex.quote(text)


def _pull_flag(tokens: list[str], flag: str) -> tuple[str | None, list[str]]:
    """`flag`'s value, and the tokens without it: `--flag v` or `--flag=v`."""
    rest = list(tokens)
    for index, token in enumerate(rest):
        if token == flag and index + 1 < len(rest):
            value = rest[index + 1]
            del rest[index:index + 2]
            return value, rest
        if token.startswith(flag + "="):
            del rest[index]
            return token[len(flag) + 1:], rest
    return None, rest


def main() -> int:
    require_interpreter()
    retired = retired_spelling(sys.argv[1:])
    if retired:
        print(f"gh agile: {retired}", file=sys.stderr)
        return 2
    args = build_parser().parse_args()
    # The one place a `MissingScope` is turned back into an exit. It travels
    # from `gh` untouched precisely because nothing on the way catches it, so
    # the conversion belongs here and nowhere else.
    try:
        apply_defaults(args)
        return args.func(args)
    except MissingScope as exc:
        sys.exit(str(exc))


def caller_login() -> str:
    """The authenticated user's login, from `gh`."""
    return json.loads(gh(["api", "user"]))["login"]


def resolve_owner(args, config: dict) -> None:
    """Decide whose project this is: the flag, then the profile, then the caller.

    The caller used to be the only answer. `--owner` defaulted to `@me`, and the
    profile recorded a project *number* and never whose project it was -- so
    `project.number: 4` meant "project 4 belonging to whoever typed this". For
    the owner that is invisibly correct, and it is why the gap survived this long.

    For anyone else it is wrong in two ways. Usually it resolves to nothing and
    the read-only commands -- `export`, `validate`, `sprint list`, `board list` --
    simply do not work, though the underlying GitHub read would have succeeded
    with project read access. Occasionally it resolves to an unrelated project 4
    of their own, and then `sync --adopt`, whose default `--limit` is 200, labels
    issues onto it. A number is not an identity without the account it belongs to.

    `--owner` still wins, because naming it is explicit. But an explicit owner
    that *disagrees* with the profile is refused for the same reason a
    disagreeing `--project` is: the profile in this directory describes one
    board, and its keys, boards and sprint cadence belong to that board and not
    to whatever `--owner` points at. `self-test` is exempt, as it is for
    `--project`, because it builds its own scratch project.
    """
    declared = (config.get("project") or {}).get("owner")
    given = getattr(args, "owner", None)

    if given is None:
        args.owner = declared or caller_login()
        return
    if given.strip().casefold() in ("@me", "me"):
        args.owner = caller_login()
        return

    args.owner = given
    if declared and given.casefold() != declared.casefold() and args.command != "self-test":
        sys.exit(
            f"--owner {given} does not match project.owner {declared!r} in "
            f"{find_config(getattr(args, 'config', None)) or 'the profile'}.\n"
            f"  The profile here configures {declared}'s project: its keys, boards and "
            f"sprint cadence\n  belong to that board, not to {given}'s.\n"
            f"  To work on {given}'s project, use that project's own profile -- or pass "
            f"--config."
        )


def missing_project_message(explicit: str | None) -> str:
    """No board to act on: say which of the two reasons it is.

    These were one sentence, and it was about the wrong thing entirely:

        no project None found for 'paulcaron16k' as either a user or an organization

    It named a project the caller never named, blamed the lookup when the profile
    was what was missing, and leaked a Python `None` into user-facing output --
    the tell that nothing had checked. Measured 2026-09-14; see #111.

    The sibling case in this same function already did it properly -- *"not inside
    a GitHub repository, and no --repo given"* -- so this is that shape: what is
    missing, and the ways out.
    """
    found = find_config(explicit)
    if found is not None:
        return (
            f"{found} names no project.number, and no --project was given.\n"
            f"  Create the board and record it in one step:\n\n"
            f"    gh agile project create --title \"Your board\"\n\n"
            f"  Or name an existing one outright:  --project <n> --owner <login>"
        )
    searched = "\n".join(f"      {c}" for c in CONFIG_PATHS)
    return (
        f"no profile found, and no --project was given, so there is no board to act "
        f"on.\n\n"
        f"  Searched, relative to the working directory:\n{searched}\n"
        f"  in {pathlib.Path.cwd()}\n\n"
        f"  The profile supplies --project, --owner and the repositories to sync, and it "
        f"is\n  found relative to the working directory, not next to the installed "
        f"extension.\n  `gh extension install` clones this repository, profile included, "
        f"into gh's\n  extension directory, and that copy is deliberately not read: it "
        f"configures\n  whichever repository was installed, so reading it would aim these "
        f"commands at\n  somebody else's board.\n\n"
        f"  Any one of:\n"
        f"    cd into a clone whose {CONFIG_PATH} names your project, or one carrying a\n"
        f"      config_from pointer to it\n"
        f"    pass --config path/to/agile.json\n"
        f"    name the board outright: --project <n> --owner <login>\n"
        f"    or, for a repository that has no board yet: gh agile project create"
    )


def apply_defaults(args) -> None:
    """Fill --project, --repo and --key from the profile and the working directory.

    Typing `--project 5 --repo owner/name` on every command is friction for the
    common case of one project and one repository, and friction is what makes
    people skip the tool and edit by hand.

    Precedence, most explicit first: the flag; then `--key`, which names a
    repository on its own; then the repository this is being run in; then the
    profile.
    """
    config = read_config(getattr(args, "config", None))
    args._config = config
    title_prefix_mode(config)   # reject an illegal value now, not at create time

    resolve_owner(args, config)

    declared = (config.get("project") or {}).get("number")
    if getattr(args, "project", None) is None and args.command != "self-test":
        if declared:
            args.project = declared
    elif declared and args.command != "self-test" and args.project != declared:
        # A project number that disagrees with the profile is almost always the
        # right flag typed in the wrong clone: the profile here describes a
        # different board, so the keys, boards and sprint settings about to be
        # used all belong to that other project. Refusing is cheaper than
        # writing this project's conventions onto that one.
        sys.exit(
            f"--project {args.project} does not match project.number {declared} in "
            f"{find_config(getattr(args, 'config', None)) or 'the profile'}.\n"
            f"  The profile here configures project #{declared}: its keys, boards and "
            f"sprint cadence.\n"
            f"  To work on #{args.project}, change to that project's main repository "
            f"(or a supporting repo carrying its config_from pointer)."
        )

    # Refused here rather than carried into a GraphQL variable. `--project` has no
    # argparse default, so "not given and not in the profile" left `args.project`
    # as None all the way to the query, where it surfaced as a project that could
    # not be found -- see `missing_project_message`.
    #
    # **Each command declares it on its own parser: `projectless=True`.** The
    # exemptions, and why each holds: `project` is the bootstrap -- `project
    # create` *writes* `project.number`, and its other subcommands only touch the
    # profile, so demanding a number would mean needing a board to record the
    # board. `key` lists or records a key in the profile and reaches the project
    # only for `shortDescription`, already guarded. `self-test` stands up its own
    # scratch project. Everything else is refused, including commands added
    # later, which is why this is an exemption and not a requirement.
    #
    # It was a set of top-level names. Under `issue move` and `epic list` the
    # top-level name no longer says what one subcommand needs (#202), and a
    # declaration beside the parser cannot name a command that does not exist.
    if args.project is None and not getattr(args, "projectless", False):
        sys.exit(missing_project_message(getattr(args, "config", None)))

    key = getattr(args, "key", None)
    repo = getattr(args, "repo", None)
    # **`needs_repo=True` on every parser that can touch an issue**, whether or
    # not it has a `--repo` flag. `set --issue 26` had none to attach to, so a
    # bare number could not be resolved even from inside its own repository, and
    # `plan` repeated it minutes after being written: it refuses with *run inside
    # one* from inside one, which reads like the caller's mistake.
    # `tests/test_plan_command.py` walks the parser for commands that take an
    # issue and lack the declaration.
    if repo is None and getattr(args, "needs_repo", False):
        if key and args.command not in ("key",):
            repo = repo_for_key(config, key)
            if not repo:
                sys.exit(f"no repository for key {key!r} in the profile")
        elif args.command == "sync":
            # **`sync` is the exception, and the exception is the feature.** Every
            # other command here acts on one issue in one repository, so the clone
            # you are standing in is the right guess. `sync` fills a board, and a
            # board may span repositories: `keys` is an ordered list for exactly
            # that, `issue_key` puts the key on the repository rather than the
            # project because a project can span them, and a scrum board slices
            # one team's work out of the shared board with `label:key:...`.
            #
            # Filling that in from the working directory made the documented
            # default -- every repository in the profile -- unreachable, so a team
            # responsible for several repositories could never get the other
            # repositories' issues onto their board. `sync` is the only way an
            # issue arrives on one at all, a project being a collection rather
            # than a filter, so there was no other route either.
            #
            # Left as None. `cmd_sync` sweeps the profile's repositories when it
            # is, and `--repo` or `--key` still narrows to one.
            repo = None
        else:
            repo = current_repo()
            if not repo:
                sys.exit(
                    "not inside a GitHub repository, and no --repo given. Run this from a "
                    "clone, or pass --repo owner/name"
                )
        args.repo = repo

    # The key an issue is created with: explicit, else the first for this repo.
    if hasattr(args, "key") and args.command in ("initiative", "epic", "story", "task"):
        available = keys_for_repo(config, args.repo) if args.repo else []
        if key:
            if available and key not in available:
                sys.exit(f"key {key!r} is not listed for {args.repo} in the profile")
        elif available:
            args.key = available[0]


if __name__ == "__main__":
    sys.exit(main())

#: Per-invocation caches. Without them `set_field` re-fetched the whole field
#: list *and* re-resolved the project id on every call -- three round trips to
#: set one number. Creating a dozen stories exhausted a 5000-point GraphQL
#: budget, which is how this was found: not by reading the code, by running out.
_PROJECT_IDS: dict[tuple[str, int], str] = {}
_FIELDS: dict[tuple[str, int], dict[str, dict]] = {}
_ITEMS: dict[tuple[str, int], list[dict]] = {}


def board_items(login: str, number: int, *, refresh: bool = False) -> list[dict]:
    """Every item on the board, fetched once per run.

    `set` fetched the whole list on every call, so restoring sixteen statuses in
    a loop meant sixteen full board reads and a second exhausted rate budget --
    the same defect as the field list, in a different place.
    """
    key = (login, number)
    if refresh or key not in _ITEMS:
        _title, nodes = paged_project_items(login, number, LEAN_ITEM_SELECTION)
        # Kept in the shape `gh project item-list` returned, because that is what
        # the callers read and the shape is not the interesting part. What
        # changed is the cost: `item-list -L 200` was 106 GraphQL points against
        # this query's 1, and the charge did not depend on the board having 25
        # items rather than 200. `field-list -L 50` was 102 against 1, and flat
        # regardless of -L.
        _ITEMS[key] = [
            {
                "id": node["id"],
                "content": None if not node.get("content") else {
                    "number": node["content"].get("number"),
                    "repository": (node["content"].get("repository") or {}).get("nameWithOwner"),
                    "type": node["content"].get("__typename"),
                },
            }
            for node in nodes
        ]
    return _ITEMS[key]


def same_repo(content_repo: str | None, repo: str) -> bool:
    """Whether an item's `content.repository` names `repo`.

    `gh project item-list` currently reports `owner/name` here, and older
    versions reported a bare name, so the owner is compared when both sides
    carry one and the trailing segment otherwise. Without the fallback this
    silently matches nothing on whichever `gh` disagrees, and matching nothing
    reads exactly like "not on the board".
    """
    if not content_repo:
        return False
    left, right = str(content_repo).casefold(), repo.casefold()
    if "/" in left and "/" in right:
        return left == right
    return left.rsplit("/", 1)[-1] == right.rsplit("/", 1)[-1]


def board_item_for(login: str, project: int, repo: str, issue: int) -> dict | None:
    """The project item for one issue, matched on repository **and** number.

    Matching on the number alone is wrong the moment a project spans
    repositories, which is a documented feature -- and each repository numbers
    its issues independently from 1, so two of them sharing a number is
    ordinary rather than unlucky.

    Both callers got this wrong in different ways. `set` resolved the repository
    and then discarded it; `move` kept it for the `gh issue` calls and still
    matched the item on the number, so a single `move B-12 --status Done
    --close` could set Status and stamp a `sprint:` label on an unrelated issue
    #12 in repository A while correctly closing #12 in repository B -- two
    repositories left inconsistent, exit code 0, output reporting success.

    A pull request sharing the number is skipped: `content.type` distinguishes
    them, and only issues are backlog items.
    """
    for item in board_items(login, project):
        content = item.get("content") or {}
        if content.get("number") != issue:
            continue
        if content.get("type", "Issue") != "Issue":
            continue
        if same_repo(content.get("repository"), repo):
            return item
    return None


def project_node(login: str, number: int, selection: str) -> dict | None:
    """`selection` inside `projectV2`, trying the user root and then the organization.

    Returns the `projectV2` node, or None when neither root has it.

    **The `SystemExit` catch is the whole point of this function existing.** `gh
    api graphql` exits non-zero when GraphQL returns an `errors` block, and asking
    the wrong root does exactly that -- HTTP 200, a null owner, and a NOT_FOUND
    error. Measured 2026-08-23:

        user(login: "github")               exit 1, "Could not resolve to a User"
        organization(login: "paulcaron16k")  exit 1, "Could not resolve to an Organization"

    `project_id` and `sprint_field` used to run this loop without the catch, so
    against an organization-owned project they died on the *first* root and never
    tried the second -- reporting "Could not resolve to a User with the login of
    'acme'" for a login that was perfectly correct, which sends the reader off to
    check their spelling. `fetch_items` had always caught it, which is why the
    read path worked and most of the write path did not.

    Three call sites shared that loop and two of them were wrong, so it lives in
    one place now and a fourth caller cannot forget the catch.
    """
    for root in ("user", "organization"):
        try:
            data = graphql(
                "query($login: String!, $number: Int!) { %s(login: $login) "
                "{ projectV2(number: $number) { %s } } }" % (root, selection),
                login=login, number=number,
            )
        except SystemExit:
            continue          # not this root; try the other
        node = ((data.get("data") or {}).get(root) or {}).get("projectV2")
        if node:
            return node
    return None


def project_id(login: str, number: int) -> str:
    if (login, number) in _PROJECT_IDS:
        return _PROJECT_IDS[(login, number)]
    node = project_node(login, number, "id")
    if not node:
        sys.exit(f"no project {number} found for {login!r} as either a user or an organization")
    _PROJECT_IDS[(login, number)] = node["id"]
    return _PROJECT_IDS[(login, number)]


#: **`dataType` is what a field is; `__typename` is only which interface it
#: implements, and the two are not the same question.** This selection used to
#: ask for `__typename` alone, on the reasoning that it separated the field
#: kinds the callers cared about and that selecting both would invite confusing
#: them. It separated three of them. `ProjectV2IterationField` and
#: `ProjectV2SingleSelectField` have typenames of their own -- and *everything
#: else* is `ProjectV2Field`: TEXT, NUMBER and DATE alike, 14 of the 17 fields
#: on this board. So the moment #175 added a DATE field the premise was gone,
#: silently, and `set_field` sent every date as `--text` (#182).
#:
#: Only `dataType` is selected now, so there is exactly one answer in this
#: record to *what kind of field is this* -- which is the honest way to settle
#: the confusion the old comment feared.
PROJECT_FIELDS_SELECTION = """
      fields(first: 50) {
        nodes {
          ... on ProjectV2FieldCommon { id name dataType }
          ... on ProjectV2SingleSelectField { options { id name } }
        }
      }
"""


def project_fields(login: str, number: int) -> list[dict]:
    """The project's fields: `id`, `name`, `data_type`, and `options` when it has any.

    Replaces `gh project field-list`, which cost 102 GraphQL points where this
    query costs 1 -- and whose cost did not move with `-L`, so there was no
    cheaper way to call it. It no longer returns that command's shape: its
    `type` key carried the `__typename`, which cannot tell a DATE field from a
    TEXT one, and `data_type` is the API's own answer to the question its one
    caller actually asks. See `PROJECT_FIELDS_SELECTION` and #182.

    The user-then-organization fallback, and the `SystemExit` catch that makes it
    work at all, live in `project_node`.
    """
    node = project_node(login, number, PROJECT_FIELDS_SELECTION)
    if node is None:
        sys.exit(f"no project {number} found for {login!r} as either a user or an organization")
    return [
        {
            "id": field["id"],
            "name": field["name"],
            "data_type": field["dataType"],
            **({"options": field["options"]} if field.get("options") else {}),
        }
        for field in node["fields"]["nodes"]
        # A field with no id is one this query selected nothing for -- every
        # concrete type implements ProjectV2FieldCommon today, so this is a guard
        # against a new one appearing, not a live case.
        if field.get("id")
    ]


def fields_of(login: str, number: int, *, refresh: bool = False) -> dict[str, dict]:
    """The project's fields, fetched once per run.

    `refresh=True` after `setup` creates one, which is the only moment the set
    changes under us.
    """
    key = (login, number)
    if refresh or key not in _FIELDS:
        _FIELDS[key] = {f["name"]: f for f in project_fields(login, number)}
    return _FIELDS[key]


#: The boards a new project gets, and why each earns a place. Written into the
#: profile so `setup` converges them on every later run -- one mechanism for
#: creating a board, not two.
STARTER_BOARDS = [
    {"name": "Sprint board", "type": "scrum"},
    {"name": "Backlog", "type": "backlog"},
    {"name": "Roadmap", "type": "roadmap"},
]

#: The cross-team view: every key's work in flight on one board, while each
#: team's scrum board slices its own out with `label:key:...`. It earns its
#: place only when the profile spans more than one key -- several repositories,
#: or a mono-repo carrying several. On one key it repeats the Sprint board and
#: the Backlog, and a starter board nobody uses teaches people to ignore boards.
#: Reported by the first adopter outside this repo, a one-key project (#211).
CROSS_TEAM_BOARD = {"name": "Engineering: all work", "type": "kanban"}


def starter_boards(config: dict) -> list[dict]:
    """The boards `init` records for this profile: the cross-team one only if it
    has more than one key to cross."""
    several = len(profile_keys(config)) > 1
    return STARTER_BOARDS + ([CROSS_TEAM_BOARD] if several else [])

#: A verdict for **every** built-in workflow, because three of six is not advice.
#:
#: `init` used to name the three worth turning on and say nothing about the rest.
#: Silence reads as an oversight, and the obvious repair -- turn on what is off
#: -- is pointless for two of these and actively harmful for one. So each is
#: named with a verdict and the reason for it:
#:
#:   enable       worth having on; the reason is what its absence costs
#:   never        worth having off, and the reason is measured
#:   issues-only  acts on pull-request items, which this board may hold none of
#:
#: One table, read by `init` at configuration time and `validate` when somebody
#: is chasing a symptom. Two lists giving different advice about one setting is
#: the drift #157 spent five stories on.
WORKFLOW_ADVICE = {
    # **Off on purpose, which is not the same as off.** It was `enable` until
    # #186, on the strength of a real cost -- #123 sat closed-and-In-Progress
    # for twenty-two hours and #138 repeated it on the next merge. What that
    # reasoning missed is what the workflow *cannot* do: it writes Status and
    # nothing else, so the issue it touches reads `Done` with no Evidence, no
    # closing `sprint:` label and no choice between completed and not planned.
    # A visibly unfinished issue costs one command; one that looks finished is
    # indistinguishable from work somebody actually did.
    "Item closed": (
        "by-hand",
        "it writes Status and nothing else -- no Evidence, no closing sprint: "
        "label, no completed-or-not-planned -- so an issue it touches reads Done "
        "while being unfinished. `issue move ISSUE Done --evidence` writes all "
        "three, and the post-merge hook asks for it at the terminal (#186)",
    ),
    "Item added to project": (
        "enable",
        "an item arriving by any other route has no Status, so it is in no "
        "column of any board",
    ),
    "Auto-add sub-issues to project": (
        "enable",
        "every story created under a boarded epic would need a `sync`",
    ),
    "Auto-close issue": (
        "never",
        "it races this tool's own close and wins: on the sandbox it closed the "
        "issue as COMPLETED before `move --not-planned` got there, and a "
        "close reason cannot be changed afterwards (#96)",
    ),
    "Pull request merged": (
        "issues-only",
        "it acts on pull-request items, which a board of issues does not hold",
    ),
    "Pull request linked to issue": (
        "issues-only",
        "it acts on pull-request items, which a board of issues does not hold",
    ),
}


def pull_request_items(login: str, project: int) -> int:
    """How many items on the board are pull requests, not issues.

    **Measured rather than assumed**, because the assumption expires. The
    pull-request workflows are pointless on a board of issues and would be
    useful on one that holds pull requests, so the advice has to be able to stop
    being true -- and a count in the output is how a reader sees that it was
    checked. Read through `board_items`, which is the cheap selection and cached
    per run.
    """
    return sum(1 for item in board_items(login, project)
               if (item.get("content") or {}).get("type") == "PullRequest")


def workflow_findings(state: dict[str, bool], pull_requests: int) -> list[str]:
    """Only what diverges: off and should be on, or on and should not be.

    **`validate` runs often, so it reports the actionable subset**; the whole
    table with every verdict belongs where somebody is configuring the project,
    which is `init`. Naming all six on every validate run would be six lines a
    reader learns to skip, and a check people skip is the failure this repo
    keeps finding.

    A workflow whose state could not be read is skipped rather than guessed at.
    """
    out = []
    for name, (verdict, why) in WORKFLOW_ADVICE.items():
        enabled = state.get(name)
        if enabled is None:
            continue
        if verdict == "enable" and not enabled:
            out.append(f"{name} is off -- {why}")
        elif verdict == "never" and enabled:
            out.append(f"{name} is ON and should not be -- {why}")
        elif verdict == "by-hand" and enabled:
            out.append(f"{name} is ON, and closing is finished by hand here -- {why}")
        elif verdict == "issues-only" and enabled and not pull_requests:
            out.append(f"{name} is on, and this board holds no pull-request "
                       f"items -- {why}")
    return out


def automation_notes(login: str, project: int) -> list[str]:
    """The advice `validate` prints, behind one name.

    One function rather than two calls at the call site, so the offline suite
    has a single seam to neutralise: `tests/conftest.py` stubs this by default,
    because `validate` is driven by a hundred tests that are about issues and
    have no business reaching the API for a project setting. The pieces --
    `project_workflows`, `pull_request_items`, `workflow_findings` -- are tested
    directly, and one test drives this wiring with those stubbed.
    """
    return workflow_findings(project_workflows(login, project),
                             pull_request_items(login, project))


def render_workflow_table(state: dict[str, bool], pull_requests: int) -> list[str]:
    """Every workflow with its verdict. For the moment of configuring a project."""
    verdict_mark = {"enable": "enable", "never": "never", "issues-only": "n/a here",
                    "by-hand": "by hand"}
    out = []
    for name, (verdict, why) in WORKFLOW_ADVICE.items():
        enabled = state.get(name)
        mark = "[on] " if enabled else "[off]" if enabled is not None else "[?]  "
        out.append(f"    {mark} {verdict_mark[verdict]:<8}  {name}")
        # **The reason is printed even when the state is already right**, for
        # everything except an `enable` that is on -- which needs no
        # explanation, it is working. `never` and `issues-only` always carry
        # theirs, because both are *off* on a correct board and a reader
        # scanning a list of things that are off would otherwise turn them on --
        # and `by-hand` most of all, since it is the one that was recommended
        # until #186 and looks exactly like an oversight.
        # That is the whole failure this table exists to prevent: `Auto-close
        # issue` looks exactly like a missing setting and is the one that cost
        # `--not-planned` its reason.
        if not (verdict == "enable" and enabled):
            out.append(f"             {why}")
    out.append(f"\n    Checked: this board holds {pull_requests} pull-request "
               f"item(s), which is why the last two carry no recommendation.")
    return out


WORKFLOWS_QUERY = """
query($login: String!, $number: Int!) {
  %s(login: $login) { projectV2(number: $number) {
    workflows(first: 20) { nodes { name enabled } } } }
}"""


def project_workflows(login: str, number: int) -> dict[str, bool]:
    """`{name: enabled}` for the project's built-in workflows, or {} if unreadable.

    **Read, because they can be.** The two are worth keeping apart: the schema
    exposes `workflows(first: 20)` with `name` and `enabled`, and has no
    mutation that writes one. So `init` cannot enable them and need not ask
    somebody to go and check which are on.

    Unreadable is not fatal. The steps still get printed, without their state:
    a checklist is more useful than an error at the end of a successful setup.
    """
    for root in ("user", "organization"):
        try:
            data = graphql(WORKFLOWS_QUERY % root, login=login, number=number)
        except (SystemExit, MissingScope):
            continue
        node = ((data.get("data") or {}).get(root) or {}).get("projectV2")
        if node:
            return {w["name"]: w["enabled"]
                    for w in (node.get("workflows") or {}).get("nodes") or []}
    return {}


def report_manual_steps(login: str, number: int) -> None:
    """Every workflow, its verdict and its state -- a rendering of one table.

    **The whole six belong here**, at the moment somebody is configuring the
    project and looking at that page. `validate` reports only what diverges,
    because it runs often and six lines every time is six lines a reader learns
    to skip.
    """
    state = project_workflows(login, number)
    print("\n  Project automation. The API can read these and cannot write them, "
          "so they are yours:")
    print(f"    https://github.com/users/{login}/projects/{number}/workflows\n")
    for line in render_workflow_table(state, pull_request_items(login, number)):
        print(line)
    if not state:
        print("    (could not read which are enabled; the verdicts above still "
              "hold)")
    print("\n  Then: gh agile validate")


def cmd_init(args) -> int:
    """From a fresh clone to a board somebody can use, in one command.

    The path existed and nobody was walked along it: write a profile, `setup`,
    `board create` once per board, then two web-UI toggles that nothing
    mentions until you read far enough. The knowledge was all here -- this
    assembles it into the order the tool already knew.

    **It refuses exactly what the rest of the tool refuses.** A key must match
    Jira's rules, a sprint cadence is a decision, and `issue_title_prefix` is
    written into every issue title. Those are flags, and a missing one is a
    refusal naming the flag rather than a default quietly chosen for you --
    the cost of guessing lands on somebody else later.

    **Flags rather than prompts, deliberately.** A prompt cannot run in a
    script, an agent or `check-guide`, so prompting would mean two paths and
    the scripted one would rot. Everything here is one command line.

    **Idempotent, because the first run gets interrupted.** Every step
    converges: `project create` refuses a second project, `setup` creates what
    is missing, `make_board` converges a view by name. A second run reports
    what is already right and changes nothing.

    It ends by naming the steps it cannot take, with their current state read
    back -- never by printing success over them.
    """
    config = args._config
    target = find_config(getattr(args, "config", None)) or pathlib.Path(CONFIG_PATH)
    declared = (config.get("project") or {}).get("number")

    # Every refusal first, before anything is created. An issue number is never
    # reused and a project is awkward to delete; a run that fails at step four
    # should not have written steps one to three.
    # `--project` adopts one that exists, and adopting needs no title. Getting
    # this wrong refused a run that had already answered the question, and
    # suggested the flag it had been given -- found by running the refusals.
    if not declared and not args.project and not args.title:
        sys.exit("--title is required to create a project.\n"
                 "  Or point at one that exists: gh agile --project <n> init ...")
    if args.key and (problem := key_problem(args.key)):
        sys.exit(f"--key {args.key!r}: {problem}")
    if not args.key and not profile_keys(config):
        sys.exit("--key is required: it labels every issue and prefixes every "
                 "title, and\n  a key must match Jira's rules, so this will not "
                 "guess one.\n    gh agile init --key AGILE --title \"My board\"")
    if args.sprint_template and args.sprint_template not in SPRINT_TEMPLATES:
        sys.exit(f"--sprint-template {args.sprint_template!r} is not one of: "
                 f"{', '.join(SPRINT_TEMPLATES)}")
    if not args.sprint_template and not (config.get("sprint") or {}).get("template"):
        sys.exit("--sprint-template is required: the cadence decides when every "
                 "sprint starts and\n  ends, and an unchosen one blocks `epic`, "
                 "`story` and `ensure`. One of: "
                 f"{', '.join(SPRINT_TEMPLATES)}")
    title_prefix_mode({"project": {"issue_title_prefix": args.title_prefix}})

    print(f"  profile: {target}")

    # 1. The project. `project create` writes number, owner, name and key.
    if declared:
        print(f"  project #{declared} already in the profile")
    elif args.project:
        config.setdefault("project", {}).update(
            {"number": args.project, "owner": args.owner, "name": args.title or ""})
        print(f"  project #{args.project} adopted")
    else:
        cmd_project(argparse.Namespace(
            project_command="create", title=args.title, key=args.key,
            repo=args.repo, owner=args.owner, project=None, force=False,
            # Passed through, not `None`. `project create` refuses without a
            # template unless the profile already has one, and `init` records
            # its own only in step 2 -- so a fresh clone was refused despite
            # `--sprint-template`, with a message telling the person to write the
            # profile by hand. Found by the first adopter outside this repo (#210).
            sprint_template=args.sprint_template, _config=config,
            config=getattr(args, "config", None)))
        config = read_config(getattr(args, "config", None))
        args._config = config

    # 2. The decisions, written down so nothing has to ask again.
    if args.key:
        entries = profile_keys(config)
        if not any(e.get("key") == args.key for e in entries):
            entries.append({"key": args.key, "name": args.title or args.key,
                            "repo": args.repo})
            config["keys"] = entries
        config.setdefault("project", {})["key"] = args.key
    config.setdefault("project", {})["issue_title_prefix"] = args.title_prefix
    if args.sprint_template:
        write_sprint_template(config, args.sprint_template, target)
    # Only ever added, never removed: a profile that already carries a board --
    # the cross-team one on a one-key project included -- keeps it.
    boards = starter_boards(config)
    for board in boards:
        if not any(b.get("name") == board["name"]
                   for b in (config.get("boards") or [])):
            config.setdefault("boards", []).append(dict(board))
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
    print(f"  keys, cadence and {len(boards)} board(s) recorded")

    # 3. Fields, labels and the boards -- `setup` converges all three, so there
    #    is one mechanism for creating a board rather than two.
    args.project = args.project or (config.get("project") or {}).get("number")
    cmd_setup(argparse.Namespace(spec=None, repo=args.repo, owner=args.owner,
                                 project=args.project, _config=config,
                                 config=getattr(args, "config", None)))

    # 4. What is left, and what it costs.
    report_manual_steps(args.owner, args.project)
    # **Named, not installed.** `init` takes flags rather than prompts so it runs
    # in a script, on an agent's behalf, in CI -- and writing an executable into
    # somebody's `.git/hooks` is not a thing to do on the strength of an
    # unrelated command. Saying it here is the offer; `gh agile hooks` is the
    # acceptance, and it is also how the repositories that will never run `init`
    # again get it.
    print("\n  One more, and it is per clone because git never brings hooks with "
          "a clone:")
    print("    gh agile hooks     # `git pull` then names what a merge left "
          "unfinished")
    return 0


def cmd_setup(args) -> int:
    """Create the project's fields and labels, converging rather than duplicating.

    Idempotent because it will be run again -- after a field is added to the
    spec, after someone deletes one by hand. `gh project field-create` happily
    creates a second field with the same name, so existence is checked first.
    """
    spec = json.loads(pathlib.Path(args.spec).read_text()) if args.spec else DEFAULT_SPEC
    existing = fields_of(args.owner, args.project)
    pid = project_id(args.owner, args.project)

    for field in spec.get("fields", []):
        name, kind = field["name"], field["type"]
        if name in existing:
            added = reconcile_options(pid, existing[name], field.get("options") or [])
            if added:
                existing = fields_of(args.owner, args.project, refresh=True)
            print(f"  field {name!r} exists" + (f", added option(s) {added}" if added else ""))
            continue
        if kind in ("TEXT", "SINGLE_SELECT", "DATE", "NUMBER"):
            cmd = ["project", "field-create", str(args.project), "--owner", args.owner,
                   "--name", name, "--data-type", kind]
            if field.get("options"):
                cmd += ["--single-select-options", ",".join(field["options"])]
            gh(cmd)
        else:
            # ITERATION and MULTI_SELECT have no CLI route; the mutation does.
            graphql(
                "mutation($p: ID!, $n: String!) { createProjectV2Field(input: "
                "{projectId: $p, dataType: %s, name: $n}) "
                "{ projectV2Field { ... on ProjectV2IterationField { id } "
                "... on ProjectV2Field { id } } } }" % kind,
                p=pid, n=name,
            )
        existing = fields_of(args.owner, args.project, refresh=True)
        print(f"  field {name!r} created")

    # Cadence, converged like everything else: the profile declares it, the
    # field is made to match. Iterations are re-sent unchanged, so existing
    # sprints keep their dates -- only sprints created afterwards use the new
    # duration.
    settings = sprint_settings(args._config)
    field = fields_of(args.owner, args.project).get("Sprint")
    if field:
        current = sprint_field(args.owner, args.project)["configuration"]
        # Only `duration` converges. `startDay` is not settable through the
        # API -- the configuration input accepts startDate, duration and
        # iterations and nothing else, and GitHub does not derive startDay from
        # a startDate either: sending a Monday left it reporting Sunday. It only
        # affects what the web UI suggests, so the profile's `start_day` governs
        # what this tool actually does, which is align the sprints it creates.
        if current["duration"] != settings["cadence_days"]:
            saved = sprint_assignments(args.owner, args.project)
            require_graphql_budget(len(saved), "changing the sprint cadence")
            iterations_now = current["completedIterations"] + current["iterations"]
            entries = ", ".join(
                f'{{startDate: "{i["startDate"]}", duration: {i["duration"]}, '
                f'title: {json.dumps(i["title"])}}}' for i in iterations_now
            )
            graphql(
                "mutation($f: ID!) { updateProjectV2Field(input: {fieldId: $f, "
                'iterationConfiguration: {startDate: "%s", duration: %d, iterations: [%s]}}) '
                "{ projectV2Field { ... on ProjectV2IterationField { id } } } }"
                % (iterations_now[0]["startDate"] if iterations_now else "2026-01-05",
                   settings["cadence_days"], entries),
                f=field["id"],
            )
            restore_assignments(args.owner, args.project, saved)
            heal_sprint_fields(args.owner, args.project)
            print(f"  Sprint cadence -> {settings['cadence_days']} days")
        else:
            print(f"  Sprint cadence in step ({settings['cadence_days']} days, "
                  f"new sprints aligned to {settings['start_day']})")

    for board in (spec.get("boards") or []) + (args._config.get("boards") or []):
        result = make_board(args.owner, args.project, board["name"], board["type"],
                            board.get("filter"))
        print(f"  board {result['name']!r} {result['action']} [{result['type']}]")

    if args.repo:
        for label in spec.get("labels", []):
            state = create_label(args.repo, label["name"], label["color"])
            print(f"  label {label['name']!r} {state}")
    return 0


def reconcile_options(pid: str, field: dict, wanted: list[str]) -> list[str]:
    """Add missing options to an existing single-select. Never removes any.

    The gap this closes: `setup` skipped a field that already existed, so
    `Status` kept GitHub's stock three options and the two the policy declares
    -- Blocked, In Review -- were legal in the validator and unsettable on the
    board. Removing an option is deliberately not done here: it would silently
    clear the field on every item holding it.
    """
    if not wanted or not field.get("options"):
        return []
    have = {o["name"].casefold() for o in field["options"]}
    missing = [w for w in wanted if w.casefold() not in have]
    if not missing:
        return []
    # **Every existing option must be sent back with its `id`.** The mutation
    # replaces the option set wholesale, and an option arriving without an id is
    # a *new* option -- which retires the old one and silently clears the field
    # on every item holding it. Learned the hard way: re-sending five options by
    # name alone wiped Status from 16 of 22 items on a live board, exactly the
    # harm the docstring below warns about.
    #
    # Inlined as GraphQL literals rather than passed as a variable: `gh api
    # graphql -F` sends every value as a scalar, so a list of input objects
    # arrives as a string and is rejected. `color` is an enum, hence unquoted.
    entries = [
        f'{{id: {json.dumps(o["id"])}, name: {json.dumps(o["name"])}, '
        f'color: {o.get("color", "GRAY") or "GRAY"}, '
        f'description: {json.dumps(o.get("description") or "")}}}'
        for o in field["options"]
    ]
    entries += [
        f'{{name: {json.dumps(n)}, color: GRAY, description: ""}}' for n in missing
    ]
    literal = ", ".join(entries)
    graphql(
        "mutation($f: ID!) { updateProjectV2Field(input: {fieldId: $f, "
        "singleSelectOptions: [%s]}) { projectV2Field { "
        "... on ProjectV2SingleSelectField { id } } } }" % literal,
        f=field["id"],
    )
    return missing


#: Labels confirmed to exist this run, so a sync adopting many issues does not
#: re-attempt the same `key:` label once per issue.
_LABELS_PRESENT: set[tuple[str, str]] = set()

#: What `gh label create` says when the label is already there. Measured, because
#: the whole point is to distinguish it from every other non-zero exit:
#:
#:     label with name "type:epic" already exists; use `--force` to update its
#:     colour and description
#:
#: Matching the message is unpleasant and it is the only signal available -- `gh`
#: exits 1 for this and 1 for a 403, and there is no --if-not-exists.
LABEL_EXISTS = "already exists"


def create_label(repo: str, name: str, color: str = "ededed") -> str:
    """Create one label, distinguishing "already there" from "not allowed".

    The bug this replaces read every non-zero exit as convergence:

        state = "created" if result.returncode == 0 else "already exists"

    So `setup` reported a clean run having created nothing when the caller
    lacked push access -- a permission failure printed as success, and then
    `epic` failing later somewhere confusing, because `gh issue create --label`
    rejects a label that was never made. `ensure_labels` was worse: it discarded
    the result entirely and checked nothing.

    Creating a label needs push (or triage) on the repository, which project
    write does not include -- so this is the first thing an external contributor
    or a read-only token hits.
    """
    key = (repo, name)
    if key in _LABELS_PRESENT:
        return "exists"
    result = subprocess.run(
        ["gh", "label", "create", name, "--repo", repo, "--color", color],
        capture_output=True, text=True,
    )
    _LABELS_PRESENT.add(key)
    if result.returncode == 0:
        return "created"
    if LABEL_EXISTS in result.stderr:
        return "exists"
    _LABELS_PRESENT.discard(key)   # it is not there, and we could not put it there
    reason = result.stderr.strip()
    # Two failures wear the same 403, and guessing between them is the mistake
    # this function exists to stop making. The first version of this message
    # asserted "you need push access" and then met a rate limit -- naming a cause
    # that was not the cause, which is exactly what `gh` does under load and what
    # docs/lessons.md warns about. So the reason is read before it is explained.
    if "rate limit" in reason.casefold():
        sys.exit(
            f"could not create label {name!r} in {repo}: the REST rate limit is exhausted.\n"
            f"  {reason}\n"
            f"  Labels are a REST call and REST has its own budget, separate from the\n"
            f"  GraphQL one. Both, and when they reset:  gh api rate_limit"
        )
    sys.exit(
        f"could not create label {name!r} in {repo}: {reason}\n"
        f"  Creating a label needs push access to {repo}. Project write does not\n"
        f"  include it, so this fails for a fork contributor and for a read-only token.\n"
        f"  Check with: gh repo view {repo} --json viewerPermission"
    )


def ensure_labels(repo: str, labels: list[str]) -> None:
    """Create any label that does not exist. `gh issue create` fails on an unknown one."""
    for label in labels:
        create_label(repo, label)


#: What `project.issue_title_prefix` may be set to, and what each produces for
#: epic 34 of key ZMBNI titled "Retention policy".
TITLE_PREFIX_MODES = {
    "off": "Retention policy",
    "key": "ZMBNI-34 Retention policy",
    "key+type": "ZMBNI-34 Epic: Retention policy",
}


def title_prefix_mode(config: dict) -> str:
    """Read and validate `project.issue_title_prefix`; default `off`.

    Validated for every command rather than only the two that write titles, so
    a typo in the profile is reported the first time anything runs and not on
    the day someone happens to create an epic. There is no nearest-legal guess:
    silently reading `key-type` as `key+type` would rename issues in a way the
    profile does not say, and titles are the one thing here that is awkward to
    walk back.
    """
    mode = (config.get("project") or {}).get("issue_title_prefix", "off")
    if mode is True:
        mode = "key"          # a plausible hand-edit, and unambiguous
    elif mode is False:
        mode = "off"
    if mode not in TITLE_PREFIX_MODES:
        options = "\n".join(
            f"    {name:10} {example}" for name, example in TITLE_PREFIX_MODES.items()
        )
        sys.exit(
            f"project.issue_title_prefix is {mode!r}, which is not one of the three "
            f"legal values.\n"
            f"  Fix the profile before running anything else -- this setting decides "
            f"what every\n  issue is called, so a guess here is a guess written into "
            f"issue titles:\n\n{options}\n\n"
            f"    gh agile project title-prefix --mode key\n\n"
            f"  Or edit `project.issue_title_prefix` in the profile by hand."
        )
    return mode


#: The three values a `type:` label may carry. One list, because
#: `strip_title_prefix` has to recognise exactly what `prefixed_title` writes.
ISSUE_TYPES = ("initiative", "epic", "story", "task", "bug")


def prefixed_title(mode: str, key: str, number: int, kind: str, title: str) -> str:
    """The title an issue carries once its number is known. `kind` is Epic/Story."""
    if mode == "off":
        return title
    label = f"{kind.capitalize()}: " if mode == "key+type" else ""
    return f"{key}-{number} {label}{title}"


def strip_title_prefix(title: str, key: str) -> str:
    """`title` with a prefix **this tool would have written** taken back off.

    Deliberately narrow, and that is the whole point of it. It removes
    `<KEY>-<digits> ` and then an optional `<Type>: ` drawn from `ISSUE_TYPES` --
    exactly the shapes `prefixed_title` produces, and nothing else. A title
    beginning `RFC-2119 keywords`, `CVE-2021-4034 write-up` or `ZMBNI-adjacent
    work` is somebody's own words and survives untouched, because a backfill that
    guesses at what looks like a prefix quietly destroys titles nobody can
    recover.

    The number is not checked against the issue's own. A title carrying another
    issue's id is wrong either way, and stripping it lets the sweep replace it
    with the right one -- where leaving it would produce `KEY-34 KEY-12 ...` on
    the next run. That double-prefixing is the exact trap the hand-written shell
    loop on the Zamboni board fell into.
    """
    head, sep, rest = title.partition(" ")
    if not sep or not head.startswith(f"{key}-") or not head[len(key) + 1:].isdigit():
        return title
    kind, sep2, tail = rest.partition(" ")
    if sep2 and kind.endswith(":") and kind[:-1].casefold() in ISSUE_TYPES:
        return tail
    return rest


def apply_title_prefix(config, repo: str, number: int, key, kind: str, title: str) -> str:
    """Rename a just-created issue to carry its key and number.

    Two calls rather than one because the number does not exist until the issue
    does. The rename is a real edit and shows up as a `RenamedTitleEvent` in the
    timeline, which the event export carries -- expected noise, not a defect,
    and the reason `off` is the default.
    """
    mode = title_prefix_mode(config)
    if mode == "off":
        return title
    new = prefixed_title(mode, key, number, kind, title)
    gh(["issue", "edit", str(number), "--repo", repo, "--title", new])
    return new


def create_issue(repo: str, title: str, body: str, labels: list[str]) -> tuple[int, str]:
    """Create an issue and return (number, node id)."""
    cmd = ["issue", "create", "--repo", repo, "--title", title, "--body", body]
    for label in labels:
        cmd += ["--label", label]
    url = gh(cmd).strip().splitlines()[-1]
    number = int(url.rsplit("/", 1)[-1])
    node = json.loads(gh(["issue", "view", str(number), "--repo", repo, "--json", "id"]))["id"]
    return number, node


def set_field(login: str, project: int, item_id: str, field_name: str, value) -> None:
    """Set one project field on one item, by field name.

    **The flag is chosen from the field's declared `data_type`, never guessed
    from the value.** It used to be both: `__typename` for the two kinds that
    have one of their own, and `isinstance(value, (int, float))` for NUMBER --
    with TEXT as the fallback for everything else. TEXT *was* everything else,
    until #175 added `Start date` and `Target date`, and a DATE field reports
    the same `ProjectV2Field` as a TEXT one. So every date this tool wrote went
    out as `--text`, which `gh` accepts and the API rejects, and `epic --start`
    had never once worked when #182 was filed.

    A guess from the value cannot be made correct here either: `3` is a legal
    NUMBER and a legal TEXT, and `"2026-09-01"` is a legal DATE and a legal
    TEXT. Only the field knows.

    Dates are parsed on the way through rather than passed on trust: `set
    --field "Target date" --value soon` reaches this function without ever
    meeting `--start`'s parser, and an unparseable date is refused at every
    other door.
    """
    field = fields_of(login, project).get(field_name)
    if not field:
        sys.exit(f"no field named {field_name!r} on project {project}; run `gh agile setup`")
    cmd = ["project", "item-edit", "--id", item_id,
           "--project-id", project_id(login, project), "--field-id", field["id"]]
    kind = field["data_type"]
    if kind == "ITERATION":
        cmd += ["--iteration-id", resolve_iteration(login, project, str(value))]
    elif kind == "SINGLE_SELECT":
        match = next(
            (o for o in field.get("options") or []
             if o["name"].casefold() == str(value).casefold()), None
        )
        if not match:
            sys.exit(f"{value!r} is not an option of {field_name!r}")
        cmd += ["--single-select-option-id", match["id"]]
    elif kind == "DATE":
        cmd += ["--date", iso_date(str(value), field_name)]
    elif kind == "NUMBER":
        cmd += ["--number", str(value)]
    else:
        cmd += ["--text", str(value)]
    gh(cmd)


def clear_field(login: str, project: int, item_id: str, field_name: str) -> None:
    """Remove one project field's value from one item.

    The only *unset* in the tool. `set_field` writes and `gh project item-edit`
    cannot clear -- it has no flag for an absent value -- so this is the
    `clearProjectV2ItemFieldValue` mutation written out.

    Needed because a value can be wrong to *have*, not merely wrong. An epic
    assigned a sprint before #115 barred it keeps that assignment for ever
    otherwise: `reconcile_sprints` only ever sets a field from labels, the
    automatic heal fills empty ones, and `restore_assignments` carries it
    across every iteration write.
    """
    field = fields_of(login, project).get(field_name)
    if not field:
        sys.exit(f"no field named {field_name!r} on project {project}; run `gh agile setup`")
    graphql(
        "mutation($p: ID!, $i: ID!, $f: ID!) { clearProjectV2ItemFieldValue(input: "
        "{projectId: $p, itemId: $i, fieldId: $f}) { projectV2Item { id } } }",
        p=project_id(login, project), i=item_id, f=field["id"],
    )



    sprint_new.add_argument("--title", help="defaults to 'Sprint <n>'")
    sprint.set_defaults(func=cmd_sprint)

    key = sub.add_parser("key", help="record a repository's key, e.g. ZMBNI, or list them")
    key.add_argument("--repo", help="owner/name")
    key.add_argument("--key", help="uppercase key; omit to list what is recorded")
    key.add_argument("--name", help="human-readable project name, written to shortDescription")

    key.set_defaults(func=cmd_key)

    move = sub.add_parser("move", help="change status, with the evidence that status requires",

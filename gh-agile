#!/usr/bin/env python3
"""gh-agile — export and validate a GitHub Projects v2 backlog.

A `gh` extension. Install with:

    gh extension install paulcaron16k/gh-agile

    gh agile setup     --project 1 [--spec agile.json] [--title "..."]
    gh agile epic      --project 1 --repo owner/repo "Title"
    gh agile story     --project 1 --repo owner/repo "Title" --epic 4 [--points 3]
    gh agile export    --project 1 [--csv]
    gh agile validate  --project 1
    gh agile self-test --repo owner/repo

The read side was built first on purpose: the export schema is the thing that
cannot be changed later without re-analysing everything already exported.

**Why this exists at all**, when `gh project item-list` already returns JSON:
that command gives a *snapshot*. `ProjectV2Item` exposes `createdAt`,
`updatedAt` and current field values — no history — so a snapshot cannot say
when an item entered `In progress`, which is every flow question worth asking.
The history lives on the **issue timeline** instead, as
`ProjectV2ItemStatusChangedEvent`. This tool runs both queries and joins them on
the issue node ID, which is the whole difference between a board dump and
something you can analyse the way you would a Jira export.

Standard library only, and it shells out to `gh` for authentication so no token
is ever read, stored, or passed here.
"""

from __future__ import annotations

import argparse
import csv
import json
import subprocess
import sys
from collections import defaultdict

#: Statuses this tool considers legal. Mirrors POLICY.md §2; keep them in step.
#:
#: Compared case-insensitively everywhere. GitHub's stock options are "Todo",
#: "In Progress", "Done" -- capital P -- and a project whose option casing
#: differs from this list is a naming quibble, not a data problem. Learned by
#: measuring: with an exact comparison every cycle time came back null while the
#: transitions were sitting right there in the timeline.
STATUSES = ("Todo", "In Progress", "Blocked", "In Review", "Done")

#: The status whose first entry starts the cycle-time clock, and the one that
#: stops it. Named rather than positional so reordering STATUSES cannot silently
#: change what every historical measurement means.
CYCLE_START, CYCLE_END = "In Progress", "Done"


def same_status(a: str | None, b: str | None) -> bool:
    return (a or "").strip().casefold() == (b or "").strip().casefold()


def gh(args: list[str], **kwargs) -> str:
    """Run `gh` and return stdout, failing loudly.

    Authentication is `gh`'s problem by design: this tool never sees a token.
    """
    result = subprocess.run(["gh", *args], capture_output=True, text=True, **kwargs)
    if result.returncode != 0:
        sys.exit(f"gh {' '.join(args[:2])} failed: {result.stderr.strip()}")
    return result.stdout


def graphql(query: str, **variables) -> dict:
    args = ["api", "graphql", "-f", f"query={query}"]
    for key, value in variables.items():
        # -F coerces numbers and booleans; -f would send everything as a string
        # and the schema rejects a String where it wants Int.
        args.extend(["-F", f"{key}={value}"])
    return json.loads(gh(args))


# The owner may be a user or an organization and the schema exposes projectV2 on
# both, but neither root reaches the other's projects -- so try user first and
# fall back rather than making the caller know which their account is.
ITEMS_QUERY = """
query($login: String!, $number: Int!, $cursor: String) {
  %s(login: $login) {
    projectV2(number: $number) {
      title
      items(first: 100, after: $cursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          id
          createdAt
          updatedAt
          isArchived
          fieldValues(first: 20) {
            nodes {
              __typename
              ... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2FieldCommon { name } } }
              ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2FieldCommon { name } } }
              ... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2FieldCommon { name } } }
              ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { name } } }
              ... on ProjectV2ItemFieldIterationValue { title startDate duration field { ... on ProjectV2FieldCommon { name } } }
            }
          }
          content {
            __typename
            ... on Issue {
              id number title url state stateReason createdAt closedAt
              labels(first: 20) { nodes { name } }
              assignees(first: 10) { nodes { login } }
              milestone { title }
              parent { number title }
              subIssuesSummary { total completed }
            }
            ... on PullRequest { id number title url state }
            ... on DraftIssue { id title }
          }
        }
      }
    }
  }
}"""

# Status history. Deliberately a separate query per issue: the timeline is not
# reachable from ProjectV2Item, which is the fact this whole tool exists for.
TIMELINE_QUERY = """
query($id: ID!) {
  node(id: $id) {
    ... on Issue {
      timelineItems(first: 100, itemTypes: [PROJECT_V2_ITEM_STATUS_CHANGED_EVENT, ADDED_TO_PROJECT_V2_EVENT]) {
        nodes {
          __typename
          ... on ProjectV2ItemStatusChangedEvent { createdAt status previousStatus }
          ... on AddedToProjectV2Event { createdAt }
        }
      }
    }
  }
}"""


def fetch_items(login: str, number: int) -> tuple[str, list[dict]]:
    """Every item on the board, following pagination."""
    for root in ("user", "organization"):
        cursor, nodes, title = None, [], None
        try:
            while True:
                data = graphql(
                    ITEMS_QUERY % root,
                    login=login,
                    number=number,
                    **({"cursor": cursor} if cursor else {}),
                )
                owner = (data.get("data") or {}).get(root)
                if not owner or not owner.get("projectV2"):
                    raise KeyError(root)
                project = owner["projectV2"]
                title = project["title"]
                page = project["items"]
                nodes.extend(page["nodes"])
                if not page["pageInfo"]["hasNextPage"]:
                    return title, nodes
                cursor = page["pageInfo"]["endCursor"]
        except (KeyError, TypeError, SystemExit):
            continue  # not this root; try the other
    sys.exit(f"no project {number} found for {login!r} as either a user or an organization")


def field_values(item: dict) -> dict[str, object]:
    """Flatten the field-value union into {field name: value}."""
    out: dict[str, object] = {}
    for node in item["fieldValues"]["nodes"]:
        field = node.get("field") or {}
        name = field.get("name")
        if not name:
            continue
        for key in ("text", "number", "date", "name", "title"):
            if node.get(key) is not None:
                out[name] = node[key]
                break
    return out


def history(issue_id: str) -> dict[str, object]:
    """First entry to CYCLE_START, arrival at CYCLE_END, and board entry."""
    data = graphql(TIMELINE_QUERY, id=issue_id)
    events = ((data.get("data") or {}).get("node") or {}).get("timelineItems", {}).get("nodes", [])
    started = done = added = None
    for event in events:
        kind = event.get("__typename")
        when = event.get("createdAt")
        if kind == "AddedToProjectV2Event":
            added = added or when
        elif kind == "ProjectV2ItemStatusChangedEvent":
            status = event.get("status")
            if same_status(status, CYCLE_START) and started is None:
                started = when
            elif same_status(status, CYCLE_END):
                done = when
    return {"added_to_board_at": added, "started_at": started, "done_at": done}


def days_between(start: str | None, end: str | None) -> float | None:
    if not (start and end):
        return None
    import datetime as dt

    fmt = "%Y-%m-%dT%H:%M:%SZ"
    delta = dt.datetime.strptime(end, fmt) - dt.datetime.strptime(start, fmt)
    return round(delta.total_seconds() / 86400, 2)


def rows(login: str, number: int, *, with_history: bool) -> list[dict]:
    _title, items = fetch_items(login, number)
    out = []
    for item in items:
        content = item.get("content") or {}
        if content.get("__typename") != "Issue":
            continue  # draft items and pull requests are not backlog items
        fields = field_values(item)
        row = {
            "number": content["number"],
            "title": content["title"],
            "url": content["url"],
            "state": content["state"],
            "state_reason": content.get("stateReason") or "",
            "labels": ";".join(n["name"] for n in content["labels"]["nodes"]),
            "assignees": ";".join(n["login"] for n in content["assignees"]["nodes"]),
            "milestone": (content.get("milestone") or {}).get("title") or "",
            "epic_number": (content.get("parent") or {}).get("number") or "",
            "epic_title": (content.get("parent") or {}).get("title") or "",
            "sub_issues_total": (content.get("subIssuesSummary") or {}).get("total") or 0,
            "sub_issues_done": (content.get("subIssuesSummary") or {}).get("completed") or 0,
            "created_at": content["createdAt"],
            "closed_at": content.get("closedAt") or "",
            "archived": item["isArchived"],
        }
        for name, value in fields.items():
            row[f"field_{name.lower().replace(' ', '_')}"] = value
        if with_history:
            hist = history(content["id"])
            row.update(hist)
            row["cycle_time_days"] = days_between(hist["started_at"], hist["done_at"])
            row["lead_time_days"] = days_between(hist["added_to_board_at"], hist["done_at"])
        out.append(row)
    return out


#: The board this tool creates when asked to set one up. Statuses match
#: STATUSES; the rest carry the Gold model's names so the export lands in
#: `agile_issues` without a translation step. See GOLD_MODEL.md.
DEFAULT_SPEC = {
    "fields": [
        {"name": "Story Points", "type": "NUMBER"},
        {"name": "Priority", "type": "SINGLE_SELECT",
         "options": ["lowest", "low", "medium", "high", "highest"]},
    ],
    "labels": [
        {"name": "type:epic", "color": "6f42c1"},
        {"name": "type:story", "color": "0e8a16"},
        {"name": "type:bug", "color": "d73a4a"},
    ],
}


#: Per-invocation caches. Without them `set_field` re-fetched the whole field
#: list *and* re-resolved the project id on every call -- three round trips to
#: set one number. Creating a dozen stories exhausted a 5000-point GraphQL
#: budget, which is how this was found: not by reading the code, by running out.
_PROJECT_IDS: dict[tuple[str, int], str] = {}
_FIELDS: dict[tuple[str, int], dict[str, dict]] = {}


def project_id(login: str, number: int) -> str:
    if (login, number) in _PROJECT_IDS:
        return _PROJECT_IDS[(login, number)]
    for root in ("user", "organization"):
        data = graphql(
            "query($login: String!, $number: Int!) { %s(login: $login) "
            "{ projectV2(number: $number) { id } } }" % root,
            login=login, number=number,
        )
        owner = (data.get("data") or {}).get(root)
        if owner and owner.get("projectV2"):
            _PROJECT_IDS[(login, number)] = owner["projectV2"]["id"]
            return _PROJECT_IDS[(login, number)]
    sys.exit(f"no project {number} for {login!r}")


def fields_of(login: str, number: int, *, refresh: bool = False) -> dict[str, dict]:
    """The project's fields, fetched once per run.

    `refresh=True` after `setup` creates one, which is the only moment the set
    changes under us.
    """
    key = (login, number)
    if refresh or key not in _FIELDS:
        raw = json.loads(gh([
            "project", "field-list", str(number), "--owner", login, "--format", "json", "-L", "50",
        ]))
        _FIELDS[key] = {f["name"]: f for f in raw["fields"]}
    return _FIELDS[key]


def cmd_setup(args) -> int:
    """Create the project's fields and labels, converging rather than duplicating.

    Idempotent because it will be run again -- after a field is added to the
    spec, after someone deletes one by hand. `gh project field-create` happily
    creates a second field with the same name, so existence is checked first.
    """
    spec = json.loads(open(args.spec).read()) if args.spec else DEFAULT_SPEC
    existing = fields_of(args.owner, args.project)
    for field in spec.get("fields", []):
        if field["name"] in existing:
            print(f"  field {field['name']!r} already exists")
            continue
        cmd = ["project", "field-create", str(args.project), "--owner", args.owner,
               "--name", field["name"], "--data-type", field["type"]]
        if field.get("options"):
            cmd += ["--single-select-options", ",".join(field["options"])]
        gh(cmd)
        fields_of(args.owner, args.project, refresh=True)
        print(f"  field {field['name']!r} created")

    if args.repo:
        for label in spec.get("labels", []):
            result = subprocess.run(
                ["gh", "label", "create", label["name"], "--repo", args.repo,
                 "--color", label["color"]],
                capture_output=True, text=True,
            )
            # `gh label create` exits non-zero when the label exists, which is
            # convergence rather than failure -- so this is the one place a
            # non-zero exit is read rather than raised.
            state = "created" if result.returncode == 0 else "already exists"
            print(f"  label {label['name']!r} {state}")
    return 0


def create_issue(repo: str, title: str, body: str, labels: list[str]) -> tuple[int, str]:
    """Create an issue and return (number, node id)."""
    cmd = ["issue", "create", "--repo", repo, "--title", title, "--body", body]
    for label in labels:
        cmd += ["--label", label]
    url = gh(cmd).strip().splitlines()[-1]
    number = int(url.rsplit("/", 1)[-1])
    node = json.loads(gh(["issue", "view", str(number), "--repo", repo, "--json", "id"]))["id"]
    return number, node


def set_field(login: str, project: int, item_id: str, field_name: str, value) -> None:
    """Set one project field on one item, by field name."""
    field = fields_of(login, project).get(field_name)
    if not field:
        sys.exit(f"no field named {field_name!r} on project {project}; run `gh agile setup`")
    cmd = ["project", "item-edit", "--id", item_id,
           "--project-id", project_id(login, project), "--field-id", field["id"]]
    if field.get("options"):
        match = next(
            (o for o in field["options"] if o["name"].casefold() == str(value).casefold()), None
        )
        if not match:
            sys.exit(f"{value!r} is not an option of {field_name!r}")
        cmd += ["--single-select-option-id", match["id"]]
    elif field["type"] == "ProjectV2Field" and isinstance(value, (int, float)):
        cmd += ["--number", str(value)]
    else:
        cmd += ["--text", str(value)]
    gh(cmd)


BODY_TEMPLATE = """## Intent
{intent}

## Acceptance
{acceptance}

## Evidence
"""


def add_to_project(login: str, project: int, url: str) -> str:
    out = json.loads(gh(["project", "item-add", str(project), "--owner", login,
                         "--url", url, "--format", "json"]))
    return out["id"]


def cmd_epic(args) -> int:
    number, _node = create_issue(
        args.repo, args.title,
        BODY_TEMPLATE.format(intent=args.intent or "_TBD_", acceptance=args.acceptance or "_TBD_"),
        ["type:epic"],
    )
    url = f"https://github.com/{args.repo}/issues/{number}"
    item = add_to_project(args.owner, args.project, url)
    set_field(args.owner, args.project, item, "Status", "Todo")
    print(f"  epic #{number}: {args.title}")
    print(f"  {url}")
    return 0


def cmd_story(args) -> int:
    """Create a story, attach it to its epic, and set its fields -- in one call.

    One call because the multi-step version is where hand-editing goes wrong:
    an issue created now and attached to its epic later is an orphan in every
    roll-up run in between, and nothing complains. POLICY.md §3.
    """
    number, node = create_issue(
        args.repo, args.title,
        BODY_TEMPLATE.format(intent=args.intent or "_TBD_", acceptance=args.acceptance or "_TBD_"),
        ["type:story"],
    )
    url = f"https://github.com/{args.repo}/issues/{number}"

    parent = json.loads(gh(["issue", "view", str(args.epic), "--repo", args.repo, "--json", "id"]))
    graphql(
        "mutation($parent: ID!, $child: ID!) { addSubIssue(input: "
        "{issueId: $parent, subIssueId: $child}) { subIssue { number } } }",
        parent=parent["id"], child=node,
    )

    item = add_to_project(args.owner, args.project, url)
    set_field(args.owner, args.project, item, "Status", args.status)
    if args.points is not None:
        set_field(args.owner, args.project, item, "Story Points", args.points)
    if args.priority:
        set_field(args.owner, args.project, item, "Priority", args.priority)
    print(f"  story #{number} under epic #{args.epic}: {args.title}")
    print(f"  {url}")
    return 0


def cmd_set(args) -> int:
    """Set a field on an issue already on the board.

    The gap the first real repair found: `story` sets fields at creation and
    nothing could set them afterwards, so a half-created item -- a rate limit
    hit between two field writes -- could only be fixed by hand, which is what
    this tool exists to avoid.
    """
    items = json.loads(gh(["project", "item-list", str(args.project), "--owner", args.owner,
                           "--format", "json", "-L", "200"]))["items"]
    item = next((i for i in items if (i.get("content") or {}).get("number") == args.issue), None)
    if not item:
        sys.exit(f"issue #{args.issue} is not on project {args.project}")
    value = args.value
    if args.number is not None:
        value = args.number
    set_field(args.owner, args.project, item["id"], args.field, value)
    print(f"  #{args.issue} {args.field} = {value}")
    return 0


def cmd_export(args) -> int:
    data = rows(args.owner, args.project, with_history=not args.no_history)
    if args.csv:
        if not data:
            return 0
        columns: list[str] = []
        for row in data:  # union of keys, first-seen order: fields vary per item
            columns.extend(k for k in row if k not in columns)
        writer = csv.DictWriter(sys.stdout, fieldnames=columns, extrasaction="ignore")
        writer.writeheader()
        writer.writerows(data)
    else:
        json.dump(data, sys.stdout, indent=2)
        sys.stdout.write("\n")
    return 0


def cmd_validate(args) -> int:
    """The conventions a machine can check. POLICY.md §3."""
    data = rows(args.owner, args.project, with_history=False)
    problems: dict[str, list[str]] = defaultdict(list)

    for row in data:
        ident = f"#{row['number']} {row['title'][:48]}"
        labels = set(row["labels"].split(";")) if row["labels"] else set()
        status = row.get("field_status")

        if status and not any(same_status(status, s) for s in STATUSES):
            problems["status is not one of " + ", ".join(STATUSES)].append(f"{ident}: {status!r}")
        if "type:story" in labels and not row["epic_number"]:
            problems["story has no epic"].append(ident)
        if "type:epic" in labels and not row["sub_issues_total"]:
            problems["epic has no stories"].append(ident)
        if row["state"] == "CLOSED" and status and not same_status(status, CYCLE_END):
            problems[f"closed but status is not {CYCLE_END}"].append(f"{ident}: {status!r}")
        if row["state"] == "OPEN" and same_status(status, CYCLE_END):
            problems[f"status {CYCLE_END} but still open"].append(ident)
        if not labels & {"type:epic", "type:story", "type:bug"}:
            problems["no type: label"].append(ident)

    if not problems:
        print(f"{len(data)} item(s): no problems found")
        return 0
    for rule, offenders in problems.items():
        print(f"\n{rule} ({len(offenders)}):")
        for offender in offenders:
            print(f"  {offender}")
    print(f"\n{sum(len(v) for v in problems.values())} problem(s) across {len(data)} item(s)")
    return 1


def cmd_self_test(args) -> int:
    """Stand up a scratch project, exercise every command, tear it down.

    Written because the case-sensitivity bug that made every cycle time null
    could only be caught by real data: the transitions were in the timeline and
    the comparison silently missed them. A unit test with a fixture would have
    reproduced the same wrong assumption.

    Everything created here is deleted in a `finally`, including after a failed
    assertion -- an aborted run must not leave a scratch project behind.
    """
    import time

    project: int | None = None
    issues: list[int] = []
    stamp = args.stamp or "self-test"
    try:
        created = json.loads(gh(["project", "create", "--owner", args.owner,
                                 "--title", f"gh-agile {stamp}", "--format", "json"]))
        project = created["number"]
        print(f"  scratch project #{project} created")

        setup = argparse.Namespace(owner=args.owner, project=project, spec=None, repo=args.repo)
        cmd_setup(setup)

        common = dict(owner=args.owner, project=project, repo=args.repo,
                      intent="self-test", acceptance="self-test")
        cmd_epic(argparse.Namespace(title=f"{stamp} epic", **common))
        epic_number = _latest_issue(args.repo)
        cmd_story(argparse.Namespace(title=f"{stamp} story", epic=epic_number, points=3,
                                     priority="high", status="Todo", **common))
        story_number = _latest_issue(args.repo)
        issues = [epic_number, story_number]

        # Drive the story through a real transition, then wait for the timeline
        # to catch up -- it is eventually consistent, measured at ~75s.
        item = next(i for i in json.loads(gh(["project", "item-list", str(project),
                                              "--owner", args.owner, "--format", "json"]))["items"]
                    if i["content"]["number"] == story_number)
        for index, status in enumerate((CYCLE_START, CYCLE_END)):
            if index:
                # Separated deliberately. Two transitions a second apart risk
                # arriving as one event, and a cycle time of zero seconds is
                # indistinguishable from a broken join.
                time.sleep(args.gap)
            set_field(args.owner, project, item["id"], "Status", status)
            print(f"  story -> {status}")

        deadline = time.time() + args.timeout
        started = None
        while time.time() < deadline:
            rows_now = rows(args.owner, project, with_history=True)
            story = next(r for r in rows_now if r["number"] == story_number)
            if story["started_at"] and story["done_at"]:
                started = story
                break
            time.sleep(10)

        checks = {
            "the story reached the board": bool(story["added_to_board_at"]),
            "story points round-tripped": story.get("field_story_points") == 3,
            "priority round-tripped": str(story.get("field_priority", "")).casefold() == "high",
            "the epic is the story's parent": story["epic_number"] == epic_number,
            "the timeline yielded a cycle time": bool(started),
        }
        for name, ok in checks.items():
            print(f"  [{'ok' if ok else 'FAIL'}] {name}")
        if not checks["the timeline yielded a cycle time"]:
            print(f"       (no status history within {args.timeout}s; the timeline lags ~75s)")
        return 0 if all(checks.values()) else 1
    finally:
        for number in issues:
            subprocess.run(["gh", "issue", "delete", str(number), "--repo", args.repo, "--yes"],
                           capture_output=True)
        if project:
            subprocess.run(["gh", "project", "delete", str(project), "--owner", args.owner],
                           capture_output=True)
        print(f"  torn down: project #{project}, issues {issues}")


def _latest_issue(repo: str) -> int:
    listed = json.loads(gh(["issue", "list", "--repo", repo, "--limit", "1",
                            "--state", "all", "--json", "number"]))
    return listed[0]["number"]


def main() -> int:
    parser = argparse.ArgumentParser(prog="gh agile", description=__doc__.splitlines()[0])
    parser.add_argument("--owner", default="@me", help='project owner; "@me" for yourself')
    parser.add_argument("--project", type=int, help="project number; self-test makes its own")
    sub = parser.add_subparsers(dest="command", required=True)

    setup = sub.add_parser("setup", help="create the project's fields and labels, idempotently")
    setup.add_argument("--spec", help="JSON spec; the built-in default is used without one")
    setup.add_argument("--repo", help="repository to create the type: labels in")
    setup.set_defaults(func=cmd_setup)

    epic = sub.add_parser("epic", help="create an epic issue on the board")
    epic.add_argument("title")
    epic.add_argument("--repo", required=True)
    epic.add_argument("--intent")
    epic.add_argument("--acceptance")
    epic.set_defaults(func=cmd_epic)

    story = sub.add_parser("story", help="create a story, attach it to its epic, set its fields")
    story.add_argument("title")
    story.add_argument("--repo", required=True)
    story.add_argument("--epic", type=int, required=True, help="epic issue number")
    story.add_argument("--points", type=float)
    story.add_argument("--priority")
    story.add_argument("--status", default="Todo")
    story.add_argument("--intent")
    story.add_argument("--acceptance")
    story.set_defaults(func=cmd_story)

    self_test = sub.add_parser(
        "self-test", help="stand up a scratch project, exercise everything, tear it down"
    )
    self_test.add_argument("--repo", required=True, help="repository to create throwaway issues in")
    self_test.add_argument("--stamp", help="label for the scratch project's title")
    self_test.add_argument("--timeout", type=int, default=420,
                           help="seconds to wait for the timeline (measured lag ~75s, variable)")
    self_test.add_argument("--gap", type=int, default=20,
                           help="seconds between the two status transitions")
    self_test.set_defaults(func=cmd_self_test)

    setter = sub.add_parser("set", help="set one field on an issue already on the board")
    setter.add_argument("--issue", type=int, required=True)
    setter.add_argument("--field", required=True, help='field name, e.g. "Story Points"')
    setter.add_argument("--value", help="text or single-select option")
    setter.add_argument("--number", type=float, help="numeric value")
    setter.set_defaults(func=cmd_set)

    export = sub.add_parser("export", help="items, field values and status history")
    export.add_argument("--csv", action="store_true", help="CSV instead of JSON")
    export.add_argument(
        "--no-history",
        action="store_true",
        help="skip the per-issue timeline query -- much faster, and the result "
        "is a snapshot with no cycle time",
    )
    export.set_defaults(func=cmd_export)

    validate = sub.add_parser("validate", help="check the conventions in POLICY.md")
    validate.set_defaults(func=cmd_validate)

    args = parser.parse_args()
    if args.owner == "@me":
        args.owner = json.loads(gh(["api", "user"]))["login"]
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())

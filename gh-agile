#: The oldest interpreter this tool runs on, and the number `ruff.toml`'s
#: `target-version` and the CI matrix are both pinned to.
#:
#: A `gh` extension runs under whatever `python3` the shebang finds --
#: `gh extension install` clones a file, it does not provision an interpreter --
#: so this is not ours to choose, and refusing with a sentence beats an exception
#: from the middle of a command.
#:
#: 3.10 rather than something newer, deliberately, even though it reaches upstream
#: end of life in October 2026. Upstream EOL stops python.org patches; it does not
#: remove 3.10 from anybody's machine, Ubuntu 22.04 LTS ships it with distro
#: support into 2027, and this file uses no 3.11+ feature -- so the floor costs
#: nothing to hold and dropping it would buy one fewer CI job. Revisit when the
#: distributions move, not when the version number expires.
RUNTIME_FLOOR = (3, 10)


def require_interpreter() -> None:
    if sys.version_info < RUNTIME_FLOOR:
        floor = ".".join(str(n) for n in RUNTIME_FLOOR)
        running = ".".join(str(n) for n in sys.version_info[:3])
        sys.exit(
            f"gh-agile needs Python {floor} or newer; this is {running} "
            f"({sys.executable}).\n"
            f"  It runs under whatever `python3` is first on PATH. Point that at a newer "
            f"one,\n  or install one: 3.12 is what this tool is tested against."
        )



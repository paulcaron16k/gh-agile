        "YAML parser in the standard library, and a partial one that reads only what this "
        "tool writes is a trap the first time someone edits it by hand",
    )
    export.add_argument("--no-state", dest="state", action="store_const", const=None,
                        help="do not read or write a watermark; always a full export")
    export.add_argument("--out-dir", help="write agile_issues_<ISO8601>.<ext> here instead of stdout")
    export.add_argument("--overlap-seconds", type=int, default=DEFAULT_OVERLAP_SECONDS,
                        help="how far back the next run re-reads (default %(default)s)")
    export.add_argument(
        "--no-history",
        action="store_true",
        help="skip the per-issue timeline query -- much faster, and the result "
        "is a snapshot with no cycle time",
    )
    export.set_defaults(func=cmd_export)

    validate = sub.add_parser("validate", help="check the conventions in POLICY.md")
    validate.set_defaults(func=cmd_validate)

    args = parser.parse_args()
    apply_defaults(args)
    return args.func(args)


def apply_defaults(args) -> None:
    """Fill --project, --repo and --key from the profile and the working directory.

    Typing `--project 5 --repo owner/name` on every command is friction for the
    common case of one project and one repository, and friction is what makes
    people skip the tool and edit by hand.

    Precedence, most explicit first: the flag; then `--key`, which names a
    repository on its own; then the repository this is being run in; then the
    profile.
    """
    config = read_config(getattr(args, "config", None))
    args._config = config

    if getattr(args, "owner", "@me") == "@me":
        args.owner = json.loads(gh(["api", "user"]))["login"]

    if getattr(args, "project", None) is None and args.command != "self-test":
        number = (config.get("project") or {}).get("number")
        if number:
            args.project = number

    key = getattr(args, "key", None)
    repo = getattr(args, "repo", None)
    if repo is None and hasattr(args, "repo"):
        if key and args.command not in ("key",):
            repo = repo_for_key(config, key)
            if not repo:
                sys.exit(f"no repository for key {key!r} in the profile")
        else:
            repo = current_repo()
            if not repo:
                sys.exit(
                    "not inside a GitHub repository, and no --repo given. Run this from a "
                    "clone, or pass --repo owner/name"
                )
        args.repo = repo

    # The key an issue is created with: explicit, else the first for this repo.
    if hasattr(args, "key") and args.command in ("epic", "story"):
        available = keys_for_repo(config, args.repo) if args.repo else []
        if key:
            if available and key not in available:
                sys.exit(f"key {key!r} is not listed for {args.repo} in the profile")
        elif available:
            args.key = available[0]


if __name__ == "__main__":
    sys.exit(main())

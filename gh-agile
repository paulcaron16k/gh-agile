    export = sub.add_parser("export", help="items, field values and status history")
    export.add_argument("--csv", action="store_true", help="CSV instead of JSON")
    export.add_argument("--since", help="ISO8601 lower bound on updated_at; overrides the state file")
    export.add_argument(
        "--state",
        default=".gh_agile_export.json",
